{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "API up",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [{"expr": "max(kaede_up)", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Gateway sessions",
      "gridPos": {"h": 4, "w": 5, "x": 4, "y": 0},
      "targets": [{"expr": "kaede_gateway_connected_sessions", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Federation pending",
      "gridPos": {"h": 4, "w": 5, "x": 9, "y": 0},
      "targets": [{"expr": "kaede_federation_outbox_pending", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Federation failed",
      "gridPos": {"h": 4, "w": 5, "x": 14, "y": 0},
      "targets": [{"expr": "kaede_federation_outbox_failed", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Federation delivery failure rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "rate(kaede_federation_delivery_failures_total[5m])", "refId": "A"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Background job duration",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {
          "expr": "rate(kaede_job_duration_seconds_total[5m]) / clamp_min(rate(kaede_job_runs_total[5m]), 0.000001)",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["kaede", "release"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "title": "Kaede Chat overview",
  "uid": "kaede-overview",
  "version": 1
}
