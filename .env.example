KAEDE_DOMAIN=chat.example.com
KAEDE_ENVIRONMENT=production
KAEDE_SECRET_KEY=replace-with-base64-encoded-32-byte-key
KAEDE_GATEWAY_SECRET_KEY=replace-with-a-different-base64-encoded-32-byte-key
KAEDE_PROXY_SECRET=replace-with-at-least-32-random-characters
KAEDE_EDGE_SECRET=replace-with-a-different-32-character-random-value
KAEDE_DATABASE_URL=postgresql+asyncpg://kaede:replace-me@postgres:5432/kaede
KAEDE_DRAGONFLY_URL=redis://:replace-with-dragonfly-password@dragonfly:6379/0
# Enabled by default. Set false to pause new encrypted-room activation without
# interrupting rooms that are already encrypted.
KAEDE_E2EE_ACTIVATION_ENABLED=true
KAEDE_SEARCH_ENABLED=true
KAEDE_SEARCH_URL=http://meilisearch:7700
KAEDE_SEARCH_MASTER_KEY=replace-with-at-least-32-random-characters
KAEDE_SEARCH_INDEX_PREFIX=kaede
KAEDE_SEARCH_REQUEST_TIMEOUT_SECONDS=5
KAEDE_SEARCH_BATCH_SIZE=250
KAEDE_SEARCH_FEDERATION_TIMEOUT_SECONDS=8
COMPOSE_PROFILES=search
KAEDE_LOG_LEVEL=INFO
KAEDE_FEDERATION_MODE=open
KAEDE_FEDERATION_CLOCK_SKEW_SECONDS=300
KAEDE_FEDERATION_EVENT_RETENTION_DAYS=30
KAEDE_FEDERATION_INBOX_MAX_EVENTS_PER_ORIGIN=5000000
KAEDE_FEDERATION_INBOX_MAX_BYTES_PER_ORIGIN=17179869184
KAEDE_FEDERATION_INBOX_MAX_EVENTS_TOTAL=50000000
KAEDE_FEDERATION_INBOX_MAX_BYTES_TOTAL=171798691840
KAEDE_FEDERATION_MAX_REMOTE_INSTANCES=10000
KAEDE_FEDERATION_PEER_KEY_HISTORY_LIMIT=512
KAEDE_FEDERATION_PENDING_RELATIONSHIPS_PER_RECIPIENT=1000
KAEDE_FEDERATION_PENDING_RELATIONSHIPS_PER_RECIPIENT_ORIGIN=100
KAEDE_FEDERATION_PENDING_RELATIONSHIPS_PER_ORIGIN=10000
KAEDE_FEDERATION_REMOTE_USERS_PER_INTRODUCER=100000
KAEDE_FEDERATION_THIRD_PARTY_INSTANCES_PER_INTRODUCER=1000
KAEDE_FEDERATION_REMOTE_MEDIA_TOMBSTONES_PER_ORIGIN=100000
KAEDE_FEDERATION_DM_MAX_CONVERSATIONS_PER_AUTHORITY=1000000
KAEDE_FEDERATION_DM_MAX_CONVERSATIONS_PER_REMOTE_ORIGIN=100000
KAEDE_FEDERATION_DM_MAX_MESSAGES_PER_CONVERSATION=5000000
KAEDE_FEDERATION_DM_MAX_MESSAGES_PER_AUTHORITY=50000000
KAEDE_FEDERATION_DM_MAX_MESSAGES_PER_REMOTE_ORIGIN=10000000
KAEDE_FEDERATION_DM_MAX_BYTES_PER_CONVERSATION=34359738368
KAEDE_FEDERATION_DM_MAX_BYTES_PER_AUTHORITY=343597383680
KAEDE_FEDERATION_DM_MAX_BYTES_PER_REMOTE_ORIGIN=68719476736
KAEDE_FEDERATION_DM_REPLICA_CACHE_MESSAGES_PER_CONVERSATION=250000
KAEDE_FEDERATION_DM_REPLICA_CACHE_BYTES_PER_CONVERSATION=2147483648
KAEDE_FEDERATION_REPLICA_MAX_ROWS_PER_GUILD=20000000
KAEDE_FEDERATION_REPLICA_MAX_BYTES_PER_GUILD=68719476736
KAEDE_FEDERATION_REPLICA_MAX_ROWS_PER_ORIGIN=100000000
KAEDE_FEDERATION_REPLICA_MAX_BYTES_PER_ORIGIN=343597383680
KAEDE_FEDERATION_REMOTE_IDENTITY_RETENTION_DAYS=30
KAEDE_FEDERATION_REMOTE_IDENTITY_GC_BATCH_SIZE=5000
KAEDE_FEDERATION_REMOTE_MEDIA_INFLIGHT_BYTES_PER_ORIGIN=268435456
KAEDE_FEDERATION_REMOTE_MEDIA_INFLIGHT_BYTES_TOTAL=536870912
KAEDE_FEDERATION_HISTORY_IMPORT_ENABLED=true
KAEDE_FEDERATION_HISTORY_EXPORT_TTL_MINUTES=1440
KAEDE_FEDERATION_HISTORY_MAX_ACTIVE_EXPORTS_PER_ORIGIN=1000
KAEDE_FEDERATION_HISTORY_MAX_ACTIVE_EXPORTS_TOTAL=10000
KAEDE_FEDERATION_HISTORY_MAX_ACTIVE_CHANNEL_GRANTS_PER_ORIGIN=100000
KAEDE_FEDERATION_HISTORY_MAX_ACTIVE_CHANNEL_GRANTS_TOTAL=1000000
KAEDE_FEDERATION_HISTORY_PAGE_MESSAGES=100
KAEDE_FEDERATION_HISTORY_PAGE_BYTES=524288
KAEDE_FEDERATION_HISTORY_MAX_MESSAGES=2000000
KAEDE_FEDERATION_HISTORY_MAX_BYTES=34359738368
KAEDE_FEDERATION_HISTORY_MAX_PAGES=250000
KAEDE_FEDERATION_HISTORY_MAX_REACTIONS=10000000
KAEDE_FEDERATION_HISTORY_MAX_DURATION_SECONDS=7200
KAEDE_FEDERATION_HISTORY_MERGE_CHUNK_SIZE=500
# KAEDE_ADMIN_TOKEN=
KAEDE_MEDIA_MAX_ATTACHMENT_BYTES=15728640
KAEDE_MEDIA_USER_QUOTA_BYTES=10737418240
KAEDE_MEDIA_SCAN_ENABLED=true
KAEDE_PHOTODNA_ENABLED=false
KAEDE_PHOTODNA_SUBSCRIPTION_KEY=replace-with-photodna-subscription-key
# Absolute host path to the separately licensed SDK root. The directory is
# mounted read-only and must contain clientlibrary/python and the native library.
PHOTODNA_EDGEHASHGENERATOR=/absolute/path/to/photodna-sdk
KAEDE_MEDIA_INFLIGHT_LIMIT=10
KAEDE_MEDIA_INFLIGHT_QUOTA_BYTES=524288000
KAEDE_MEDIA_UPLOAD_TTL_SECONDS=900
KAEDE_MEDIA_REMOTE_CACHE_BYTES=107374182400
KAEDE_MEDIA_REMOTE_CACHE_TTL_DAYS=30
# KAEDE_MEDIA_RETENTION_DAYS=
KAEDE_MEDIA_EMOJI_LIMIT=100
KAEDE_MEDIA_MAX_EMOJI_BYTES=524288
KAEDE_MEDIA_STICKER_LIMIT=60
KAEDE_MEDIA_MAX_STICKER_BYTES=2097152
KAEDE_MEDIA_STICKER_BACKGROUND_REMOVAL_ENABLED=false
KAEDE_MEDIA_STORAGE_BACKEND=garage
KAEDE_MEDIA_S3_ENDPOINT=http://garage:3900
KAEDE_MEDIA_PUBLIC_BASE_URL=https://media.chat.example.com
KAEDE_MEDIA_S3_REGION=kaede
KAEDE_MEDIA_S3_ADDRESSING_STYLE=path
KAEDE_MEDIA_S3_CREATE_BUCKETS=true
KAEDE_MEDIA_S3_INIT_TIMEOUT_SECONDS=120
KAEDE_MEDIA_S3_ACCESS_KEY=replace-with-GK-prefixed-access-key
KAEDE_MEDIA_S3_SECRET_KEY=replace-with-64-character-secret-key
# KAEDE_MEDIA_S3_SESSION_TOKEN=
KAEDE_MEDIA_ATTACHMENTS_BUCKET=kaede-attachments
KAEDE_MEDIA_DERIVED_BUCKET=kaede-derived
KAEDE_MEDIA_REMOTE_CACHE_BUCKET=kaede-remote-cache
# smtp, mailtrap_api, or disabled. Disabled removes email from registration and recovery.
KAEDE_EMAIL_BACKEND=smtp
KAEDE_EMAIL_FROM_ADDRESS=no-reply@chat.example.com
KAEDE_APP_URL=https://chat.example.com
KAEDE_SMTP_URL=smtps://username:password@smtp.example.com:465
# KAEDE_MAILTRAP_API_TOKEN=
# Optional integrations. Provider credentials are server-side only.
KAEDE_KLIPY_ENABLED=false
# KAEDE_KLIPY_API_KEY=
KAEDE_TURNSTILE_ENABLED=false
# KAEDE_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=
# Recommended for official mobile apps. Homes send signed, content-free wakes;
# they do not need Firebase credentials.
KAEDE_PUSH_RELAY_ENABLED=true
KAEDE_PUSH_RELAY_URL=https://push.kaede.chat
KAEDE_PUSH_RELAY_ORIGIN=kaede.chat
KAEDE_PUSH_RELAY_APP_ID=chat.kaede.mobile
# Enable only on the instance operating the configured relay.
KAEDE_PUSH_RELAY_SERVICE_ENABLED=false
# KAEDE_PUSH_RELAY_FCM_SERVICE_ACCOUNT_B64=
# Optional legacy/direct FCM for a separately signed custom mobile build.
KAEDE_PUSH_ENABLED=false
# Base64 of a Firebase service-account JSON document. Keep this secret.
# KAEDE_PUSH_FCM_SERVICE_ACCOUNT_B64=
# Optional verified links for a separately signed mobile build.
KAEDE_MOBILE_ANDROID_PACKAGE=chat.kaede.mobile
# KAEDE_MOBILE_ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:...
# KAEDE_MOBILE_IOS_APP_IDS=TEAMID.chat.kaede.mobile
# Optional host-side source updater. Enable with `make auto-update-enable`.
AUTO_UPDATE_ENABLED=false
AUTO_UPDATE_REMOTE=origin
AUTO_UPDATE_BRANCH=main
AUTO_UPDATE_INTERVAL=6h
AUTO_UPDATE_JITTER=30m
# Optional executable invoked after builds pass but before services stop.
# AUTO_UPDATE_BACKUP_HOOK=/absolute/path/to/verified-kaede-backup
AUTO_UPDATE_WAIT_TIMEOUT_SECONDS=300
KAEDE_API_WORKERS=4
KAEDE_GATEWAY_WORKERS=2
KAEDE_GATEWAY_IDENTIFY_RATE_PER_SECOND=100
KAEDE_GATEWAY_IDENTIFY_BURST=200
KAEDE_GATEWAY_IDENTIFY_IP_RATE_PER_SECOND=5
KAEDE_GATEWAY_IDENTIFY_IP_BURST=10
KAEDE_GATEWAY_WARMUP_MAX_ROWS=50000
KAEDE_GATEWAY_WARMUP_TIMEOUT_SECONDS=60
KAEDE_CADDY_HOST_PORT=18081
KAEDE_API_HOST_PORT=18082
KAEDE_GRAFANA_HOST_PORT=18084
KAEDE_VOICE_ENABLED=false
KAEDE_VOICE_PUBLIC_URL=wss://chat.example.com/livekit
KAEDE_VOICE_LIVEKIT_URL=http://host.docker.internal:7880
KAEDE_VOICE_TOKEN_TTL_SECONDS=900
KAEDE_VOICE_OCCUPANCY_STALE_SECONDS=75
KAEDE_VOICE_CALL_TTL_SECONDS=86400
# Every enabled instance on the same host needs its own five-port set.
LIVEKIT_CONTROL_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882
LIVEKIT_TURN_TLS_PORT=5349
KAEDE_TURN_UDP_PORT=13478
KAEDE_DEV_HTTP_PORT=18083
KAEDE_DEV_HTTPS_PORT=18443
POSTGRES_PASSWORD=replace-me
DRAGONFLY_PASSWORD=replace-with-at-least-32-random-characters
GARAGE_RPC_SECRET=replace-me
GARAGE_ADMIN_TOKEN=replace-me
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
LIVEKIT_TURN_CERT_PATH=/etc/letsencrypt/live/chat.example.com/fullchain.pem
LIVEKIT_TURN_KEY_PATH=/etc/letsencrypt/live/chat.example.com/privkey.pem
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-before-enabling-observability
