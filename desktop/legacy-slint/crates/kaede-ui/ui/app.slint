import { Button, CheckBox, ComboBox, LineEdit, ListView, ScrollView, TextEdit } from "std-widgets.slint";

// Inter is the web client's typeface (SIL OFL, see fonts/LICENSE-Inter.txt).
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";
import "fonts/Inter-ExtraBold.ttf";

export struct GuildItem { id: string, initials: string, name: string, mentions: int, has-icon: bool, icon: image }
export struct ChannelItem { id: string, name: string, kind: string, unread: bool, mentions: int, collapsed: bool, voice-count: int, has-avatar: bool, avatar: image, muted: bool, deafened: bool }
export struct MessageItem { kind: string, id: string, author: string, author-id: string, avatar: string, has-avatar: bool, avatar-image: image, time: string, body: string, pending: bool, retrying: bool, failed: bool, edited: bool, attachments: string, failure-reason: string, mine: bool, preview-url: string, preview-title: string, preview-description: string, preview-site: string, preview-media-type: string, has-attachment-preview: bool, attachment-preview: image, attachment-kind: string, has-reference: bool, reference-author: string, reference-body: string, gif-url: string, compact: bool }
export struct MemberItem { id: string, initials: string, has-avatar: bool, avatar: image, name: string, status: string, online: bool, presence: string, header: bool, role-color: color }
export struct FriendItem { id: string, initials: string, has-avatar: bool, avatar: image, name: string, handle: string, status: string, relationship: string, online: bool }
export struct EmojiItem { value: string, label: string, header: bool }
export struct GifItem { id: string, title: string, url: string, favorite: bool, has-preview: bool, preview: image }
export struct RoleItem { id: string, name: string, color: color, position: int, hoist: bool, mentionable: bool, editable: bool }
export struct ProfileRoleItem { id: string, name: string, color: color, assigned: bool, editable: bool }
export struct OverwriteItem { id: string, label: string, kind: string, allow: string, deny: string }
export struct OverwritePermissionItem { bit: string, label: string, description: string, state: string }
export struct PermissionItem { bit: string, label: string, description: string, group: string, checked: bool, danger: string }
export struct AdminMemberItem { id: string, initials: string, has-avatar: bool, avatar: image, name: string, handle: string, roles: string, timed-out: bool, manageable: bool }
export struct AdminChannelItem { id: string, name: string, kind: string, topic: string, parent: string, position: int, synced: bool, slow-mode: int }
export struct AdminRecordItem { id: string, title: string, subtitle: string, kind: string }
export struct VoiceMemberItem { id: string, initials: string, has-avatar: bool, avatar: image, name: string, muted: bool, deafened: bool }
export struct VideoTileItem { participant: string, frame: image }
export struct AccountItem { instance: string, account-key: string, label: string }
export struct SessionItem { id: string, title: string, detail: string, current: bool }
export struct CompletionItem { value: string, label: string, detail: string, kind: string }

// Design tokens mirror the web client's dark palette in src/styles.css.
global Theme {
    out property <color> canvas: #181715;          // --app-bg
    out property <color> rail: #111110;            // --rail
    out property <color> rail-hover: #2b2824;
    out property <color> sidebar: #1d1b19;         // --sidebar
    out property <color> surface: #211f1c;         // --surface
    out property <color> raised: #2a2723;          // --surface-raised
    out property <color> subtle: #26231f;          // --surface-subtle
    out property <color> hover: #332f2a;           // --surface-hover
    out property <color> selected: #422d27;        // --surface-selected
    out property <color> border: #514a43;          // --line
    out property <color> border-soft: #39342f;     // --line-soft
    out property <color> text: #f4eee5;
    out property <color> text-soft: #cdc3b7;
    out property <color> muted: #aaa096;
    out property <color> accent: #ee765e;
    out property <color> accent-hover: #ff8a71;
    out property <color> accent-soft: #4b2c26;
    out property <color> accent-text: #ff9b85;
    out property <color> on-accent: #231f1b;
    out property <color> green: #68b69b;           // --pine
    out property <color> green-soft: #203f35;      // --pine-soft
    out property <color> on-green: #16211d;
    out property <color> purple: #b49be4;
    out property <color> purple-soft: #352d48;
    out property <color> warning: #e4b75c;
    out property <color> red: #ff8175;             // --danger
    out property <color> red-soft: #4c2926;
    out property <color> presence-online: #3ba55d;
    out property <color> presence-idle: #f0a61b;
    out property <color> presence-dnd: #ed4245;
    out property <color> presence-offline: #747f8d;
}

component VectorIcon inherits Rectangle {
    in property <string> kind;
    in property <color> icon-color: Theme.text;
    background: transparent;
    Path {
        x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
        viewbox-width: 24; viewbox-height: 24;
        commands: root.kind == "home" ? "M3 10.5 L12 3 L21 10.5 L21 21 L14.5 21 L14.5 14.5 L9.5 14.5 L9.5 21 L3 21 Z"
            : root.kind == "people" ? "M8 11 A4 4 0 1 0 8 3 A4 4 0 1 0 8 11 M16.5 10 A3 3 0 1 0 16.5 4 A3 3 0 1 0 16.5 10 M1.5 21 C1.5 15.5 4 13 8 13 C12 13 14.5 15.5 14.5 21 M14 13 C19 12 22 15 22 19.5"
            : root.kind == "search" ? "M10.5 18 A7.5 7.5 0 1 0 10.5 3 A7.5 7.5 0 1 0 10.5 18 M16 16 L22 22"
            : root.kind == "settings" ? "M4 6 L20 6 M4 12 L20 12 M4 18 L20 18 M9 3 L9 9 M16 9 L16 15 M11 15 L11 21"
            : root.kind == "voice" ? "M4 10 L8 10 L13 6 L13 18 L8 14 L4 14 Z M16 9 C18 11 18 13 16 15 M19 6 C23 10 23 14 19 18"
            : root.kind == "pin" ? "M8 3 L18 3 L16 9 L20 13 L13 13 L12 22 L10 13 L4 13 L8 9 Z"
            : root.kind == "phone" ? "M6 3 L10 8 L8 11 C9.5 14 11 15.5 14 17 L17 15 L22 19 C21 22 18 23 15 21.5 C9 19 5 15 2.5 9 C1 6 3 3 6 3 Z"
            : root.kind == "close" ? "M5 5 L19 19 M19 5 L5 19"
            : root.kind == "plus" ? "M12 4 L12 20 M4 12 L20 12"
            : root.kind == "shield" ? "M12 2 L20 5 L20 11 C20 16 17 20 12 22 C7 20 4 16 4 11 L4 5 Z M9 12 L11 14 L15 9"
            : root.kind == "palette" ? "M12 3 C6 3 2 7 2 12 C2 17 6 21 11 21 C13 21 14 20 14 18 C14 16 16 15 18 15 C21 15 22 13 22 11 C22 6 18 3 12 3 Z M7 10 A1.5 1.5 0 1 0 7 7 A1.5 1.5 0 1 0 7 10 M12 8 A1.5 1.5 0 1 0 12 5 A1.5 1.5 0 1 0 12 8 M17 10 A1.5 1.5 0 1 0 17 7 A1.5 1.5 0 1 0 17 10"
            : root.kind == "bell" ? "M6 17 L18 17 L16.5 14 L16.5 10 C16.5 6.5 14.5 4 12 4 C9.5 4 7.5 6.5 7.5 10 L7.5 14 Z M10 20 C11 21 13 21 14 20"
            : root.kind == "key" ? "M14 10 A5 5 0 1 0 9 15 L3 21 L7 21 L7 18 L10 18 L10 15 M17 7 L17.1 7"
            : root.kind == "refresh" ? "M20 7 L20 3 L16 3 M20 3 C16 0 9 1 6 6 M4 17 L4 21 L8 21 M4 21 C8 24 15 23 18 18"
            : root.kind == "switch" ? "M4 7 L18 7 M15 4 L18 7 L15 10 M20 17 L6 17 M9 14 L6 17 L9 20"
            : root.kind == "logout" ? "M10 4 L4 4 L4 20 L10 20 M14 8 L20 12 L14 16 M20 12 L8 12"
            : root.kind == "channels" ? "M9 3 L7 21 M17 3 L15 21 M3 9 L21 9 M2 15 L20 15"
            : root.kind == "hash" ? "M9 3 L7 21 M17 3 L15 21 M3 9 L21 9 M2 15 L20 15"
            : root.kind == "roles" ? "M12 2 L18 6 L16 20 L12 22 L8 20 L6 6 Z"
            : root.kind == "ban" ? "M5 5 L19 19 M12 22 A10 10 0 1 0 12 2 A10 10 0 1 0 12 22"
            : root.kind == "smile" ? "M12 22 A10 10 0 1 0 12 2 A10 10 0 1 0 12 22 M8 9 L8.1 9 M16 9 L16.1 9 M7 14 C9 18 15 18 17 14"
            : root.kind == "link" ? "M10 14 L14 10 M8 17 L6 19 C3 22 0 18 3 15 L6 12 C8 10 10 11 11 12 M13 12 C14 13 16 14 18 12 L21 9 C24 6 21 2 18 5 L16 7"
            : root.kind == "list" ? "M8 6 L21 6 M8 12 L21 12 M8 18 L21 18 M3 6 L3.1 6 M3 12 L3.1 12 M3 18 L3.1 18"
            : root.kind == "external" ? "M10 5 L19 5 L19 14 M19 5 L9 15 M17 17 L17 20 L4 20 L4 7 L7 7"
            : root.kind == "reply" ? "M10 7 L4 12 L10 17 M5 12 L14 12 C18 12 20 15 20 19"
            : root.kind == "copy" ? "M9 8 L20 8 L20 20 L9 20 Z M4 4 L15 4 L15 8 M4 4 L4 16 L9 16"
            : root.kind == "edit" ? "M4 20 L8 19 L19 8 L16 5 L5 16 Z M14 7 L17 10"
            : root.kind == "trash" ? "M5 7 L19 7 M9 7 L9 4 L15 4 L15 7 M7 7 L8 21 L16 21 L17 7 M10 11 L10 17 M14 11 L14 17"
            : root.kind == "star" ? "M12 3 L14.8 8.7 L21 9.6 L16.5 14 L17.6 20.2 L12 17.3 L6.4 20.2 L7.5 14 L3 9.6 L9.2 8.7 Z"
            : root.kind == "arrow-up" ? "M6 14 L12 8 L18 14"
            : root.kind == "arrow-down" ? "M6 10 L12 16 L18 10"
            : root.kind == "arrow-right" ? "M10 6 L16 12 L10 18"
            : root.kind == "send" ? "M3 11 L21 3 L14 21 L11 13 Z M11 13 L21 3"
            : root.kind == "lock" ? "M7 11 L7 8 A5 5 0 0 1 17 8 L17 11 M5 11 L19 11 L19 21 L5 21 Z"
            : root.kind == "at" ? "M12 16 A4 4 0 1 0 12 8 A4 4 0 1 0 12 16 M16 8 L16 13.5 C16 16 18 16.5 19.5 15.5 C21.5 14 21.5 10 20 7.5 C18 4 13 2.5 9 4.5 C4.5 6.5 3 12 5 16 C7 20 12 21.5 16 19.5"
            : root.kind == "profile" ? "M12 12 A4.5 4.5 0 1 0 12 3 A4.5 4.5 0 1 0 12 12 M4 21 C4 16 7.5 14 12 14 C16.5 14 20 16 20 21"
            : "M5 12 L19 12";
        fill: root.kind == "home" ? root.icon-color : transparent;
        stroke: root.icon-color; stroke-width: root.kind == "home" ? 0px : 1.8px;
        stroke-line-cap: round; stroke-line-join: round;
    }
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected: false;
    callback clicked;
    width: 40px; height: 40px; border-radius: 12px;
    background: selected ? Theme.accent-soft : touch.has-hover ? Theme.hover : transparent;
    private property <bool> text-icon: root.icon == "GIF" || root.icon == "@" || root.icon == "#" || root.icon == "…" || root.icon == "★" || root.icon == "☆" || root.icon == "●";
    if !root.text-icon: VectorIcon { x: 10px; y: 10px; width: 20px; height: 20px; kind: root.icon; icon-color: selected ? Theme.accent-text : Theme.text-soft; }
    if root.text-icon: Text { text: root.icon; color: selected ? Theme.accent-text : Theme.text-soft; font-size: root.icon == "GIF" ? 11px : 17px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { accessible-role: button; accessible-label: root.label; clicked => { root.clicked(); } }
}

component SidebarButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected: false;
    callback clicked;
    height: 40px; border-radius: 9px; background: selected ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
    private property <bool> text-icon: root.icon == "GIF" || root.icon == "@" || root.icon == "#" || root.icon == "●";
    HorizontalLayout {
        padding-left: 11px; padding-right: 11px; spacing: 9px;
        if !root.text-icon: VectorIcon { width: 18px; height: 18px; kind: root.icon; icon-color: selected ? Theme.text : Theme.muted; }
        if root.text-icon: Text { width: 18px; text: root.icon; color: selected ? Theme.text : Theme.muted; font-size: root.icon == "GIF" ? 10px : 15px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
        Text { text: root.label; color: selected ? Theme.text : Theme.text-soft; font-size: 13px; font-weight: selected ? 720 : 590; vertical-alignment: center; overflow: elide; }
    }
    touch := TouchArea { accessible-role: button; accessible-label: root.label; clicked => { root.clicked(); } }
}

component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> destructive: false;
    in property <bool> enabled: true;
    callback clicked;
    callback press-state(bool);
    height: 42px; min-width: 96px; border-radius: 12px;
    opacity: root.enabled ? 1 : 0.42;
    background: destructive ? Theme.red : primary ? (touch.has-hover ? Theme.accent-hover : Theme.accent) : touch.has-hover ? Theme.hover : Theme.raised;
    border-width: primary || destructive ? 0px : 1px; border-color: Theme.border;
    Text { text: root.text; color: primary || destructive ? Theme.on-accent : Theme.text; font-size: 13px; font-weight: 720; horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { enabled: root.enabled; accessible-role: button; accessible-label: root.text; clicked => { root.clicked(); } pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.press-state(true); } if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) { root.press-state(false); } } }
}

component FormField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <InputType> input-type: InputType.text;
    in property <bool> enabled: true;
    callback accepted;
    callback edited;
    height: 50px; border-radius: 11px;
    background: #191816;
    border-width: 1px; border-color: input.has-focus ? Theme.accent : Theme.border;
    if root.text == "" && !input.has-focus: Text {
        x: 15px; width: parent.width - 30px; text: root.placeholder; color: #817a72;
        font-size: 13px; vertical-alignment: center;
    }
    input := TextInput {
        x: 15px; y: 1px; width: parent.width - 30px; height: parent.height - 2px;
        text <=> root.text; input-type: root.input-type; enabled: root.enabled;
        color: Theme.text; font-size: 14px; selection-background-color: Theme.accent;
        accepted => { root.accepted(); }
        edited => { root.edited(); }
    }
}

component UnreadBadge inherits Rectangle {
    in property <int> count;
    in property <bool> accent: true;
    width: max(20px, label.preferred-width + 12px); height: 18px; border-radius: 9px;
    background: accent ? Theme.accent : Theme.red;
    label := Text { text: root.count > 99 ? "99+" : "\{max(1, root.count)}"; color: accent ? Theme.on-accent : white; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
}

component PresenceDot inherits Rectangle {
    in property <string> presence: "online";
    in property <color> ring: Theme.sidebar;
    width: 12px; height: 12px; border-radius: 6px;
    background: root.presence == "idle" ? Theme.presence-idle
        : root.presence == "dnd" ? Theme.presence-dnd
        : root.presence == "offline" ? transparent
        : Theme.presence-online;
    border-width: root.presence == "offline" ? 3px : 2px;
    border-color: root.presence == "offline" ? Theme.presence-offline : root.ring;
}

component Avatar inherits Rectangle {
    in property <string> initials;
    in property <bool> has-image: false;
    in property <image> source;
    in property <color> fill: Theme.green-soft;
    in property <color> ink: Theme.green;
    border-radius: self.width / 2; background: root.fill; clip: true;
    Text { text: root.initials == "" ? "?" : root.initials; color: root.ink; font-size: root.width * 0.34; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
    if root.has-image: Image { x: 0; y: 0; width: parent.width; height: parent.height; source: root.source; image-fit: cover; }
}

component LoginPane inherits Rectangle {
    callback login(string, string, string);
    callback register-requested;
    callback recovery-requested;
    callback account-selected(string, string);
    callback account-forgotten(string);
    in property <[AccountItem]> accounts;
    in property <bool> busy;
    in property <string> error;
    background: Theme.canvas;
    Rectangle { x: -120px; y: parent.height - 260px; width: 520px; height: 360px; border-radius: 180px; background: #241c19; }
    Rectangle { x: parent.width - 360px; y: -180px; width: 520px; height: 420px; border-radius: 210px; background: #1b2420; }
    Rectangle {
        x: max(32px, (parent.width - self.width) / 2); y: max(32px, (parent.height - self.height) / 2);
        width: min(1040px, parent.width - 64px); height: min(680px, parent.height - 64px); border-radius: 24px;
        background: Theme.surface; border-width: 1px; border-color: Theme.border-soft; clip: true;
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 390px; background: #171815;
                Rectangle { x: -80px; y: parent.height - 220px; width: 380px; height: 310px; border-radius: 155px; background: Theme.accent-soft; }
                VerticalLayout {
                    padding: 42px; spacing: 22px;
                    HorizontalLayout { spacing: 12px;
                        Rectangle { width: 42px; height: 42px; border-radius: 13px; background: Theme.accent; Text { text: "K"; color: #211916; font-size: 20px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; } }
                        VerticalLayout { alignment: center; Text { text: "Kaede"; color: Theme.text; font-size: 18px; font-weight: 900; } Text { text: "DESKTOP"; color: Theme.accent; font-size: 9px; font-weight: 900; letter-spacing: 2px; } }
                    }
                    Rectangle { height: 46px; }
                    Text { text: "Your conversations, on your terms."; color: Theme.text; font-size: 34px; font-weight: 900; wrap: word-wrap; }
                    Text { text: "Sign into the instance that owns your account. Kaede handles the rest of the fediverse without moving your identity elsewhere."; color: Theme.text-soft; font-size: 14px; wrap: word-wrap; }
                    Rectangle { height: 14px; }
                    VerticalLayout { spacing: 17px;
                        HorizontalLayout { spacing: 12px; Rectangle { width: 28px; height: 28px; border-radius: 9px; background: #203f35; Text { text: "1"; color: Theme.green; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; } } Text { text: "One account across federated communities"; color: Theme.text-soft; font-size: 12px; vertical-alignment: center; } }
                        HorizontalLayout { spacing: 12px; Rectangle { width: 28px; height: 28px; border-radius: 9px; background: #352d48; Text { text: "2"; color: #b49be4; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; } } Text { text: "Native voice, calls, and device controls"; color: Theme.text-soft; font-size: 12px; vertical-alignment: center; } }
                        HorizontalLayout { spacing: 12px; Rectangle { width: 28px; height: 28px; border-radius: 9px; background: Theme.accent-soft; Text { text: "3"; color: Theme.accent; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; } } Text { text: "Private credentials stored by your operating system"; color: Theme.text-soft; font-size: 12px; vertical-alignment: center; } }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Text { text: "Self-hosted. Federated. Yours."; color: Theme.muted; font-size: 11px; }
                }
            }
            Rectangle { width: 1px; background: Theme.border-soft; }
            Rectangle {
                horizontal-stretch: 1; background: Theme.surface;
                ScrollView { VerticalLayout {
                    padding-left: 54px; padding-right: 54px; padding-top: 44px; padding-bottom: 36px; spacing: 13px;
                    Text { text: "Welcome back"; color: Theme.text; font-size: 30px; font-weight: 900; }
                    Text { text: "Use your home instance credentials to continue."; color: Theme.muted; font-size: 13px; }
                    if root.accounts.length > 0: Text { text: "SAVED ACCOUNTS"; color: Theme.muted; font-size: 10px; font-weight: 850; letter-spacing: 1.5px; }
                    for account in root.accounts: Rectangle { height: 58px; border-radius: 11px; background: Theme.raised; border-width: 1px; border-color: Theme.border-soft; HorizontalLayout { padding-left: 12px; padding-right: 8px; spacing: 10px; Rectangle { width: 34px; height: 34px; border-radius: 11px; background: Theme.accent-soft; Text { text: "K"; color: Theme.accent; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; } } VerticalLayout { alignment: center; Text { text: account.label; color: Theme.text; font-size: 13px; font-weight: 800; } Text { text: account.instance; color: Theme.muted; font-size: 10px; } } Rectangle { horizontal-stretch: 1; } PillButton { height: 36px; min-width: 82px; text: "Continue"; primary: true; clicked => { root.account-selected(account.instance, account.account-key); } } IconButton { width: 34px; height: 34px; icon: "close"; label: "Forget saved account"; clicked => { root.account-forgotten(account.account-key); } } } }
                    if root.accounts.length > 0: HorizontalLayout { spacing: 10px; Rectangle { height: 1px; background: Theme.border-soft; } Text { text: "OR"; color: Theme.muted; font-size: 9px; font-weight: 800; vertical-alignment: center; } Rectangle { height: 1px; background: Theme.border-soft; } }
                    Text { text: "HOME INSTANCE"; color: Theme.muted; font-size: 10px; font-weight: 850; letter-spacing: 1.2px; }
                    instance := FormField { placeholder: "chat.example.com"; }
                    Text { text: "USERNAME OR EMAIL"; color: Theme.muted; font-size: 10px; font-weight: 850; letter-spacing: 1.2px; }
                    identifier := FormField { placeholder: "you@example.com"; }
                    Text { text: "PASSWORD"; color: Theme.muted; font-size: 10px; font-weight: 850; letter-spacing: 1.2px; }
                    password := FormField { input-type: InputType.password; placeholder: "Password"; accepted => { if (!root.busy) { root.login(instance.text, identifier.text, password.text); } } }
                    if root.error != "": Rectangle { height: 46px; border-radius: 10px; background: #4c2926; Text { text: root.error; color: #ff9a91; font-size: 12px; wrap: word-wrap; vertical-alignment: center; x: 13px; width: parent.width - 26px; } }
                    PillButton { height: 46px; text: root.busy ? "Signing in…" : "Sign in"; primary: true; enabled: !root.busy; clicked => { root.login(instance.text, identifier.text, password.text); } }
                    HorizontalLayout { spacing: 10px;
                        PillButton { text: "Create an account"; clicked => { root.register-requested(); } }
                        Rectangle { horizontal-stretch: 1; }
                        PillButton { text: "Forgot password?"; clicked => { root.recovery-requested(); } }
                    }
                } }
            }
        }
    }
}

component OnboardingPane inherits Rectangle {
    in-out property <string> mode: "register";
    in-out property <string> instance-value;
    in-out property <string> username-value;
    in-out property <string> email-value;
    in-out property <string> token-value;
    in-out property <string> password-value;
    in property <bool> busy;
    in property <string> error;
    in property <string> notice;
    callback close;
    callback register(string, string, string, string);
    callback forgot(string, string);
    callback verify(string, string);
    callback reset(string, string, string);
    background: Theme.canvas;
    Rectangle {
        x: max(28px, (parent.width - self.width) / 2); y: max(24px, (parent.height - self.height) / 2);
        width: min(600px, parent.width - 56px); height: min(760px, parent.height - 48px); border-radius: 26px;
        background: Theme.surface; border-width: 1px; border-color: Theme.border;
        ScrollView { VerticalLayout {
            padding: 42px; spacing: 16px;
            HorizontalLayout { Text { text: "KAEDE ACCOUNT"; color: Theme.accent; font-size: 12px; font-weight: 900; letter-spacing: 2px; } Rectangle { horizontal-stretch: 1; } IconButton { icon: "close"; label: "Back to sign in"; clicked => { root.close(); } } }
            Text { text: root.mode == "register" ? "Create your account" : root.mode == "forgot" ? "Recover your account" : root.mode == "verify" ? "Verify your email" : "Choose a new password"; color: Theme.text; font-size: 34px; font-weight: 900; wrap: word-wrap; }
            Text { text: "Everything is sent directly to your selected home instance. If verification is required, Kaede opens a restricted in-app challenge window—never an external browser."; color: Theme.muted; font-size: 14px; wrap: word-wrap; }
            Text { text: "INSTANCE"; color: Theme.muted; font-size: 11px; font-weight: 800; }
            LineEdit { text <=> root.instance-value; placeholder-text: "chat.example.com"; }
            if root.mode == "register": Text { text: "USERNAME"; color: Theme.muted; font-size: 11px; font-weight: 800; }
            if root.mode == "register": LineEdit { text <=> root.username-value; placeholder-text: "yourname"; }
            if root.mode == "register" || root.mode == "forgot": Text { text: "EMAIL"; color: Theme.muted; font-size: 11px; font-weight: 800; }
            if root.mode == "register" || root.mode == "forgot": LineEdit { text <=> root.email-value; placeholder-text: "you@example.com"; }
            if root.mode == "verify" || root.mode == "reset": Text { text: root.mode == "verify" ? "VERIFICATION TOKEN" : "RESET TOKEN"; color: Theme.muted; font-size: 11px; font-weight: 800; }
            if root.mode == "verify" || root.mode == "reset": LineEdit { text <=> root.token-value; placeholder-text: "Paste the token from your email"; }
            if root.mode == "register" || root.mode == "reset": Text { text: "PASSWORD"; color: Theme.muted; font-size: 11px; font-weight: 800; }
            if root.mode == "register" || root.mode == "reset": LineEdit { text <=> root.password-value; input-type: InputType.password; placeholder-text: "At least 12 characters"; }
            if root.error != "": Rectangle { height: 52px; border-radius: 9px; background: #542a28; Text { text: root.error; color: #ffaaa2; font-size: 13px; wrap: word-wrap; vertical-alignment: center; x: 14px; width: parent.width - 28px; } }
            if root.notice != "": Rectangle { height: 52px; border-radius: 9px; background: #203c30; Text { text: root.notice; color: #93e5b8; font-size: 13px; wrap: word-wrap; vertical-alignment: center; x: 14px; width: parent.width - 28px; } }
            if root.mode == "register": PillButton { text: root.busy ? "Creating…" : "Create account"; primary: true; enabled: !root.busy; clicked => { root.register(root.instance-value, root.username-value, root.email-value, root.password-value); } }
            if root.mode == "forgot": PillButton { text: root.busy ? "Requesting…" : "Send recovery email"; primary: true; enabled: !root.busy; clicked => { root.forgot(root.instance-value, root.email-value); } }
            if root.mode == "verify": PillButton { text: root.busy ? "Verifying…" : "Verify email"; primary: true; enabled: !root.busy; clicked => { root.verify(root.instance-value, root.token-value); } }
            if root.mode == "reset": PillButton { text: root.busy ? "Resetting…" : "Reset password"; primary: true; enabled: !root.busy; clicked => { root.reset(root.instance-value, root.token-value, root.password-value); } }
            HorizontalLayout { alignment: center; spacing: 8px;
                PillButton { text: "Register"; primary: root.mode == "register"; clicked => { root.mode = "register"; } }
                PillButton { text: "Recovery"; primary: root.mode == "forgot"; clicked => { root.mode = "forgot"; } }
                PillButton { text: "Verify"; primary: root.mode == "verify"; clicked => { root.mode = "verify"; } }
                PillButton { text: "Reset"; primary: root.mode == "reset"; clicked => { root.mode = "reset"; } }
            }
        } }
    }
}

component MfaPane inherits Rectangle {
    callback submit(string);
    callback cancel;
    in property <bool> busy;
    in property <string> error;
    background: Theme.canvas;
    Rectangle {
        x: max(28px, (parent.width - self.width) / 2); y: max(24px, (parent.height - self.height) / 2);
        width: min(500px, parent.width - 56px); height: 420px; border-radius: 26px;
        background: Theme.surface; border-width: 1px; border-color: Theme.border;
        VerticalLayout {
            padding: 42px; spacing: 19px;
            Text { text: "SECURITY CHECK"; color: Theme.accent; font-size: 12px; font-weight: 900; letter-spacing: 2px; }
            Text { text: "Two-factor authentication"; color: Theme.text; font-size: 32px; font-weight: 900; wrap: word-wrap; }
            Text { text: "Enter a code from your authenticator or one of your recovery codes."; color: Theme.muted; font-size: 14px; wrap: word-wrap; }
            Text { text: "AUTHENTICATION CODE"; color: Theme.muted; font-size: 11px; font-weight: 800; }
            code := LineEdit { placeholder-text: "000000 or recovery code"; }
            if root.error != "": Rectangle { height: 48px; border-radius: 9px; background: #542a28; Text { text: root.error; color: #ffaaa2; font-size: 13px; wrap: word-wrap; vertical-alignment: center; x: 14px; width: parent.width - 28px; } }
            HorizontalLayout {
                spacing: 10px;
                PillButton { text: "Back"; clicked => { if (!root.busy) { root.cancel(); } } }
                PillButton { text: root.busy ? "Checking…" : "Continue"; primary: true; clicked => { if (!root.busy && code.text != "") { root.submit(code.text); } } }
            }
        }
    }
}

component ServerRail inherits Rectangle {
    in property <[GuildItem]> guilds;
    in property <string> selected-guild;
    in property <int> home-mentions;
    callback home;
    callback guild(string);
    width: 76px; background: Theme.rail;
    VerticalLayout {
        padding-top: 14px; padding-bottom: 12px; spacing: 11px; alignment: start;
        Rectangle {
            width: 48px; height: 48px;
            border-radius: root.selected-guild == "" || home-touch.has-hover ? 13px : 17px;
            background: root.selected-guild == "" || home-touch.has-hover ? Theme.accent : Theme.rail-hover;
            animate border-radius, background { duration: 140ms; }
            VectorIcon { x: 13px; y: 13px; width: 22px; height: 22px; kind: "home"; icon-color: root.selected-guild == "" || home-touch.has-hover ? Theme.on-accent : #fffaf3; }
            if root.selected-guild == "": Rectangle { x: -14px; y: 9px; width: 4px; height: 30px; border-radius: 2px; background: Theme.accent-text; }
            if root.home-mentions > 0: Rectangle { x: 30px; y: 30px; width: max(20px, home-badge.preferred-width + 10px); height: 20px; border-radius: 10px; background: Theme.accent; border-width: 3px; border-color: Theme.rail; home-badge := Text { text: root.home-mentions > 99 ? "99+" : "\{root.home-mentions}"; color: Theme.on-accent; font-size: 9px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } }
            home-touch := TouchArea { accessible-role: button; accessible-label: "Home"; clicked => { root.home(); } }
        }
        HorizontalLayout { alignment: center; Rectangle { width: 34px; height: 1px; background: #fffaf32e; } }
        for item[i] in root.guilds: Rectangle {
            width: 48px; height: 48px; background: transparent;
            Rectangle {
                width: 48px; height: 48px;
                border-radius: root.selected-guild == item.id || guild-touch.has-hover ? 13px : 17px;
                background: root.selected-guild == item.id ? Theme.accent-soft : guild-touch.has-hover ? Theme.accent : Theme.rail-hover;
                animate border-radius, background { duration: 140ms; }
                clip: true;
                Text { text: item.initials; color: guild-touch.has-hover && root.selected-guild != item.id ? Theme.on-accent : #fffaf3; font-size: 13px; font-weight: 850; horizontal-alignment: center; vertical-alignment: center; }
                if item.has-icon: Image { x: 0; y: 0; width: parent.width; height: parent.height; source: item.icon; image-fit: cover; }
            }
            if root.selected-guild == item.id: Rectangle { x: -14px; y: 9px; width: 4px; height: 30px; border-radius: 2px; background: Theme.accent-text; }
            if item.mentions > 0: Rectangle { x: 30px; y: 30px; width: max(20px, badge-label.preferred-width + 10px); height: 20px; border-radius: 10px; background: Theme.accent; border-width: 3px; border-color: Theme.rail; badge-label := Text { text: item.mentions > 99 ? "99+" : "\{item.mentions}"; color: Theme.on-accent; font-size: 9px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } }
            guild-touch := TouchArea { accessible-role: button; accessible-label: item.name; clicked => { root.guild(item.id); } }
        }
    }
}

component PresenceMenu inherits Rectangle {
    in property <string> current: "online";
    callback choose(string);
    callback dismiss;
    width: 250px; height: 218px; border-radius: 12px;
    background: Theme.raised; border-width: 1px; border-color: Theme.border;
    drop-shadow-blur: 32px; drop-shadow-color: #00000066; drop-shadow-offset-y: 8px;
    TouchArea { }
    VerticalLayout {
        padding: 8px; spacing: 2px;
        Text { height: 26px; text: "YOUR STATUS"; color: Theme.muted; font-size: 9px; font-weight: 800; letter-spacing: 1.2px; vertical-alignment: center; x: 10px; }
        for option in [
            { value: "online", label: "Online", detail: "Available to chat" },
            { value: "idle", label: "Idle", detail: "Away for a while" },
            { value: "dnd", label: "Do not disturb", detail: "Suppress notifications" },
            { value: "invisible", label: "Invisible", detail: "Appear offline" },
        ]: Rectangle {
            height: 42px; border-radius: 8px; background: option-touch.has-hover ? Theme.hover : transparent;
            HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 9px;
                VerticalLayout { alignment: center; PresenceDot { presence: option.value == "invisible" ? "offline" : option.value; ring: Theme.raised; } }
                VerticalLayout { alignment: center; Text { text: option.label; color: Theme.text; font-size: 12px; font-weight: 650; } Text { text: option.detail; color: Theme.muted; font-size: 10px; } }
                Rectangle { horizontal-stretch: 1; }
                if root.current == option.value: Text { text: "✓"; color: Theme.accent-text; font-size: 13px; font-weight: 800; vertical-alignment: center; }
            }
            option-touch := TouchArea { accessible-role: button; accessible-label: option.label; clicked => { root.choose(option.value); root.dismiss(); } }
        }
    }
}

component UserDock inherits Rectangle {
    in property <string> current-user;
    in property <string> current-user-initials;
    in property <bool> current-user-has-avatar;
    in property <image> current-user-avatar;
    in property <string> custom-status;
    in property <string> presence-status: "online";
    callback settings;
    callback set-presence(string);
    in-out property <bool> menu-open: false;
    height: 62px; background: Theme.subtle; border-width: 1px; border-color: Theme.border-soft;
    HorizontalLayout { padding-left: 11px; padding-right: 9px; spacing: 10px;
        Rectangle {
            width: 36px; height: 36px; y: (parent.height - 36px) / 2;
            Avatar { width: 36px; height: 36px; initials: root.current-user-initials; has-image: root.current-user-has-avatar; source: root.current-user-avatar; fill: Theme.green-soft; ink: Theme.green; }
            PresenceDot { x: 25px; y: 25px; presence: root.presence-status == "invisible" ? "offline" : root.presence-status; ring: Theme.subtle; }
            TouchArea { accessible-role: button; accessible-label: "Change presence"; clicked => { root.menu-open = !root.menu-open; } }
        }
        VerticalLayout { alignment: center;
            Text { text: root.current-user; color: Theme.text; font-size: 12.5px; font-weight: 720; overflow: elide; }
            Text { text: root.custom-status != "" ? root.custom-status : root.presence-status == "dnd" ? "Do not disturb" : root.presence-status == "idle" ? "Idle" : root.presence-status == "invisible" ? "Invisible" : "Online"; color: Theme.muted; font-size: 10px; overflow: elide; }
        }
        Rectangle { horizontal-stretch: 1; }
        IconButton { width: 34px; height: 34px; icon: "settings"; label: "User settings"; clicked => { root.settings(); } }
    }
    if root.menu-open: PresenceMenu { x: 8px; y: -226px; current: root.presence-status; choose(value) => { root.set-presence(value); } dismiss => { root.menu-open = false; } }
}

component ChannelSidebar inherits Rectangle {
    in property <string> title;
    in property <bool> sync-paused: false;
    in property <string> sync-paused-title: "Replica cache is full";
    in property <string> sync-paused-message: "Recent guild updates may be missing. Ask this instance's administrator to free space or raise the limit.";
    in property <[ChannelItem]> channels;
    in property <string> selected-channel;
    in property <string> current-user;
    in property <string> current-user-initials;
    in property <bool> current-user-has-avatar;
    in property <image> current-user-avatar;
    in property <string> custom-status;
    in property <string> presence-status;
    callback channel(string);
    callback toggle-category(string);
    callback member-profile(string);
    callback guild-settings;
    callback settings;
    callback set-presence(string);
    width: 292px; background: Theme.sidebar; border-width: 1px; border-color: Theme.border-soft;
    VerticalLayout {
        Rectangle { height: 72px; border-width: 1px; border-color: Theme.border-soft;
            HorizontalLayout { padding-left: 16px; padding-right: 10px;
                VerticalLayout { alignment: center; spacing: 2px;
                    Text { text: "GUILD"; color: Theme.accent-text; font-size: 9px; font-weight: 800; letter-spacing: 1.4px; }
                    Text { text: root.title; color: Theme.text; font-size: 15px; font-weight: 800; overflow: elide; }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { alignment: center; IconButton { icon: "settings"; label: "Guild settings"; clicked => { root.guild-settings(); } } }
            }
        }
        if root.sync-paused: Rectangle {
            height: 68px;
            background: #352d20;
            border-width: 1px;
            border-color: Theme.warning;
            VerticalLayout {
                padding-left: 12px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px; spacing: 2px;
                Text { text: root.sync-paused-title; color: Theme.warning; font-size: 11px; font-weight: 800; }
                Text { text: root.sync-paused-message; color: Theme.text-soft; font-size: 9.5px; wrap: word-wrap; }
            }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 9px; padding-right: 9px; padding-top: 10px; padding-bottom: 10px; spacing: 2px; alignment: start;
                for item[i] in root.channels: Rectangle {
                    height: item.kind == "category" ? 34px : item.kind == "voice-member" ? 28px : 38px;
                    border-radius: 9px;
                    background: item.kind == "category" || item.kind == "voice-member" ? transparent
                        : item.id == root.selected-channel ? Theme.selected
                        : row-touch.has-hover ? Theme.hover : transparent;
                    if item.kind == "category": HorizontalLayout {
                        padding-left: 4px; padding-right: 6px; spacing: 4px;
                        VerticalLayout { alignment: center; VectorIcon { width: 13px; height: 13px; kind: item.collapsed ? "arrow-right" : "arrow-down"; icon-color: Theme.muted; } }
                        Text { text: item.name.to-uppercase(); color: cat-touch.has-hover ? Theme.text-soft : Theme.muted; font-size: 10px; font-weight: 800; letter-spacing: 1.1px; vertical-alignment: center; overflow: elide; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if item.kind == "voice-member": HorizontalLayout {
                        padding-left: 34px; padding-right: 8px; spacing: 8px;
                        Avatar { width: 20px; height: 20px; y: (parent.height - 20px) / 2; initials: item.name; has-image: item.has-avatar; source: item.avatar; fill: Theme.raised; ink: Theme.text-soft; }
                        Text { text: item.name; color: Theme.muted; font-size: 12px; font-weight: 590; vertical-alignment: center; overflow: elide; }
                        Rectangle { horizontal-stretch: 1; }
                        if item.muted: Text { text: "🔇"; font-size: 10px; vertical-alignment: center; }
                        if item.deafened: Text { text: "🔕"; font-size: 10px; vertical-alignment: center; }
                    }
                    if item.kind != "category" && item.kind != "voice-member": HorizontalLayout {
                        padding-left: 10px; padding-right: 8px; spacing: 9px;
                        if item.kind == "voice": VectorIcon { width: 17px; height: 17px; y: (parent.height - 17px) / 2; kind: "voice"; icon-color: Theme.muted; }
                        if item.kind == "announcement": VectorIcon { width: 17px; height: 17px; y: (parent.height - 17px) / 2; kind: "bell"; icon-color: Theme.muted; }
                        if item.kind != "voice" && item.kind != "announcement": Text { width: 15px; text: "#"; color: Theme.muted; font-size: 15px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        Text { text: item.name; color: item.id == root.selected-channel || item.unread ? Theme.text : Theme.text-soft; font-size: 13px; font-weight: item.id == root.selected-channel || item.unread ? 720 : 590; vertical-alignment: center; overflow: elide; }
                        Rectangle { horizontal-stretch: 1; }
                        if item.kind == "voice" && item.voice-count > 0: Rectangle { width: 26px; height: 17px; y: (parent.height - 17px) / 2; border-radius: 8px; background: Theme.raised; Text { text: "\{item.voice-count}"; color: Theme.muted; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; } }
                        if item.unread && item.kind != "voice": VerticalLayout { alignment: center; UnreadBadge { count: item.mentions; } }
                    }
                    cat-touch := TouchArea { enabled: item.kind == "category"; accessible-role: button; accessible-label: item.name; clicked => { root.toggle-category(item.id); } }
                    row-touch := TouchArea { enabled: item.kind != "category"; accessible-role: button; accessible-label: item.name; clicked => { if (item.kind == "voice-member") { root.member-profile(item.id); } else { root.channel(item.id); } } }
                }
            }
        }
        UserDock { current-user: root.current-user; current-user-initials: root.current-user-initials; current-user-has-avatar: root.current-user-has-avatar; current-user-avatar: root.current-user-avatar; custom-status: root.custom-status; presence-status: root.presence-status; settings => { root.settings(); } set-presence(value) => { root.set-presence(value); } }
    }
}

component HomeSidebar inherits Rectangle {
    in property <[ChannelItem]> direct-messages;
    in property <string> selected-page;
    in property <string> selected-channel;
    in property <string> current-user;
    in property <string> current-user-initials;
    in property <bool> current-user-has-avatar;
    in property <image> current-user-avatar;
    in property <string> custom-status;
    in property <string> presence-status;
    callback page(string);
    callback channel(string);
    callback new-message;
    callback settings;
    callback set-presence(string);
    width: 292px; background: Theme.sidebar; border-width: 1px; border-color: Theme.border-soft;
    VerticalLayout {
        Rectangle {
            height: 72px; border-width: 1px; border-color: Theme.border-soft;
            HorizontalLayout { padding-left: 15px; spacing: 11px;
                VerticalLayout { alignment: center; Rectangle { width: 38px; height: 38px; border-radius: 12px; background: Theme.accent-soft; Text { text: "K"; color: Theme.accent; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; } } }
                VerticalLayout { alignment: center; Text { text: "Kaede"; color: Theme.text; font-size: 16px; font-weight: 900; } Text { text: "Home"; color: Theme.muted; font-size: 10px; } }
            }
        }
        VerticalLayout { padding: 9px; spacing: 3px;
            SidebarButton { icon: "home"; label: "Overview"; selected: root.selected-page == "overview"; clicked => { root.page("overview"); } }
            SidebarButton { icon: "people"; label: "Friends & requests"; selected: root.selected-page == "friends"; clicked => { root.page("friends"); } }
        }
        HorizontalLayout { padding-left: 18px; padding-right: 10px; Text { text: "DIRECT MESSAGES"; color: Theme.muted; font-size: 10px; font-weight: 800; letter-spacing: 1.2px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } IconButton { width: 32px; height: 32px; icon: "plus"; label: "New direct message"; clicked => { root.new-message(); } } }
        ScrollView { vertical-stretch: 1; VerticalLayout { padding-left: 9px; padding-right: 9px; spacing: 2px; alignment: start;
            for item[i] in root.direct-messages: Rectangle {
                height: 40px; border-radius: 9px;
                background: item.id == root.selected-channel ? Theme.selected : dm-touch.has-hover ? Theme.hover : transparent;
                HorizontalLayout { padding-left: 9px; padding-right: 8px; spacing: 9px;
                    VerticalLayout { alignment: center; Rectangle { width: 28px; height: 28px; border-radius: 14px; background: Theme.green-soft; Text { text: "@"; color: Theme.green; font-size: 13px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } } }
                    Text { text: item.name; color: item.id == root.selected-channel || item.unread ? Theme.text : Theme.text-soft; font-size: 13px; font-weight: item.unread ? 720 : 590; vertical-alignment: center; overflow: elide; }
                    Rectangle { horizontal-stretch: 1; }
                    if item.unread: VerticalLayout { alignment: center; UnreadBadge { count: item.mentions; } }
                }
                dm-touch := TouchArea { accessible-role: button; accessible-label: item.name; clicked => { root.channel(item.id); } }
            }
        } }
        UserDock { current-user: root.current-user; current-user-initials: root.current-user-initials; current-user-has-avatar: root.current-user-has-avatar; current-user-avatar: root.current-user-avatar; custom-status: root.custom-status; presence-status: root.presence-status; settings => { root.settings(); } set-presence(value) => { root.set-presence(value); } }
    }
}

component FriendRow inherits Rectangle {
    in property <FriendItem> friend;
    callback profile(string);
    callback message(string);
    callback accept(string);
    callback remove(string);
    height: 66px; border-radius: 12px; background: touch.has-hover ? Theme.raised : Theme.surface;
    HorizontalLayout { padding-left: 12px; padding-right: 10px; spacing: 11px;
        Rectangle { width: 42px; height: 42px; y: (parent.height - 42px) / 2;
            Avatar { width: 42px; height: 42px; initials: root.friend.initials; has-image: root.friend.has-avatar; source: root.friend.avatar; }
            PresenceDot { x: 30px; y: 30px; presence: root.friend.online ? "online" : "offline"; ring: Theme.surface; }
        }
        VerticalLayout { alignment: center; Text { text: root.friend.name; color: Theme.text; font-size: 14px; font-weight: 750; } Text { text: root.friend.status == "" ? root.friend.handle : root.friend.status; color: Theme.muted; font-size: 11px; } }
        Rectangle { horizontal-stretch: 1; }
        if root.friend.relationship == "incoming": PillButton { text: "Accept"; primary: true; clicked => { root.accept(root.friend.id); } }
        if root.friend.relationship == "friend": PillButton { text: "Message"; clicked => { root.message(root.friend.id); } }
        PillButton { text: "Profile"; clicked => { root.profile(root.friend.id); } }
        PillButton { text: root.friend.relationship == "blocked" ? "Unblock" : "Remove"; destructive: root.friend.relationship != "blocked"; clicked => { root.remove(root.friend.id); } }
    }
    touch := TouchArea { }
}

component HomePane inherits Rectangle {
    in property <string> page;
    in property <[FriendItem]> friends;
    in property <[GuildItem]> guilds;
    in property <[ChannelItem]> direct-messages;
    callback add-friend(string);
    callback friend-profile(string);
    callback friend-message(string);
    callback friend-accept(string);
    callback friend-remove(string);
    callback create-guild(string);
    callback join-guild(string);
    callback open-guild(string);
    callback open-channel(string);
    background: Theme.canvas;
    VerticalLayout {
        Rectangle { height: 72px; background: Theme.surface; border-width: 1px; border-color: Theme.border-soft; HorizontalLayout { padding-left: 22px; padding-right: 18px; Text { text: root.page == "friends" ? "Friends" : "Home"; color: Theme.text; font-size: 17px; font-weight: 850; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } Text { text: root.page == "friends" ? "Connections across the fediverse" : "Your conversations"; color: Theme.muted; font-size: 11px; vertical-alignment: center; } } }
        ScrollView { VerticalLayout { padding-left: max(30px, (parent.width - 1100px) / 2); padding-right: max(30px, (parent.width - 1100px) / 2); padding-top: 28px; padding-bottom: 30px; spacing: 18px;
            Text { text: root.page == "friends" ? "PEOPLE" : "WELCOME BACK"; color: Theme.accent-text; font-size: 11px; font-weight: 900; letter-spacing: 2px; }
            Text { text: root.page == "friends" ? "Friends & requests" : "Where do you want to go?"; color: Theme.text; font-size: 32px; font-weight: 900; }
            Text { text: root.page == "friends" ? "Manage friends and pending requests from your instance and beyond." : "Jump back into a conversation or open one of your communities."; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
            if root.page == "friends": Rectangle { height: 82px; border-radius: 14px; background: Theme.surface; border-width: 1px; border-color: Theme.border-soft; HorizontalLayout { padding: 14px; spacing: 10px; VerticalLayout { spacing: 6px; Text { text: "ADD A FRIEND"; color: Theme.accent-text; font-size: 10px; font-weight: 900; letter-spacing: 1px; } friend-handle := FormField { height: 42px; placeholder: "@friend@example.net"; accepted => { if (self.text != "") { root.add-friend(self.text); self.text = ""; } } } } PillButton { text: "Send request"; primary: true; clicked => { if (friend-handle.text != "") { root.add-friend(friend-handle.text); friend-handle.text = ""; } } } } }
            if root.page == "friends": Text { text: "ALL CONNECTIONS  ·  \{root.friends.length}"; color: Theme.muted; font-size: 10px; font-weight: 900; letter-spacing: 1.2px; }
            if root.page == "friends": VerticalLayout { spacing: 7px; for item[i] in root.friends: FriendRow { friend: item; profile(id) => { root.friend-profile(id); } message(id) => { root.friend-message(id); } accept(id) => { root.friend-accept(id); } remove(id) => { root.friend-remove(id); } } }
            if root.page == "overview": HorizontalLayout { spacing: 16px;
                Rectangle { horizontal-stretch: 3; min-height: 190px; max-height: 340px; border-radius: 16px; background: Theme.surface; border-width: 1px; border-color: Theme.border-soft;
                    VerticalLayout { padding: 17px; spacing: 9px;
                        HorizontalLayout { Text { text: "Recent conversations"; color: Theme.text; font-size: 17px; font-weight: 850; } Rectangle { horizontal-stretch: 1; } Text { text: "\{root.direct-messages.length}"; color: Theme.muted; font-size: 11px; vertical-alignment: center; } }
                        Text { text: "Pick up where you left off"; color: Theme.muted; font-size: 11px; }
                        Rectangle { height: 1px; background: Theme.border-soft; }
                        if root.direct-messages.length == 0: Rectangle { vertical-stretch: 1; VerticalLayout { alignment: center; spacing: 8px; HorizontalLayout { alignment: center; Rectangle { width: 44px; height: 44px; border-radius: 15px; background: Theme.accent-soft; Text { text: "@"; color: Theme.accent; font-size: 20px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } } } Text { text: "No direct messages yet"; color: Theme.text-soft; font-size: 13px; horizontal-alignment: center; } Text { text: "Start one from the + button in the sidebar."; color: Theme.muted; font-size: 11px; horizontal-alignment: center; } } }
                        for item[i] in root.direct-messages: Rectangle { height: 52px; vertical-stretch: 0; border-radius: 10px; background: dm-touch.has-hover ? Theme.hover : transparent; HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 10px; VerticalLayout { alignment: center; Rectangle { width: 34px; height: 34px; border-radius: 12px; background: Theme.accent-soft; Text { text: "@"; color: Theme.accent; font-size: 16px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } } } VerticalLayout { alignment: center; Text { text: item.name; color: Theme.text; font-size: 13px; font-weight: 800; overflow: elide; } Text { text: item.unread ? "New messages" : "Direct message"; color: item.unread ? Theme.accent-text : Theme.muted; font-size: 10px; } } Rectangle { horizontal-stretch: 1; } if item.unread: VerticalLayout { alignment: center; UnreadBadge { count: item.mentions; } } } dm-touch := TouchArea { accessible-role: button; accessible-label: item.name; clicked => { root.open-channel(item.id); } } }
                        if root.direct-messages.length > 0: Rectangle { vertical-stretch: 1; }
                    }
                }
                Rectangle { horizontal-stretch: 2; min-height: 190px; max-height: 340px; border-radius: 16px; background: Theme.surface; border-width: 1px; border-color: Theme.border-soft;
                    VerticalLayout { padding: 17px; spacing: 9px;
                        HorizontalLayout { Text { text: "Your guilds"; color: Theme.text; font-size: 17px; font-weight: 850; } Rectangle { horizontal-stretch: 1; } Text { text: "\{root.guilds.length}"; color: Theme.muted; font-size: 11px; vertical-alignment: center; } }
                        Text { text: "Communities on any connected instance"; color: Theme.muted; font-size: 11px; }
                        Rectangle { height: 1px; background: Theme.border-soft; }
                        if root.guilds.length == 0: Rectangle { vertical-stretch: 1; Text { text: "Create or join your first guild below."; color: Theme.muted; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; } }
                        for item[i] in root.guilds: Rectangle { height: 52px; vertical-stretch: 0; border-radius: 10px; background: guild-touch.has-hover ? Theme.hover : transparent; HorizontalLayout { padding-left: 8px; padding-right: 8px; spacing: 10px; VerticalLayout { alignment: center; Rectangle { width: 36px; height: 36px; border-radius: 12px; background: Theme.raised; clip: true; Text { text: item.initials; color: Theme.text; font-size: 10px; font-weight: 850; horizontal-alignment: center; vertical-alignment: center; } if item.has-icon: Image { x: 0; y: 0; width: parent.width; height: parent.height; source: item.icon; image-fit: cover; } } } Text { text: item.name; color: Theme.text; font-size: 13px; font-weight: 800; overflow: elide; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } if item.mentions > 0: VerticalLayout { alignment: center; UnreadBadge { count: item.mentions; } } Text { text: "›"; color: Theme.muted; font-size: 18px; vertical-alignment: center; } } guild-touch := TouchArea { accessible-role: button; accessible-label: item.name; clicked => { root.open-guild(item.id); } } }
                        if root.guilds.length > 0: Rectangle { vertical-stretch: 1; }
                    }
                }
            }
            if root.page == "overview": Text { text: "START SOMETHING"; color: Theme.muted; font-size: 10px; font-weight: 900; letter-spacing: 1.4px; }
            if root.page == "overview": HorizontalLayout { spacing: 14px;
                Rectangle { height: 116px; border-radius: 14px; background: Theme.surface; border-width: 1px; border-color: Theme.border-soft; HorizontalLayout { padding: 15px; spacing: 13px; Rectangle { width: 44px; height: 44px; border-radius: 14px; background: #352d48; VectorIcon { x: 12px; y: 12px; width: 20px; height: 20px; kind: "plus"; icon-color: #b49be4; } } VerticalLayout { spacing: 7px; Text { text: "Create a guild"; color: Theme.text; font-size: 15px; font-weight: 850; } new-guild-name := FormField { height: 40px; placeholder: "Guild name"; accepted => { if (self.text != "") { root.create-guild(self.text); self.text = ""; } } } } PillButton { min-width: 76px; text: "Create"; primary: true; clicked => { if (new-guild-name.text != "") { root.create-guild(new-guild-name.text); new-guild-name.text = ""; } } } } }
                Rectangle { height: 116px; border-radius: 14px; background: Theme.surface; border-width: 1px; border-color: Theme.border-soft; HorizontalLayout { padding: 15px; spacing: 13px; Rectangle { width: 44px; height: 44px; border-radius: 14px; background: #203f35; VectorIcon { x: 12px; y: 12px; width: 20px; height: 20px; kind: "external"; icon-color: Theme.green; } } VerticalLayout { spacing: 7px; Text { text: "Join with an invite"; color: Theme.text; font-size: 15px; font-weight: 850; } invite-code := FormField { height: 40px; placeholder: "Invite code or URL"; accepted => { if (self.text != "") { root.join-guild(self.text); } } } } PillButton { min-width: 76px; text: "Join"; primary: true; clicked => { if (invite-code.text != "") { root.join-guild(invite-code.text); } } } } }
            }
        } }
    }
}

component MessageRow inherits Rectangle {
    in property <MessageItem> message;
    callback context(length, length);
    callback open-media;
    callback profile(string);
    background: root.message.kind != "message" ? transparent : touch.has-hover ? Theme.subtle : transparent;
    border-radius: 8px;
    touch := TouchArea {
        enabled: root.message.kind == "message";
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) {
                root.context(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
        }
    }
    // The root layout is unconditional so every row reports its real content
    // height to the ListView; dividers and messages swap inside it.
    VerticalLayout {
        if root.message.kind == "day": HorizontalLayout {
            padding-left: 18px; padding-right: 18px; padding-top: 20px; padding-bottom: 6px; spacing: 12px;
            VerticalLayout { alignment: center; horizontal-stretch: 1; Rectangle { height: 1px; background: Theme.border-soft; } }
            Text { text: root.message.time; color: Theme.muted; font-size: 10.5px; font-weight: 680; }
            VerticalLayout { alignment: center; horizontal-stretch: 1; Rectangle { height: 1px; background: Theme.border-soft; } }
        }
        if root.message.kind == "new": HorizontalLayout {
            padding-left: 18px; padding-right: 18px; padding-top: 10px; padding-bottom: 4px; spacing: 12px;
            VerticalLayout { alignment: center; horizontal-stretch: 1; Rectangle { height: 1px; background: #ee765e66; } }
            Text { text: "NEW MESSAGES"; color: Theme.accent-text; font-size: 10px; font-weight: 800; letter-spacing: 1px; }
            VerticalLayout { alignment: center; horizontal-stretch: 1; Rectangle { height: 1px; background: #ee765e66; } }
        }
        if root.message.kind == "message": HorizontalLayout {
            padding-left: 16px; padding-right: 20px; padding-top: root.message.compact ? 2px : 7px; padding-bottom: root.message.compact ? 2px : 5px; spacing: 11px;
            Rectangle {
                width: 42px;
                if !root.message.compact: Rectangle {
                    width: 38px; height: 38px; x: 0px; y: 1px;
                    Avatar { width: 38px; height: 38px; initials: root.message.avatar; has-image: root.message.has-avatar; source: root.message.avatar-image; }
                    TouchArea { accessible-role: button; accessible-label: "View profile of " + root.message.author; clicked => { if (root.message.author-id != "") { root.profile(root.message.author-id); } } }
                }
                if root.message.compact: Text { x: 0px; width: 42px; height: 18px; text: root.message.time; color: touch.has-hover ? Theme.muted : transparent; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
            }
            VerticalLayout { spacing: 3px; alignment: start;
                if root.message.has-reference: HorizontalLayout {
                    spacing: 6px; alignment: start;
                    VerticalLayout { alignment: center; VectorIcon { width: 13px; height: 13px; kind: "reply"; icon-color: Theme.muted; } }
                    Text { text: root.message.reference-author; color: Theme.text-soft; font-size: 11px; font-weight: 750; vertical-alignment: center; }
                    Text { text: root.message.reference-body; color: Theme.muted; font-size: 11px; overflow: elide; vertical-alignment: center; max-width: 420px; }
                }
                if !root.message.compact: HorizontalLayout { spacing: 8px; alignment: start;
                    Rectangle {
                        width: author-label.preferred-width; height: author-label.preferred-height;
                        author-label := Text { x: 0; y: 0; text: root.message.author; color: Theme.text; font-size: 13.5px; font-weight: 750; }
                        TouchArea { accessible-role: button; accessible-label: "View profile of " + root.message.author; clicked => { if (root.message.author-id != "") { root.profile(root.message.author-id); } } }
                    }
                    Text { text: root.message.time; color: Theme.muted; font-size: 10px; vertical-alignment: center; }
                    if root.message.edited: Text { text: "(edited)"; color: Theme.muted; font-size: 9.5px; vertical-alignment: center; }
                }
                if root.message.body != "": Text { text: root.message.body; color: root.message.failed ? Theme.red : Theme.text; opacity: root.message.pending || root.message.retrying ? 0.52 : 1; font-size: 13.5px; wrap: word-wrap; }
                if root.message.compact && root.message.edited && root.message.body == "": Text { text: "(edited)"; color: Theme.muted; font-size: 9.5px; }
                if root.message.has-attachment-preview: HorizontalLayout { alignment: start;
                    Rectangle {
                        width: min(460px, root.width - 120px); height: self.width * 0.58; border-radius: 12px; clip: true; background: Theme.subtle; border-width: 1px; border-color: Theme.border-soft;
                        Image { x: 0; y: 0; width: parent.width; height: parent.height; source: root.message.attachment-preview; image-fit: root.message.attachment-kind == "gif" ? cover : contain; }
                        if root.message.attachment-kind == "video": Rectangle { width: 58px; height: 58px; border-radius: 29px; background: #b0000000; Text { text: "▶"; color: white; font-size: 23px; horizontal-alignment: center; vertical-alignment: center; } }
                        if root.message.attachment-kind == "gif": Rectangle { x: 10px; y: parent.height - 30px; width: 66px; height: 20px; border-radius: 5px; background: #000000aa; Text { text: "GIF · KLIPY"; color: white; font-size: 8.5px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } }
                        TouchArea { accessible-role: button; accessible-label: root.message.attachment-kind == "video" ? "Play video" : "Open image"; clicked => { if (root.message.attachment-kind != "gif") { root.open-media(); } } }
                    }
                }
                if root.message.attachments != "" && !root.message.has-attachment-preview: HorizontalLayout { alignment: start;
                    Rectangle { height: 38px; border-radius: 9px; background: Theme.raised; border-width: 1px; border-color: Theme.border-soft;
                        HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 8px; alignment: start;
                            Text { text: "📎"; font-size: 13px; vertical-alignment: center; }
                            Text { text: root.message.attachments; color: Theme.accent-text; font-size: 12px; font-weight: 650; vertical-alignment: center; }
                        }
                        TouchArea { accessible-role: button; accessible-label: "Open attachment"; clicked => { root.open-media(); } }
                    }
                }
                if root.message.preview-url != "": HorizontalLayout { alignment: start;
                    Rectangle {
                        width: min(520px, root.width - 120px); border-radius: 10px; background: Theme.subtle; border-width: 1px; border-color: Theme.border-soft;
                        Rectangle { x: 0; y: 0; width: 4px; height: parent.height; border-radius: 2px; background: Theme.accent; }
                        VerticalLayout { padding: 11px; padding-left: 15px; spacing: 3px;
                            Text { text: root.message.preview-site.to-uppercase(); color: Theme.muted; font-size: 9px; font-weight: 800; letter-spacing: 0.8px; }
                            Text { text: root.message.preview-title == "" ? root.message.preview-url : root.message.preview-title; color: Theme.accent-text; font-size: 13px; font-weight: 750; wrap: word-wrap; }
                            if root.message.preview-description != "": Text { text: root.message.preview-description; color: Theme.text-soft; font-size: 11.5px; wrap: word-wrap; }
                            if root.message.preview-media-type != "": Text { text: root.message.preview-media-type == "video" ? "Video preview" : "Image preview"; color: Theme.muted; font-size: 10px; }
                        }
                    }
                }
                if root.message.failed: Text { text: root.message.failure-reason == "" ? "Message not delivered · Right-click to retry" : root.message.failure-reason + " · Right-click to retry"; color: Theme.red; font-size: 11px; font-weight: 650; wrap: word-wrap; }
                if root.message.retrying: Text { text: (root.message.failure-reason == "" ? "The receiving instance is temporarily unavailable" : root.message.failure-reason) + " · Retrying automatically…"; color: Theme.accent-text; font-size: 11px; font-weight: 650; wrap: word-wrap; }
                if root.message.pending && !root.message.failed: Text { text: "Sending…"; color: Theme.muted; font-size: 10px; }
            }
        }
    }
}

component Composer inherits Rectangle {
    in-out property <string> text;
    in property <string> channel-name;
    in property <bool> can-send: true;
    in property <bool> send-blocked: false;
    in property <string> blocked-reason;
    in property <bool> attachment-busy: false;
    in property <string> pending-attachments;
    in property <bool> editing: false;
    in property <bool> banner-above: false;
    callback send(string);
    callback attach;
    callback gif;
    callback emoji;
    callback clear-attachments;
    callback draft-edited(string);
    callback escape-pressed;
    callback edit-last;
    private property <length> composer-height: max(54px, min(190px, editor.preferred-height + 22px));
    min-height: self.composer-height;
    max-height: self.composer-height;
    border-radius: root.banner-above ? 0px : 17px;
    border-bottom-left-radius: 17px; border-bottom-right-radius: 17px;
    background: Theme.raised;
    border-width: 1px; border-color: Theme.border;
    drop-shadow-blur: 12px; drop-shadow-color: #00000029; drop-shadow-offset-y: 2px;
    HorizontalLayout {
        padding: 6px; spacing: 4px;
        VerticalLayout { alignment: end; IconButton { icon: root.attachment-busy ? "…" : "plus"; label: "Attach file"; clicked => { if (!root.attachment-busy && !root.editing) { root.attach(); } } } }
        Rectangle {
            editor := TextInput {
                x: 8px; y: min(parent.height - self.preferred-height, (parent.height - self.preferred-height) / 2);
                width: parent.width - 16px; height: min(parent.height, self.preferred-height);
                single-line: false; wrap: word-wrap;
                text <=> root.text;
                color: Theme.text; font-size: 14px; selection-background-color: Theme.accent;
                key-pressed(event) => {
                    if (event.text == Key.Return && !event.modifiers.shift) {
                        if (!root.send-blocked && (root.text != "" || root.pending-attachments != "")) {
                            root.send(root.text);
                        }
                        return accept;
                    }
                    if (event.text == Key.Escape) {
                        root.escape-pressed();
                        return accept;
                    }
                    if (event.text == Key.UpArrow && root.text == "") {
                        root.edit-last();
                        return accept;
                    }
                    return reject;
                }
                edited => { root.draft-edited(self.text); }
            }
            if root.text == "" && !editor.has-focus: Text { x: 8px; text: root.editing ? "Edit your message" : "Message " + root.channel-name; color: #817a72; font-size: 14px; vertical-alignment: center; height: parent.height; }
        }
        VerticalLayout { alignment: end; HorizontalLayout { spacing: 4px;
            if !root.editing: IconButton { icon: "GIF"; label: "Open GIF picker"; clicked => { root.gif(); } }
            IconButton { icon: "smile"; label: "Open emoji picker"; clicked => { root.emoji(); } }
            Rectangle {
                width: 42px; height: 40px;
                Rectangle {
                    width: 36px; height: 36px; x: 3px; y: 2px; border-radius: 12px;
                    background: root.send-blocked || (root.text == "" && root.pending-attachments == "") ? Theme.hover : send-touch.has-hover ? Theme.accent-hover : Theme.accent;
                    VectorIcon { x: 8px; y: 8px; width: 20px; height: 20px; kind: "send"; icon-color: root.send-blocked || (root.text == "" && root.pending-attachments == "") ? Theme.muted : Theme.on-accent; }
                    send-touch := TouchArea { accessible-role: button; accessible-label: "Send message"; clicked => { if (!root.send-blocked && (root.text != "" || root.pending-attachments != "")) { root.send(root.text); } } }
                }
            }
        } }
    }
}

component ChatPane inherits Rectangle {
    in property <string> channel-name;
    in property <string> channel-topic;
    in property <bool> direct-message: false;
    in property <string> call-state;
    in property <bool> call-incoming: false;
    in property <[MessageItem]> messages;
    in property <bool> loading: false;
    in property <bool> can-send: true;
    in property <bool> history-loading: false;
    in property <bool> history-complete: false;
    in property <bool> history-truncated: false;
    in property <bool> history-remote-available: false;
    in property <string> history-page-warning;
    in property <string> guild-history-warning;
    in property <int> slow-mode-remaining: 0;
    in-out property <string> draft;
    in property <bool> attachment-busy: false;
    in property <string> pending-attachments;
    in property <[CompletionItem]> completions;
    in property <string> typing-indicator;
    in property <string> replying-author;
    in property <bool> editing: false;
    in-out property <bool> reply-notify: true;
    in property <bool> reply-can-notify: false;
    callback send(string);
    callback toggle-members;
    callback open-pins;
    callback open-message-media(string);
    callback message-context(string, string, bool, bool, string, int, int);
    callback member-profile(string);
    callback load-older;
    callback attach;
    callback gif;
    callback emoji;
    callback clear-attachments;
    callback start-call;
    callback accept-call;
    callback decline-call;
    callback end-call;
    callback draft-edited(string);
    callback completion-selected(string);
    callback cancel-reply;
    callback cancel-edit;
    callback edit-last;
    private property <int> previous-message-count: 0;
    private property <int> message-count: root.messages.length;
    private property <length> scroll-y: message-list.viewport-y;
    private property <bool> anchor-pending: false;
    private property <length> anchor-viewport-height;
    private property <length> anchor-viewport-y;
    in-out property <int> unseen: 0;
    private property <bool> at-bottom: -message-list.viewport-y + message-list.height >= message-list.viewport-height - 32px;
    function request-older() {
        if (!root.history-loading && !root.history-complete && root.messages.length > 0) {
            root.anchor-pending = true;
            root.anchor-viewport-height = message-list.viewport-height;
            root.anchor-viewport-y = message-list.viewport-y;
            root.load-older();
        }
    }
    changed scroll-y => {
        // Infinite scroll: fetch older history as the view nears the top,
        // like the web client's 24px trigger.
        if (message-list.viewport-y > -24px && message-list.viewport-height > message-list.height) {
            root.request-older();
        }
        if (root.at-bottom) {
            root.unseen = 0;
        }
    }
    changed message-count => {
        if (root.anchor-pending) {
            // Keep the previously visible message in place after older
            // history is prepended (scroll anchoring).
            message-list.viewport-y = min(0px, root.anchor-viewport-y - (message-list.viewport-height - root.anchor-viewport-height));
            root.anchor-pending = false;
        } else if (root.previous-message-count == 0 || root.at-bottom) {
            message-list.viewport-y = min(0px, message-list.height - message-list.viewport-height);
            root.unseen = 0;
        } else if (root.message-count > root.previous-message-count) {
            root.unseen += root.message-count - root.previous-message-count;
        }
        root.previous-message-count = root.message-count;
        if (message-list.viewport-height <= message-list.height) {
            // The loaded slice does not fill the viewport yet; keep loading
            // so the conversation becomes scrollable.
            root.request-older();
        }
    }
    background: Theme.surface;
    VerticalLayout {
        Rectangle { height: 64px; background: Theme.surface; border-width: 1px; border-color: Theme.border-soft;
            HorizontalLayout { padding-left: 18px; padding-right: 12px; spacing: 11px;
                VerticalLayout { alignment: center; Rectangle { width: 34px; height: 34px; border-radius: 11px; background: root.direct-message ? Theme.green-soft : Theme.accent-soft; Text { text: root.direct-message ? "@" : "#"; color: root.direct-message ? Theme.green : Theme.accent-text; font-size: 16px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } } }
                VerticalLayout { alignment: center; spacing: 1px;
                    Text { text: root.channel-name; color: Theme.text; font-size: 14.5px; font-weight: 750; overflow: elide; }
                    if root.channel-topic != "": Text { text: root.channel-topic; color: Theme.muted; font-size: 10.5px; overflow: elide; }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { alignment: center; HorizontalLayout { spacing: 4px;
                    IconButton { icon: "pin"; label: "Pinned messages"; clicked => { root.open-pins(); } }
                    if root.direct-message && root.call-state == "": IconButton { icon: "phone"; label: "Start voice call"; clicked => { root.start-call(); } }
                    if !root.direct-message: IconButton { icon: "people"; label: "Toggle member list"; clicked => { root.toggle-members(); } }
                } }
            }
        }
        if root.direct-message && root.call-state != "": Rectangle { height: 58px; background: Theme.green-soft; HorizontalLayout { padding-left: 18px; padding-right: 18px; spacing: 9px; Text { text: root.call-incoming ? "Incoming voice call" : root.call-state == "ringing" ? "Calling…" : "Voice call in progress"; color: Theme.text; font-weight: 800; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } if root.call-incoming: PillButton { text: "Decline"; destructive: true; clicked => { root.decline-call(); } } if root.call-incoming: PillButton { text: "Join"; primary: true; clicked => { root.accept-call(); } } if !root.call-incoming: PillButton { text: "End call"; destructive: true; clicked => { root.end-call(); } } } }
        if root.direct-message && root.history-truncated && (root.history-remote-available || root.history-complete): Rectangle {
            height: 44px;
            background: Theme.subtle;
            border-width: 1px;
            border-color: Theme.border-soft;
            Text {
                x: 18px; width: parent.width - 36px; height: parent.height;
                text: root.history-remote-available
                    ? "This replica caches recent messages. Earlier history is fetched privately from the conversation's home instance when you load it."
                    : "Recent history starts here. Older messages are not available from this replica.";
                color: Theme.muted; font-size: 10.5px; font-weight: 650;
                wrap: word-wrap; vertical-alignment: center; horizontal-alignment: center;
            }
        }
        if root.direct-message && root.history-page-warning != "": Rectangle {
            height: 44px;
            background: #352d20;
            border-width: 1px;
            border-color: Theme.warning;
            Text {
                x: 18px; width: parent.width - 36px; height: parent.height;
                text: root.history-page-warning;
                color: Theme.text-soft; font-size: 10.5px; font-weight: 650;
                wrap: word-wrap; vertical-alignment: center; horizontal-alignment: center;
            }
        }
        if !root.direct-message && root.guild-history-warning != "": Rectangle {
            height: 52px;
            background: #352d20;
            border-width: 1px;
            border-color: Theme.warning;
            Text {
                x: 18px; width: parent.width - 36px; height: parent.height;
                text: root.guild-history-warning;
                color: Theme.text-soft; font-size: 10.5px; font-weight: 650;
                wrap: word-wrap; vertical-alignment: center; horizontal-alignment: center;
            }
        }
        if root.loading: Rectangle { vertical-stretch: 1; VerticalLayout { alignment: center; spacing: 12px;
                HorizontalLayout { alignment: center; Rectangle { width: 52px; height: 52px; border-radius: 18px; background: Theme.accent-soft; Text { text: "···"; color: Theme.accent; font-size: 22px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; } } }
                Text { text: "Loading conversation"; color: Theme.text; font-size: 18px; font-weight: 850; horizontal-alignment: center; }
                Text { text: "Fetching the latest messages from your home instance…"; color: Theme.muted; font-size: 12px; horizontal-alignment: center; }
            } }
        if !root.loading && root.messages.length == 0: Rectangle { vertical-stretch: 1; VerticalLayout { alignment: center; spacing: 10px;
                HorizontalLayout { alignment: center; Rectangle { width: 56px; height: 56px; border-radius: 18px; background: root.direct-message ? Theme.green-soft : Theme.accent-soft; Text { text: root.direct-message ? "@" : "#"; color: root.direct-message ? Theme.green : Theme.accent-text; font-size: 25px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; } } }
                Text { text: root.channel-name == "" ? "Choose a conversation" : "Welcome to " + (root.direct-message ? "@" : "#") + root.channel-name; color: Theme.text; font-size: 22px; font-weight: 900; horizontal-alignment: center; }
                Text { text: root.channel-name == "" ? "Select a channel from the sidebar." : "This is the beginning of the conversation."; color: Theme.muted; font-size: 12px; horizontal-alignment: center; }
            } }
        Rectangle {
            vertical-stretch: !root.loading && root.messages.length > 0 ? 1 : 0;
            preferred-height: 0px;
            min-height: 0px;
            visible: !root.loading && root.messages.length > 0;
            message-list := ListView {
                width: parent.width; height: parent.height;
                for item[i] in root.messages: MessageRow {
                    message: item;
                    context(x, y) => { root.message-context(item.id, item.author-id, item.mine, item.failed, item.gif-url, x / 1px, y / 1px); }
                    open-media => { root.open-message-media(item.id); }
                    profile(id) => { root.member-profile(id); }
                }
            }
            if root.history-loading: Rectangle { x: (parent.width - 150px) / 2; y: 8px; width: 150px; height: 28px; border-radius: 14px; background: Theme.raised; border-width: 1px; border-color: Theme.border; Text { text: "Loading history…"; color: Theme.muted; font-size: 11px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; } }
            if root.unseen > 0 && !root.at-bottom: Rectangle {
                x: parent.width - self.width - 20px; y: parent.height - 44px;
                width: pill-label.preferred-width + 30px; height: 32px; border-radius: 16px;
                background: pill-touch.has-hover ? Theme.accent-hover : Theme.accent;
                drop-shadow-blur: 18px; drop-shadow-color: #00000055; drop-shadow-offset-y: 4px;
                pill-label := Text { text: root.unseen == 1 ? "1 new message ↓" : "\{root.unseen} new messages ↓"; color: Theme.on-accent; font-size: 11.5px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; }
                pill-touch := TouchArea { accessible-role: button; accessible-label: "Jump to latest messages"; clicked => { message-list.viewport-y = min(0px, message-list.height - message-list.viewport-height); root.unseen = 0; } }
            }
        }
        Rectangle { height: 20px; vertical-stretch: 0; Text { x: 24px; width: parent.width - 48px; height: parent.height; text: root.typing-indicator; color: Theme.muted; font-size: 10.5px; font-weight: 650; vertical-alignment: center; overflow: elide; } }
        if !root.loading: Rectangle {
            background: Theme.surface;
            vertical-stretch: 0;
            if root.completions.length > 0: Rectangle {
                x: 19px; y: -6px - min(300px, root.completions.length * 52px + 12px);
                width: min(parent.width - 38px, 620px); height: min(300px, root.completions.length * 52px + 12px);
                border-radius: 13px; background: Theme.raised; border-width: 1px; border-color: Theme.border;
                drop-shadow-blur: 28px; drop-shadow-color: #00000055; drop-shadow-offset-y: 8px;
                ScrollView { VerticalLayout { padding: 6px; spacing: 3px; for item in root.completions: Rectangle { height: 47px; border-radius: 9px; background: completion-touch.has-hover ? Theme.hover : transparent; HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 10px; VerticalLayout { alignment: center; Rectangle { width: 32px; height: 32px; border-radius: 10px; background: item.kind == "role" ? Theme.purple-soft : item.kind == "channel" ? Theme.green-soft : Theme.accent-soft; Text { text: item.kind == "emoji" ? item.value : item.kind == "channel" ? "#" : "@"; color: item.kind == "role" ? Theme.purple : item.kind == "channel" ? Theme.green : Theme.accent-text; font-size: item.kind == "emoji" ? 16px : 14px; horizontal-alignment: center; vertical-alignment: center; } } } VerticalLayout { alignment: center; Text { text: item.label; color: Theme.text; font-size: 13px; font-weight: 700; } Text { text: item.detail; color: Theme.muted; font-size: 10px; } } } completion-touch := TouchArea { accessible-role: button; accessible-label: item.label; clicked => { root.completion-selected(item.value); } } } } }
            }
            VerticalLayout {
                padding-left: 19px; padding-right: 19px; padding-bottom: 16px; spacing: 0px;
                if root.pending-attachments != "": Rectangle { height: 32px; border-radius: 9px; background: Theme.subtle; border-width: 1px; border-color: Theme.border-soft; HorizontalLayout { padding-left: 10px; spacing: 8px; Text { text: "Ready · " + root.pending-attachments; color: Theme.text-soft; font-size: 12px; overflow: elide; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } IconButton { width: 28px; height: 28px; icon: "close"; label: "Remove attachments"; clicked => { root.clear-attachments(); } } } }
                if root.pending-attachments != "": Rectangle { height: 4px; }
                if root.editing: Rectangle {
                    height: 40px; background: Theme.subtle; border-width: 1px; border-color: Theme.border;
                    border-top-left-radius: 12px; border-top-right-radius: 12px;
                    HorizontalLayout { padding-left: 14px; padding-right: 8px; spacing: 9px;
                        VectorIcon { width: 14px; height: 14px; y: (parent.height - 14px) / 2; kind: "edit"; icon-color: Theme.accent-text; }
                        Text { text: "Editing message"; color: Theme.text; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                        Text { text: "Enter to save · Escape to cancel"; color: Theme.muted; font-size: 10.5px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        IconButton { width: 30px; height: 30px; icon: "close"; label: "Cancel edit"; clicked => { root.cancel-edit(); } }
                    }
                }
                if root.replying-author != "" && !root.editing: Rectangle {
                    height: 40px; background: Theme.subtle; border-width: 1px; border-color: Theme.border;
                    border-top-left-radius: 12px; border-top-right-radius: 12px;
                    HorizontalLayout { padding-left: 14px; padding-right: 8px; spacing: 9px;
                        VectorIcon { width: 14px; height: 14px; y: (parent.height - 14px) / 2; kind: "reply"; icon-color: Theme.accent-text; }
                        Text { text: "Replying to "; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
                        Text { text: root.replying-author; color: Theme.text; font-size: 12px; font-weight: 750; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        if root.reply-can-notify: CheckBox { text: "Notify author"; checked <=> root.reply-notify; }
                        IconButton { width: 30px; height: 30px; icon: "close"; label: "Cancel reply"; clicked => { root.cancel-reply(); } }
                    }
                }
                if !root.can-send: Rectangle {
                    height: 54px; border-radius: 17px; background: Theme.subtle; border-width: 1px; border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px; spacing: 10px;
                        VectorIcon { width: 17px; height: 17px; y: (parent.height - 17px) / 2; kind: "lock"; icon-color: Theme.muted; }
                        Text { text: "You do not have permission to send messages in this channel."; color: Theme.muted; font-size: 12.5px; vertical-alignment: center; overflow: elide; }
                    }
                }
                if root.can-send: Composer {
                    text <=> root.draft; channel-name: root.channel-name;
                    can-send: root.can-send;
                    send-blocked: root.slow-mode-remaining > 0;
                    attachment-busy: root.attachment-busy; pending-attachments: root.pending-attachments;
                    editing: root.editing;
                    banner-above: root.replying-author != "" || root.editing;
                    send(value) => { root.send(value); }
                    attach => { root.attach(); }
                    clear-attachments => { root.clear-attachments(); }
                    gif => { root.gif(); }
                    emoji => { root.emoji(); }
                    draft-edited(value) => { root.draft-edited(value); }
                    escape-pressed => { if (root.editing) { root.cancel-edit(); } else { root.cancel-reply(); } }
                    edit-last => { root.edit-last(); }
                }
                HorizontalLayout {
                    padding-top: 3px;
                    Rectangle { horizontal-stretch: 1; }
                    if root.slow-mode-remaining > 0: Text { text: "⏱ \{root.slow-mode-remaining}s"; color: Theme.warning; font-size: 10px; font-weight: 700; }
                    if root.slow-mode-remaining == 0 && root.draft.character-count > 3200: Text { text: "\{root.draft.character-count}/4000"; color: root.draft.character-count > 4000 ? Theme.red : Theme.muted; font-size: 10px; }
                }
            }
        }
    }
}

component ChannelLoadingPane inherits Rectangle {
    background: Theme.surface;
    VerticalLayout { alignment: center; spacing: 12px;
        HorizontalLayout { alignment: center; Rectangle { width: 58px; height: 58px; border-radius: 19px; background: Theme.accent-soft; Text { text: "···"; color: Theme.accent; font-size: 24px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; } } }
        Text { text: "Opening channel"; color: Theme.text; font-size: 20px; font-weight: 900; horizontal-alignment: center; }
        Text { text: "Loading permissions, members, and recent messages…"; color: Theme.muted; font-size: 12px; horizontal-alignment: center; }
    }
}

component PinnedMessagesOverlay inherits Rectangle {
    in property <[MessageItem]> messages;
    callback close;
    background: transparent;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        x: parent.width - min(390px, parent.width - 32px) - 12px; y: 68px;
        width: min(390px, parent.width - 32px); height: min(560px, parent.height - 84px);
        border-radius: 14px;
        background: Theme.raised; border-width: 1px; border-color: Theme.border;
        drop-shadow-blur: 40px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
        clip: true;
        TouchArea { }
        VerticalLayout {
            Rectangle { height: 52px; border-width: 1px; border-color: Theme.border-soft; HorizontalLayout { padding-left: 16px; padding-right: 8px; Text { text: "Pinned messages"; color: Theme.text; font-size: 15px; font-weight: 800; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } VerticalLayout { alignment: center; IconButton { width: 34px; height: 34px; icon: "close"; label: "Close pinned messages"; clicked => { root.close(); } } } } }
            if root.messages.length == 0: VerticalLayout { alignment: center; spacing: 8px; HorizontalLayout { alignment: center; VectorIcon { width: 28px; height: 28px; kind: "pin"; icon-color: Theme.muted; } } Text { text: "No pinned messages yet."; color: Theme.muted; font-size: 12px; horizontal-alignment: center; } }
            if root.messages.length > 0: ListView { vertical-stretch: 1; for item in root.messages: MessageRow { message: item; } }
        }
    }
}

component EmojiPicker inherits Rectangle {
    in property <[[EmojiItem]]> grid;
    in property <bool> reaction: false;
    callback choose(string);
    callback search(string);
    callback close;
    background: transparent;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        x: root.reaction ? (parent.width - self.width) / 2 : max(12px, parent.width - self.width - 24px);
        y: root.reaction ? (parent.height - self.height) / 2 : max(12px, parent.height - self.height - 92px);
        width: min(390px, parent.width - 48px); height: min(520px, parent.height - 48px);
        border-radius: 14px; background: Theme.raised; border-width: 1px; border-color: Theme.border;
        drop-shadow-blur: 40px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
        clip: true;
        TouchArea { }
        VerticalLayout { padding: 12px; spacing: 9px;
            HorizontalLayout { Text { text: root.reaction ? "React" : "Emoji"; color: Theme.text; font-size: 16px; font-weight: 850; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } IconButton { width: 32px; height: 32px; icon: "close"; label: "Close emoji picker"; clicked => { root.close(); } } }
            search-field := FormField { height: 40px; placeholder: "Search emoji"; edited => { root.search(self.text); } }
            HorizontalLayout { spacing: 2px;
                for category in [
                    { id: "", icon: "✦" },
                    { id: "people", icon: "😀" },
                    { id: "nature", icon: "🐻" },
                    { id: "food", icon: "🍕" },
                    { id: "activity", icon: "🎮" },
                    { id: "travel", icon: "🚀" },
                    { id: "objects", icon: "💡" },
                    { id: "symbols", icon: "✨" },
                    { id: "flags", icon: "🏳" },
                ]: Rectangle {
                    height: 32px; horizontal-stretch: 1; border-radius: 8px; background: tab-touch.has-hover ? Theme.hover : transparent;
                    Text { text: category.icon; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
                    tab-touch := TouchArea { accessible-role: button; accessible-label: category.id == "" ? "All emoji" : category.id; clicked => { search-field.text = ""; root.search(category.id == "" ? "" : "cat:" + category.id); } }
                }
            }
            ListView {
                vertical-stretch: 1;
                for row in root.grid: Rectangle {
                    height: row.length == 1 && row[0].header ? 30px : 40px;
                    if row.length == 1 && row[0].header: Text { x: 4px; text: row[0].label; color: Theme.muted; font-size: 9.5px; font-weight: 800; letter-spacing: 1.1px; vertical-alignment: center; height: parent.height; }
                    if !(row.length == 1 && row[0].header): HorizontalLayout {
                        spacing: 0px;
                        for cell in row: Rectangle {
                            width: 40px; height: 40px; border-radius: 8px; background: cell-touch.has-hover ? Theme.hover : transparent;
                            if cell.value.character-count <= 12: Text { text: cell.value; font-size: 21px; horizontal-alignment: center; vertical-alignment: center; }
                            if cell.value.character-count > 12: Text { text: cell.label; color: Theme.accent-text; font-size: 9px; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; overflow: elide; width: parent.width - 4px; }
                            cell-touch := TouchArea { accessible-role: button; accessible-label: cell.label; clicked => { root.choose(cell.value); } }
                        }
                    }
                }
            }
        }
    }
}

component GifPicker inherits Rectangle {
    in property <[GifItem]> gifs;
    in-out property <string> query;
    callback search(string);
    callback choose(string);
    callback favorite(string, string, string);
    callback load-more;
    callback close;
    background: transparent;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        x: max(12px, parent.width - self.width - 24px); y: max(12px, parent.height - self.height - 92px);
        width: min(430px, parent.width - 48px); height: min(560px, parent.height - 48px);
        border-radius: 14px; background: Theme.raised; border-width: 1px; border-color: Theme.border;
        drop-shadow-blur: 40px; drop-shadow-color: #00000066; drop-shadow-offset-y: 12px;
        clip: true;
        TouchArea { }
        VerticalLayout { padding: 12px; spacing: 9px;
            HorizontalLayout { spacing: 6px;
                Text { text: "GIFs"; color: Theme.text; font-size: 16px; font-weight: 850; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                PillButton { height: 32px; min-width: 84px; text: "Favorites"; clicked => { root.query = ""; root.search(""); } }
                IconButton { width: 32px; height: 32px; icon: "close"; label: "Close GIF picker"; clicked => { root.close(); } }
            }
            HorizontalLayout { spacing: 6px;
                query-field := FormField { height: 40px; placeholder: "Search KLIPY"; text <=> root.query; accepted => { root.search(self.text); } }
                PillButton { height: 40px; min-width: 74px; text: "Search"; primary: true; clicked => { root.search(root.query); } }
            }
            ListView {
                vertical-stretch: 1;
                for item[i] in root.gifs: Rectangle {
                    height: 144px;
                    Rectangle {
                        y: 3px; height: parent.height - 6px; width: parent.width - 4px; x: 2px;
                        border-radius: 12px; clip: true;
                        background: Theme.subtle; border-width: 1px; border-color: gif-touch.has-hover ? Theme.accent : Theme.border-soft;
                        if item.has-preview: Image { width: parent.width; height: parent.height; source: item.preview; image-fit: cover; }
                        if !item.has-preview: Text { text: "GIF"; color: Theme.muted; font-size: 17px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
                        Rectangle { x: 0; y: parent.height - 30px; width: parent.width; height: 30px; background: #000000a0;
                            Text { x: 10px; width: parent.width - 56px; text: item.title; color: white; font-size: 11px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                        }
                        gif-touch := TouchArea { accessible-role: button; accessible-label: "Send " + item.title; clicked => { root.choose(item.url); } }
                        Rectangle {
                            x: parent.width - 36px; y: 6px; width: 30px; height: 30px; border-radius: 15px;
                            background: #000000a0; visible: gif-touch.has-hover || item.favorite;
                            Text { text: item.favorite ? "★" : "☆"; color: item.favorite ? #ffd76a : white; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { accessible-role: button; accessible-label: item.favorite ? "Remove from favorites" : "Add to favorites"; clicked => { root.favorite(item.id, item.title, item.url); } }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                if root.gifs.length > 0: PillButton { height: 34px; text: "Load more"; clicked => { root.load-more(); } }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "Powered by KLIPY"; color: Theme.muted; font-size: 10px; vertical-alignment: center; }
            }
        }
    }
}

component MenuAction inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> danger: false;
    callback clicked;
    height: 37px; border-radius: 8px;
    background: touch.has-hover ? (danger ? Theme.red-soft : Theme.hover) : transparent;
    HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 10px;
        VectorIcon { width: 17px; height: 17px; y: (parent.height - 17px) / 2; kind: root.icon; icon-color: root.danger ? Theme.red : Theme.text-soft; }
        Text { text: root.label; color: root.danger ? Theme.red : Theme.text; font-size: 12.5px; font-weight: 620; vertical-alignment: center; overflow: elide; }
    }
    touch := TouchArea { accessible-role: button; accessible-label: root.label; clicked => { root.clicked(); } }
}

component MessageMenu inherits Rectangle {
    in property <bool> mine;
    in property <bool> failed;
    in property <string> gif-url;
    in property <string> author-id;
    in property <int> menu-x;
    in property <int> menu-y;
    callback retry;
    callback reply;
    callback edit;
    callback remove;
    callback pin;
    callback copy;
    callback view-profile(string);
    callback copy-username(string);
    callback favorite-gif(string);
    callback close;
    background: transparent;
    private property <bool> confirm-delete: false;
    private property <int> item-count: 3
        + (root.failed ? 1 : 0)
        + (root.gif-url != "" ? 1 : 0)
        + (root.author-id != "" ? 2 : 0)
        + (root.mine && !root.failed ? 2 : 0);
    private property <length> menu-height: root.item-count * 39px + 20px + (root.confirm-delete ? 76px : 0px);
    TouchArea { clicked => { root.close(); } pointer-event(event) => { if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down) { root.close(); } } }
    Rectangle {
        x: min(root.menu-x * 1px, root.width - 246px); y: min(root.menu-y * 1px, root.height - root.menu-height - 12px);
        width: 234px; height: root.menu-height;
        border-radius: 12px; background: Theme.raised; border-width: 1px; border-color: Theme.border;
        drop-shadow-blur: 36px; drop-shadow-color: #00000073; drop-shadow-offset-y: 10px;
        TouchArea { }
        VerticalLayout { padding: 10px; spacing: 2px;
            if root.failed: MenuAction { icon: "refresh"; label: "Retry message"; clicked => { root.retry(); } }
            MenuAction { icon: "reply"; label: "Reply"; clicked => { root.reply(); } }
            MenuAction { icon: "pin"; label: "Pin or unpin"; clicked => { root.pin(); } }
            if root.gif-url != "": MenuAction { icon: "star"; label: "Add to GIF favorites"; clicked => { root.favorite-gif(root.gif-url); } }
            if root.author-id != "": MenuAction { icon: "profile"; label: "View profile"; clicked => { root.view-profile(root.author-id); } }
            if root.author-id != "": MenuAction { icon: "copy"; label: "Copy username"; clicked => { root.copy-username(root.author-id); } }
            if root.mine && !root.failed: MenuAction { icon: "edit"; label: "Edit message"; clicked => { root.edit(); } }
            MenuAction { icon: "copy"; label: "Copy text"; clicked => { root.copy(); } }
            if root.mine && !root.failed && !root.confirm-delete: MenuAction { icon: "trash"; label: "Delete message"; danger: true; clicked => { root.confirm-delete = true; } }
            if root.mine && !root.failed && root.confirm-delete: Rectangle {
                height: 37px + 76px; border-radius: 8px; background: Theme.red-soft;
                VerticalLayout { padding: 10px; spacing: 8px;
                    Text { text: "Delete this message?"; color: Theme.text; font-size: 12px; font-weight: 750; }
                    HorizontalLayout { spacing: 8px;
                        PillButton { height: 32px; min-width: 80px; text: "Cancel"; clicked => { root.confirm-delete = false; } }
                        PillButton { height: 32px; min-width: 80px; text: "Delete"; destructive: true; clicked => { root.remove(); } }
                    }
                }
            }
        }
    }
}

component VoicePane inherits Rectangle {
    in property <string> channel-name;
    in property <string> status;
    in-out property <bool> muted;
    in-out property <bool> deafened;
    in property <bool> can-speak;
    in property <bool> can-stream;
    in-out property <bool> screen-sharing;
    in-out property <bool> camera-enabled;
    in property <[VoiceMemberItem]> participants;
    in property <[VideoTileItem]> remote-videos;
    in property <[ChannelItem]> channels;
    in property <bool> can-mute-voice: false;
    in property <bool> can-deafen-voice: false;
    in property <bool> can-move-voice: false;
    in-out property <string> move-user;
    callback join;
    callback leave;
    callback mute(bool);
    callback deafen(bool);
    callback push-to-talk(bool);
    callback camera(bool);
    callback screen-share(bool);
    callback toggle-members;
    callback moderate-participant(string, string);
    background: Theme.surface;
    VerticalLayout {
        Rectangle { height: 64px; background: Theme.surface; border-width: 1px; border-color: Theme.border-soft; HorizontalLayout { padding-left: 18px; padding-right: 12px; spacing: 10px; VerticalLayout { alignment: center; Rectangle { width: 34px; height: 34px; border-radius: 11px; background: Theme.green-soft; VectorIcon { x: 8px; y: 8px; width: 18px; height: 18px; kind: "voice"; icon-color: Theme.green; } } } Text { text: root.channel-name; color: Theme.text; font-size: 14.5px; font-weight: 750; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } VerticalLayout { alignment: center; IconButton { icon: "people"; label: "Toggle member list"; clicked => { root.toggle-members(); } } } } }
        Rectangle { vertical-stretch: 1; background: Theme.canvas;
            VerticalLayout { alignment: center; spacing: 16px;
                HorizontalLayout { alignment: center; Rectangle { width: 92px; height: 92px; border-radius: 32px; background: root.status == "connected" ? #234b39 : Theme.accent-soft; VectorIcon { x: 28px; y: 28px; width: 36px; height: 36px; kind: "voice"; icon-color: root.status == "connected" ? Theme.green : Theme.accent; } } }
                Text { text: root.status == "connected" ? "Voice connected" : root.status == "connecting" ? "Connecting…" : root.status == "reconnecting" ? "Reconnecting…" : "Ready when you are"; color: Theme.text; font-size: 27px; font-weight: 900; horizontal-alignment: center; }
                Text { text: root.status == "connected" ? (root.can-speak ? "Native audio is routed through your selected input and output devices." : "Listen-only: you do not have permission to speak in this channel.") : "Join to talk, share video, or present your screen."; color: Theme.muted; font-size: 14px; horizontal-alignment: center; }
                if root.status == "disconnected": HorizontalLayout { alignment: center; PillButton { text: "Join voice"; primary: true; clicked => { root.join(); } } }
                if root.status == "connected": HorizontalLayout { alignment: center; spacing: 10px;
                    PillButton { text: root.can-speak ? (root.muted ? "Unmute" : "Mute") : "Microphone unavailable"; enabled: root.can-speak; primary: root.muted; clicked => { root.muted = !root.muted; root.mute(root.muted); } }
                    PillButton { text: root.deafened ? "Undeafen" : "Deafen"; primary: root.deafened; clicked => { root.deafened = !root.deafened; root.deafen(root.deafened); } }
                    PillButton { text: "Push to talk"; enabled: root.can-speak; press-state(pressed) => { root.push-to-talk(pressed); } }
                    PillButton { text: root.camera-enabled ? "Camera off" : root.can-stream ? "Camera on" : "Camera unavailable"; enabled: root.can-stream; primary: root.camera-enabled; clicked => { root.camera-enabled = !root.camera-enabled; root.camera(root.camera-enabled); } }
                    PillButton { text: root.screen-sharing ? "Stop sharing" : root.can-stream ? "Share screen" : "Sharing unavailable"; enabled: root.can-stream; primary: root.screen-sharing; clicked => { root.screen-sharing = !root.screen-sharing; root.screen-share(root.screen-sharing); } }
                    PillButton { text: "Leave"; destructive: true; clicked => { root.leave(); } }
                }
                if root.remote-videos.length > 0: HorizontalLayout { alignment: center; ScrollView { width: 640px; height: root.remote-videos.length == 1 ? 360px : 260px;
                    HorizontalLayout { spacing: 12px;
                        for tile[i] in root.remote-videos: Rectangle { width: root.remote-videos.length == 1 ? 640px : 420px; height: root.remote-videos.length == 1 ? 350px : 236px; border-radius: 18px; clip: true; background: #090a09; border-width: 1px; border-color: Theme.border;
                            Image { width: parent.width; height: parent.height; source: tile.frame; image-fit: contain; }
                            Rectangle { x: 12px; y: parent.height - 38px; width: tile-name.width + 20px; height: 27px; border-radius: 9px; background: #000000aa; tile-name := Text { x: 10px; text: tile.participant; color: #ffffff; font-size: 12px; font-weight: 800; vertical-alignment: center; } }
                        }
                    }
                } }
                if root.participants.length > 0: HorizontalLayout { alignment: center; Rectangle { width: 620px; height: min(280px, root.participants.length * 64px + 54px); border-radius: 18px; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                    VerticalLayout { padding: 14px; spacing: 8px;
                        Text { text: "IN THIS ROOM — \{root.participants.length}"; color: Theme.muted; font-size: 11px; font-weight: 900; }
                        ScrollView { VerticalLayout { spacing: 6px; for participant[i] in root.participants: Rectangle { height: 50px; border-radius: 11px; background: Theme.raised; HorizontalLayout { padding-left: 9px; padding-right: 10px; spacing: 7px; VerticalLayout { alignment: center; Avatar { width: 34px; height: 34px; initials: participant.initials; has-image: participant.has-avatar; source: participant.avatar; fill: Theme.accent-soft; ink: Theme.text; } } Text { text: participant.name; color: Theme.text; font-weight: 750; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } if participant.muted: Text { text: "Muted"; color: Theme.red; font-size: 11px; vertical-alignment: center; } if participant.deafened: Text { text: "Deafened"; color: Theme.muted; font-size: 11px; vertical-alignment: center; } if root.can-mute-voice: PillButton { min-width: 72px; text: participant.muted ? "Unmute" : "Mute"; clicked => { root.moderate-participant(participant.id, participant.muted ? "unmute" : "mute"); } } if root.can-deafen-voice: PillButton { min-width: 72px; text: participant.deafened ? "Undeafen" : "Deafen"; clicked => { root.moderate-participant(participant.id, participant.deafened ? "undeafen" : "deafen"); } } if root.can-move-voice: PillButton { min-width: 58px; text: "Move"; clicked => { root.move-user = participant.id; } } if root.can-move-voice: PillButton { min-width: 86px; text: "Disconnect"; destructive: true; clicked => { root.moderate-participant(participant.id, "disconnect"); } } } } } }
                    }
                } }
            }
        }
    }
    if root.move-user != "": Rectangle {
        background: #00000099;
        TouchArea { clicked => { root.move-user = ""; } }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(420px, parent.width - 48px);
            height: min(520px, parent.height - 48px);
            border-radius: 20px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea { }
            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                HorizontalLayout {
                    Text { text: "Move to voice channel"; color: Theme.text; font-size: 22px; font-weight: 900; }
                    Rectangle { horizontal-stretch: 1; }
                    IconButton { icon: "close"; label: "Cancel move"; clicked => { root.move-user = ""; } }
                }
                ScrollView {
                    VerticalLayout {
                        spacing: 6px;
                        for channel in root.channels: PillButton {
                            visible: channel.kind == "voice";
                            text: channel.name;
                            clicked => {
                                root.moderate-participant(root.move-user, "move:" + channel.id);
                                root.move-user = "";
                            }
                        }
                    }
                }
            }
        }
    }
}

component MemberRail inherits Rectangle {
    in property <[MemberItem]> members;
    callback close;
    callback profile(string);
    width: 256px; background: Theme.sidebar; border-width: 1px; border-color: Theme.border-soft;
    VerticalLayout {
        Rectangle { height: 64px; border-width: 1px; border-color: Theme.border-soft; HorizontalLayout { padding-left: 16px; padding-right: 8px; Text { text: "Members"; color: Theme.text; font-size: 14px; font-weight: 800; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } VerticalLayout { alignment: center; IconButton { width: 34px; height: 34px; icon: "close"; label: "Close members"; clicked => { root.close(); } } } } }
        ScrollView { VerticalLayout { padding: 10px; spacing: 2px; alignment: start;
            for item[i] in root.members: Rectangle {
                height: item.header ? 32px : 40px;
                border-radius: 8px;
                opacity: !item.header && !item.online ? 0.5 : 1;
                background: !item.header && member-touch.has-hover ? Theme.hover : transparent;
                if item.header: Text { x: 6px; text: item.name; color: item.role-color; font-size: 10px; font-weight: 800; letter-spacing: 0.9px; vertical-alignment: bottom; height: parent.height - 6px; overflow: elide; width: parent.width - 12px; }
                if !item.header: HorizontalLayout { padding-left: 6px; padding-right: 6px; spacing: 9px;
                    Rectangle { width: 32px; height: 32px; y: (parent.height - 32px) / 2;
                        Avatar { width: 32px; height: 32px; initials: item.initials; has-image: item.has-avatar; source: item.avatar; }
                        PresenceDot { x: 21px; y: 21px; presence: item.presence; ring: Theme.sidebar; }
                    }
                    VerticalLayout { alignment: center;
                        Text { text: item.name; color: Theme.text; font-size: 12.6px; font-weight: 650; overflow: elide; }
                        if item.status != "": Text { text: item.status; color: Theme.muted; font-size: 10.4px; overflow: elide; }
                    }
                }
                member-touch := TouchArea { enabled: !item.header; accessible-role: button; accessible-label: "View " + item.name + " profile"; clicked => { root.profile(item.id); } }
            }
        } }
    }
}

component SettingsPane inherits Rectangle {
    in property <string> current-user;
    in property <bool> has-avatar;
    in property <image> avatar;
    in property <bool> has-banner;
    in property <image> banner;
    in-out property <string> display-name;
    in-out property <string> custom-status;
    in-out property <string> presence-status: "online";
    in-out property <string> bio;
    in-out property <string> theme-name;
    in-out property <string> dm-privacy;
    in-out property <bool> desktop-notifications: true;
    in-out property <bool> developer-mode: false;
    in property <[string]> input-devices;
    in property <[string]> output-devices;
    in property <[string]> camera-devices;
    in property <[string]> screen-sources;
    in-out property <string> selected-input-device;
    in-out property <string> selected-output-device;
    in-out property <string> selected-camera-device;
    in-out property <string> selected-screen-source;
    in-out property <string> input-mode: "voice_activity";
    in-out property <string> push-to-talk-hotkey;
    in property <string> global-hotkey-status;
    in property <string> update-status;
    in property <string> security-result;
    in property <[SessionItem]> sessions;
    in-out property <string> page: "profile";
    callback close;
    callback save-profile(string, string, string);
    callback set-presence(string);
    callback upload-profile-asset(string);
    callback save-preferences(string, string, bool, bool);
    callback logout;
    callback input-device-selected(string);
    callback output-device-selected(string);
    callback camera-device-selected(string);
    callback screen-source-selected(string);
    callback refresh-media-devices;
    callback input-mode-selected(string);
    callback push-to-talk-hotkey-selected(string);
    callback check-for-updates;
    callback request-email-change(string, string);
    callback setup-mfa(string, string);
    callback enable-mfa(string);
    callback disable-mfa(string, string);
    callback refresh-sessions;
    callback revoke-session(string);
    callback switch-account;
    background: Theme.canvas;
    HorizontalLayout {
        Rectangle { width: 260px; background: Theme.sidebar; VerticalLayout { padding: 22px; spacing: 6px;
            Text { text: "USER SETTINGS"; color: Theme.muted; font-size: 11px; font-weight: 900; }
            SidebarButton { icon: "people"; label: "Profile"; selected: root.page == "profile"; clicked => { root.page = "profile"; } }
            SidebarButton { icon: "shield"; label: "Security"; selected: root.page == "security"; clicked => { root.page = "security"; root.refresh-sessions(); } }
            SidebarButton { icon: "palette"; label: "Appearance"; selected: root.page == "appearance"; clicked => { root.page = "appearance"; } }
            SidebarButton { icon: "voice"; label: "Voice & video"; selected: root.page == "voice"; clicked => { root.page = "voice"; } }
            SidebarButton { icon: "bell"; label: "Notifications"; selected: root.page == "notifications"; clicked => { root.page = "notifications"; } }
            SidebarButton { icon: "key"; label: "Keybinds"; selected: root.page == "keybinds"; clicked => { root.page = "keybinds"; } }
            SidebarButton { icon: "refresh"; label: "Updates"; selected: root.page == "updates"; clicked => { root.page = "updates"; } }
            SidebarButton { icon: "settings"; label: "Advanced"; selected: root.page == "advanced"; clicked => { root.page = "advanced"; } }
            Rectangle { vertical-stretch: 1; }
            SidebarButton { icon: "switch"; label: "Switch account"; clicked => { root.switch-account(); } }
            SidebarButton { icon: "logout"; label: "Sign out"; clicked => { root.logout(); } }
        } }
        ScrollView { horizontal-stretch: 1; VerticalLayout { alignment: start; padding-left: max(36px, (parent.width - 1040px) / 2); padding-right: max(36px, (parent.width - 1040px) / 2); padding-top: 36px; padding-bottom: 36px; spacing: 18px;
            HorizontalLayout { Text { text: "Settings"; color: Theme.text; font-size: 38px; font-weight: 900; } Rectangle { horizontal-stretch: 1; } IconButton { icon: "close"; label: "Close settings"; clicked => { root.close(); } } }
            if root.page == "profile": Text { text: "Profile"; color: Theme.text; font-size: 24px; font-weight: 800; }
            if root.page == "profile": Rectangle { height: 230px; border-radius: 20px; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                Rectangle { x: 0; y: 0; width: parent.width; height: 92px; background: @linear-gradient(90deg, Theme.green 0%, Theme.accent 100%); border-radius: 20px; clip: true; if root.has-banner: Image { x: 0; y: 0; width: parent.width; height: parent.height; source: root.banner; image-fit: cover; } }
                Rectangle { x: 28px; y: 58px; width: 82px; height: 82px; border-radius: 28px; background: Theme.green; border-width: 6px; border-color: Theme.surface; clip: true; if root.has-avatar: Image { width: parent.width; height: parent.height; source: root.avatar; image-fit: cover; } if !root.has-avatar: Text { text: root.current-user; color: #17201a; font-size: 30px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; } }
                Text { x: 30px; y: 154px; text: root.current-user; color: Theme.text; font-size: 22px; font-weight: 900; }
                HorizontalLayout { x: parent.width - 260px; y: 165px; width: 230px; spacing: 8px; PillButton { text: "Avatar"; clicked => { root.upload-profile-asset("avatar"); } } PillButton { text: "Banner"; clicked => { root.upload-profile-asset("banner"); } } }
            }
            if root.page == "profile": HorizontalLayout { spacing: 14px; VerticalLayout { Text { text: "Display name"; color: Theme.text; font-weight: 700; } LineEdit { text <=> root.display-name; placeholder-text: root.current-user; } } VerticalLayout { Text { text: "Custom status"; color: Theme.text; font-weight: 700; } LineEdit { text <=> root.custom-status; placeholder-text: "What are you up to?"; } } }
            if root.page == "profile": HorizontalLayout { spacing: 10px; alignment: start; Text { text: "Presence"; color: Theme.text; font-weight: 700; vertical-alignment: center; } ComboBox { width: 220px; model: ["online", "idle", "dnd", "invisible"]; current-value <=> root.presence-status; selected(value) => { root.set-presence(value); } } Text { text: root.presence-status == "invisible" ? "You appear offline while remaining connected." : root.presence-status == "dnd" ? "Do not disturb suppresses desktop notifications." : "Published to friends and shared guilds while Kaede is running."; color: Theme.muted; wrap: word-wrap; vertical-alignment: center; } }
            if root.page == "profile": Text { text: "About me"; color: Theme.text; font-weight: 700; }
            if root.page == "profile": TextEdit { height: 110px; text <=> root.bio; wrap: word-wrap; }
            if root.page == "profile": HorizontalLayout { Rectangle { horizontal-stretch: 1; } PillButton { text: "Save profile"; primary: true; clicked => { root.save-profile(root.display-name, root.custom-status, root.bio); } } }

            if root.page == "security": Text { text: "Security"; color: Theme.text; font-size: 24px; font-weight: 800; }
            if root.page == "security": Rectangle { min-height: 640px; border-radius: 16px; background: Theme.surface; VerticalLayout { padding: 20px; spacing: 12px;
                Text { text: "Email"; color: Theme.text; font-size: 18px; font-weight: 800; }
                new-email := LineEdit { placeholder-text: "New email address"; }
                email-password := LineEdit { input-type: InputType.password; placeholder-text: "Current password"; }
                PillButton { text: "Send email-change verification"; clicked => { root.request-email-change(new-email.text, email-password.text); } }
                Rectangle { height: 1px; background: Theme.border; }
                Text { text: "Multi-factor authentication"; color: Theme.text; font-size: 18px; font-weight: 800; }
                Text { text: "Setup returns a secret and authenticator URI once. Recovery codes are shown once after enabling; store them somewhere safe."; color: Theme.muted; wrap: word-wrap; }
                mfa-password := LineEdit { input-type: InputType.password; placeholder-text: "Current password"; }
                current-code := LineEdit { placeholder-text: "Current code when replacing MFA (optional)"; }
                HorizontalLayout { spacing: 8px; PillButton { text: "Start setup"; clicked => { root.setup-mfa(mfa-password.text, current-code.text); } } PillButton { text: "Enable with code"; clicked => { root.enable-mfa(current-code.text); } } PillButton { text: "Disable"; destructive: true; clicked => { root.disable-mfa(mfa-password.text, current-code.text); } } }
                Rectangle { height: 1px; background: Theme.border; }
                HorizontalLayout { Text { text: "Signed-in devices"; color: Theme.text; font-size: 18px; font-weight: 800; } Rectangle { horizontal-stretch: 1; } PillButton { text: "Refresh"; clicked => { root.refresh-sessions(); } } }
                Text { text: "Revoke a device you no longer recognize. The current device remains signed in unless you explicitly sign out."; color: Theme.muted; wrap: word-wrap; }
                for session in root.sessions: Rectangle { height: 62px; border-radius: 10px; background: Theme.raised; HorizontalLayout { padding: 10px; spacing: 10px; VerticalLayout { alignment: center; Text { text: session.title + (session.current ? " · This device" : ""); color: Theme.text; font-weight: 800; } Text { text: session.detail; color: Theme.muted; font-size: 11px; } } Rectangle { horizontal-stretch: 1; } if !session.current: PillButton { text: "Revoke"; destructive: true; clicked => { root.revoke-session(session.id); } } } }
                if root.security-result != "": Rectangle { min-height: 78px; border-radius: 10px; background: Theme.raised; Text { x: 12px; y: 10px; width: parent.width - 24px; height: parent.height - 20px; text: root.security-result; color: Theme.text; wrap: word-wrap; } }
            } }

            if root.page == "appearance": Text { text: "Appearance"; color: Theme.text; font-size: 24px; font-weight: 800; }
            if root.page == "appearance": Rectangle { border-radius: 16px; background: Theme.surface; VerticalLayout { padding: 20px; spacing: 12px; Text { text: "Theme"; color: Theme.text; font-weight: 800; } HorizontalLayout { PillButton { text: "Dark"; primary: root.theme-name == "dark"; clicked => { root.theme-name = "dark"; } } PillButton { text: "System"; primary: root.theme-name == "system"; clicked => { root.theme-name = "system"; } } } } }

            if root.page == "voice": Text { text: "Voice & video"; color: Theme.text; font-size: 24px; font-weight: 800; }
            if root.page == "voice": Rectangle { border-radius: 16px; background: Theme.surface; VerticalLayout { padding: 18px; spacing: 10px; HorizontalLayout { Text { text: "Devices"; color: Theme.text; font-size: 18px; font-weight: 800; } Rectangle { horizontal-stretch: 1; } PillButton { text: "Refresh devices"; clicked => { root.refresh-media-devices(); } } } Text { text: "Input device"; color: Theme.text; font-weight: 700; } ComboBox { model: root.input-devices; current-value <=> root.selected-input-device; selected(value) => { root.input-device-selected(value); } } Text { text: "Output device"; color: Theme.text; font-weight: 700; } ComboBox { model: root.output-devices; current-value <=> root.selected-output-device; selected(value) => { root.output-device-selected(value); } } Text { text: "Camera"; color: Theme.text; font-weight: 700; } ComboBox { model: root.camera-devices; current-value <=> root.selected-camera-device; selected(value) => { root.camera-device-selected(value); } } Text { text: "Screen or window to share"; color: Theme.text; font-weight: 700; } ComboBox { model: root.screen-sources; current-value <=> root.selected-screen-source; selected(value) => { root.screen-source-selected(value); } } Text { text: "Input mode"; color: Theme.text; font-weight: 700; } HorizontalLayout { CheckBox { text: "Voice activity"; checked: root.input-mode == "voice_activity"; toggled => { if (self.checked) { root.input-mode = "voice_activity"; root.input-mode-selected(root.input-mode); } } } CheckBox { text: "Push to talk"; checked: root.input-mode == "push_to_talk"; toggled => { if (self.checked) { root.input-mode = "push_to_talk"; root.input-mode-selected(root.input-mode); } } } } Text { text: "Kaede owns the selected devices through CPAL. DSP is applied before microphone PCM enters LiveKit, leaving a stable boundary for echo cancellation and noise suppression."; color: Theme.muted; wrap: word-wrap; } } }

            if root.page == "notifications": Text { text: "Notifications"; color: Theme.text; font-size: 24px; font-weight: 800; }
            if root.page == "notifications": Rectangle { border-radius: 16px; background: Theme.surface; VerticalLayout { padding: 20px; spacing: 12px; CheckBox { text: "Show desktop notifications while Kaede is running"; checked <=> root.desktop-notifications; } Text { text: "Guild-level All messages / Mentions / Nothing preferences continue to be enforced by your home instance."; color: Theme.muted; wrap: word-wrap; } } }

            if root.page == "keybinds": Text { text: "Keybinds"; color: Theme.text; font-size: 24px; font-weight: 800; }
            if root.page == "keybinds": Rectangle { border-radius: 16px; background: Theme.surface; VerticalLayout { padding: 20px; spacing: 12px; Text { text: "Global push to talk"; color: Theme.text; font-weight: 800; } Text { text: "Enter a shortcut such as Shift+Backquote or Control+Space."; color: Theme.muted; } HorizontalLayout { spacing: 10px; ptt-hotkey := LineEdit { text <=> root.push-to-talk-hotkey; placeholder-text: "Shift+Backquote"; } PillButton { text: "Apply"; primary: true; clicked => { root.push-to-talk-hotkey-selected(ptt-hotkey.text); } } } Text { text: root.global-hotkey-status; color: Theme.muted; wrap: word-wrap; } Text { text: "Global shortcuts require operating-system permission and may be unavailable on some Wayland compositors."; color: Theme.muted; wrap: word-wrap; } } }

            if root.page == "updates": Text { text: "Updates"; color: Theme.text; font-size: 24px; font-weight: 800; }
            if root.page == "updates": Rectangle { border-radius: 16px; background: Theme.surface; VerticalLayout { padding: 20px; spacing: 12px; Text { text: "Signed desktop updates"; color: Theme.text; font-weight: 800; } Text { text: "Kaede verifies the release signature and package digest before staging it. Your operating system still verifies the installed package's publisher signature."; color: Theme.muted; wrap: word-wrap; } HorizontalLayout { PillButton { text: "Check and stage update"; primary: true; clicked => { root.check-for-updates(); } } Rectangle { horizontal-stretch: 1; } } Text { text: root.update-status; color: Theme.muted; wrap: word-wrap; } } }

            if root.page == "advanced": Text { text: "Advanced"; color: Theme.text; font-size: 24px; font-weight: 800; }
            if root.page == "advanced": Rectangle { border-radius: 16px; background: Theme.surface; VerticalLayout { padding: 20px; spacing: 12px; CheckBox { text: "Developer mode"; checked <=> root.developer-mode; } Text { text: "Developer mode exposes composite IDs and protocol diagnostics. It never reveals tokens or federation signing material."; color: Theme.muted; wrap: word-wrap; } Text { text: "Direct-message privacy"; color: Theme.text; font-weight: 700; } ComboBox { model: ["friends", "guild_members", "everyone", "nobody"]; } } }
            if root.page != "profile" && root.page != "security" && root.page != "voice" && root.page != "keybinds" && root.page != "updates": HorizontalLayout { Rectangle { horizontal-stretch: 1; } PillButton { text: "Save preferences"; primary: true; clicked => { root.save-preferences(root.theme-name, root.dm-privacy, root.desktop-notifications, root.developer-mode); } } }
        } }
    }
}

component GuildSettingsPane inherits Rectangle {
    in property <string> guild-name;
    in property <bool> has-guild-icon;
    in property <image> guild-icon;
    in property <bool> has-guild-banner;
    in property <image> guild-banner;
    in-out property <string> guild-description;
    in-out property <string> guild-history-policy;
    in-out property <string> page: "overview";
    in property <[RoleItem]> roles;
    in property <[PermissionItem]> permissions;
    in property <[AdminMemberItem]> admin-members;
    in-out property <int> member-page: 0;
    private property <int> member-pages: max(1, (root.admin-members.length + 49) / 50);
    in property <[AdminChannelItem]> admin-channels;
    in property <[OverwriteItem]> overwrites;
    in property <[OverwritePermissionItem]> overwrite-permissions;
    in property <[AdminRecordItem]> audit-records;
    in property <[AdminRecordItem]> webhook-records;
    in property <[AdminRecordItem]> invite-records;
    in property <[AdminRecordItem]> ban-records;
    in property <[AdminRecordItem]> instance-ban-records;
    in property <[AdminRecordItem]> emoji-records;
    in-out property <string> selected-role;
    in-out property <string> selected-role-name;
    in-out property <string> selected-role-color;
    in-out property <bool> selected-role-hoist;
    in-out property <bool> selected-role-mentionable;
    in property <bool> can-manage-guild;
    in property <bool> can-manage-channels;
    in property <bool> can-manage-roles;
    in property <bool> can-kick;
    in property <bool> can-ban;
    in property <bool> can-timeout;
    in property <bool> can-invite;
    in property <bool> is-owner;
    in-out property <string> moderation-user;
    in-out property <string> moderation-name;
    in-out property <string> moderation-action;
    in-out property <string> selected-admin-channel;
    in-out property <string> selected-admin-channel-name;
    in-out property <string> selected-admin-channel-topic;
    in-out property <string> selected-admin-channel-parent;
    in-out property <int> selected-admin-channel-slow-mode;
    in-out property <bool> selected-admin-channel-synced;
    in-out property <string> selected-overwrite;
    in-out property <string> selected-overwrite-kind;
    callback close;
    callback role-selected(string);
    callback create-role(string);
    callback save-role(string, string, string, bool, bool);
    callback delete-role(string);
    callback toggle-role-permission(string, string, bool);
    callback create-channel(string, string);
    callback select-channel(string);
    callback save-channel(string, string, string, string, int);
    callback delete-channel(string);
    callback sync-channel(string);
    callback select-overwrite(string, string);
    callback set-overwrite-permission(string, string, string, string);
    callback delete-overwrite(string, string);
    callback move-channel(string, int);
    callback moderate-member(string, string, string, string);
    callback move-role(string, int);
    callback create-invite;
    callback copy-invite(string);
    callback revoke-invite(string);
    callback upload-guild-asset(string);
    callback upload-emoji(string);
    callback delete-emoji(string);
    callback create-webhook(string, string);
    callback update-webhook(string, string);
    callback delete-webhook(string);
    callback rotate-webhook(string);
    callback unban-member(string);
    callback ban-instance(string, string, string);
    callback unban-instance(string);
    callback set-notification-level(string);
    callback save-guild(string, string, string);
    callback leave-guild;
    callback transfer-guild(string);
    callback delete-guild;
    background: Theme.canvas;
    HorizontalLayout {
        Rectangle { width: 260px; background: Theme.sidebar; VerticalLayout { padding: 22px; spacing: 5px;
            Text { text: root.guild-name; color: Theme.muted; font-size: 11px; font-weight: 900; }
            SidebarButton { icon: "home"; label: "Overview"; selected: root.page == "overview"; clicked => { root.page = "overview"; } }
            SidebarButton { icon: "channels"; label: "Channels"; selected: root.page == "channels"; clicked => { root.page = "channels"; } }
            SidebarButton { icon: "roles"; label: "Roles"; selected: root.page == "roles"; clicked => { root.page = "roles"; } }
            SidebarButton { icon: "people"; label: "Members"; selected: root.page == "members"; clicked => { root.page = "members"; } }
            SidebarButton { icon: "ban"; label: "Bans & instances"; selected: root.page == "bans"; clicked => { root.page = "bans"; } }
            SidebarButton { icon: "plus"; label: "Invites"; selected: root.page == "invites"; clicked => { root.page = "invites"; } }
            SidebarButton { icon: "smile"; label: "Emoji"; selected: root.page == "emoji"; clicked => { root.page = "emoji"; } }
            SidebarButton { icon: "link"; label: "Webhooks"; selected: root.page == "webhooks"; clicked => { root.page = "webhooks"; } }
            SidebarButton { icon: "list"; label: "Audit log"; selected: root.page == "audit"; clicked => { root.page = "audit"; } }
            Rectangle { vertical-stretch: 1; }
            SidebarButton { icon: "logout"; label: "Leave guild"; clicked => { root.leave-guild(); } }
            if root.is-owner: SidebarButton { icon: "ban"; label: "Delete guild"; clicked => { root.delete-guild(); } }
        } }
        Rectangle { horizontal-stretch: 1; background: Theme.canvas;
            Rectangle {
                x: max(36px, (parent.width - 1180px) / 2);
                width: min(1180px, parent.width - 72px);
                height: parent.height;
            VerticalLayout { padding-top: 30px; padding-bottom: 30px; spacing: 17px;
                HorizontalLayout { Text { text: root.page == "roles" ? "Roles" : root.page == "members" ? "Members" : root.page == "bans" ? "Bans & instances" : root.page == "channels" ? "Channels" : root.page == "invites" ? "Invites" : root.page == "emoji" ? "Emoji" : root.page == "webhooks" ? "Webhooks" : root.page == "audit" ? "Audit log" : "Guild overview"; color: Theme.text; font-size: 32px; font-weight: 900; } Rectangle { horizontal-stretch: 1; } IconButton { icon: "close"; label: "Close guild settings"; clicked => { root.close(); } } }
                if root.page == "overview": ScrollView { VerticalLayout { alignment: start; spacing: 14px;
                    Rectangle { border-radius: 18px; background: Theme.surface; border-width: 1px; border-color: Theme.border; VerticalLayout { padding: 20px; spacing: 9px; Text { text: "Guild profile"; color: Theme.text; font-size: 20px; font-weight: 900; }
                        Rectangle { height: 92px; border-radius: 14px; background: @linear-gradient(90deg, Theme.accent-soft 0%, Theme.green 100%); clip: true;
                            if root.has-guild-banner: Image { width: parent.width; height: parent.height; source: root.guild-banner; image-fit: cover; }
                            Rectangle { x: 16px; y: 16px; width: 60px; height: 60px; border-radius: 18px; background: Theme.surface; border-width: 4px; border-color: Theme.surface; clip: true;
                                if root.has-guild-icon: Image { width: parent.width; height: parent.height; source: root.guild-icon; image-fit: cover; }
                                if !root.has-guild-icon: Text { text: "#"; color: Theme.text; font-size: 22px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        HorizontalLayout { spacing: 8px; PillButton { text: "Change icon"; enabled: root.can-manage-guild; clicked => { root.upload-guild-asset("icon"); } } PillButton { text: "Change banner"; enabled: root.can-manage-guild; clicked => { root.upload-guild-asset("banner"); } } } Text { text: "Name"; color: Theme.muted; } guild-name-edit := LineEdit { text: root.guild-name; enabled: root.can-manage-guild; } Text { text: "Description"; color: Theme.muted; } TextEdit { height: 82px; text <=> root.guild-description; enabled: root.can-manage-guild; wrap: word-wrap; } Text { text: "Federated message history"; color: Theme.muted; } ComboBox { model: ["disabled", "full_retained"]; current-value <=> root.guild-history-policy; enabled: root.can-manage-guild; } HorizontalLayout { Rectangle { horizontal-stretch: 1; } PillButton { text: "Save guild"; primary: true; clicked => { root.save-guild(guild-name-edit.text, root.guild-description, root.guild-history-policy); } } } } }
                    Rectangle { border-radius: 18px; background: Theme.surface; border-width: 1px; border-color: Theme.border; VerticalLayout { padding: 20px; spacing: 10px; Text { text: "Notifications"; color: Theme.text; font-size: 18px; font-weight: 900; } Text { text: "Notification level"; color: Theme.muted; } HorizontalLayout { spacing: 8px; PillButton { text: "All messages"; clicked => { root.set-notification-level("all"); } } PillButton { text: "Mentions"; clicked => { root.set-notification-level("mentions"); } } PillButton { text: "Nothing"; clicked => { root.set-notification-level("none"); } } } } }
                    Rectangle { border-radius: 18px; background: Theme.surface; VerticalLayout { padding: 20px; spacing: 10px; Text { text: "Federation and ownership"; color: Theme.text; font-size: 18px; font-weight: 800; } Text { text: "Guild identity, permissions, media, history policy, and moderation changes are published by the guild's home instance. Remote replicas are untrusted caches and deletion is best effort."; color: Theme.muted; wrap: word-wrap; } if root.is-owner: Text { text: "Transfer ownership to a local member"; color: Theme.text; font-weight: 800; } if root.is-owner: HorizontalLayout { transfer-target := LineEdit { placeholder-text: "user-id@this-instance"; } PillButton { text: "Transfer"; destructive: true; clicked => { if (transfer-target.text != "") { root.transfer-guild(transfer-target.text); } } } } } }
                } }
                if root.page == "channels": HorizontalLayout {
                    spacing: 14px;
                    Rectangle {
                        width: 270px; background: Theme.surface; border-radius: 15px;
                        VerticalLayout {
                            padding: 12px; spacing: 7px;
                            Text { text: "CHANNELS & CATEGORIES"; color: Theme.muted; font-size: 10px; font-weight: 900; }
                            ScrollView { vertical-stretch: 1; VerticalLayout { spacing: 4px;
                                for channel[i] in root.admin-channels: Rectangle {
                                    height: 44px; border-radius: 9px;
                                    background: root.selected-admin-channel == channel.id ? Theme.accent-soft : channel-touch.has-hover ? Theme.raised : transparent;
                                    HorizontalLayout { padding-left: 9px; spacing: 7px; if channel.kind == "voice": VectorIcon { width: 17px; height: 17px; y: (parent.height - 17px) / 2; kind: "voice"; icon-color: Theme.muted; } if channel.kind != "voice": Text { width: 17px; text: channel.kind == "category" ? "▾" : "#"; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; } Text { text: channel.name; color: Theme.text; font-weight: 700; overflow: elide; vertical-alignment: center; } }
                                    channel-touch := TouchArea { clicked => { root.selected-admin-channel = channel.id; root.select-channel(channel.id); } }
                                }
                            } }
                            Text { text: "Create a channel"; color: Theme.text; font-weight: 800; }
                            channel-name := LineEdit { placeholder-text: "new-channel"; enabled: root.can-manage-channels; }
                            HorizontalLayout { spacing: 5px;
                                PillButton { min-width: 60px; height: 36px; text: "Text"; primary: true; clicked => { if (channel-name.text != "") { root.create-channel(channel-name.text, "text"); channel-name.text = ""; } } }
                                PillButton { min-width: 60px; height: 36px; text: "Voice"; clicked => { if (channel-name.text != "") { root.create-channel(channel-name.text, "voice"); channel-name.text = ""; } } }
                                PillButton { min-width: 78px; height: 36px; text: "Category"; clicked => { if (channel-name.text != "") { root.create-channel(channel-name.text, "category"); channel-name.text = ""; } } }
                            }
                        }
                    }
                    ScrollView {
                        horizontal-stretch: 1;
                        if root.selected-admin-channel == "": Text { text: "Choose a channel to edit it."; color: Theme.muted; }
                        if root.selected-admin-channel != "": VerticalLayout {
                            spacing: 12px;
                            Text { text: "Channel overview"; color: Theme.text; font-size: 20px; font-weight: 900; }
                            Text { text: "Name"; color: Theme.muted; }
                            LineEdit { text <=> root.selected-admin-channel-name; enabled: root.can-manage-channels; }
                            Text { text: "Topic"; color: Theme.muted; }
                            TextEdit { height: 90px; text <=> root.selected-admin-channel-topic; enabled: root.can-manage-channels; wrap: word-wrap; }
                            Text { text: "Slow mode (seconds)"; color: Theme.muted; }
                            slow-mode := LineEdit { text: "\{root.selected-admin-channel-slow-mode}"; enabled: root.can-manage-channels; }
                            Text { text: root.selected-admin-channel-synced ? "Permissions are synced with the category." : "Permissions are independent from the category."; color: root.selected-admin-channel-synced ? Theme.green : Theme.muted; wrap: word-wrap; }
                            HorizontalLayout { spacing: 8px;
                                PillButton { text: "Save channel"; primary: true; clicked => { root.save-channel(root.selected-admin-channel, root.selected-admin-channel-name, root.selected-admin-channel-topic, root.selected-admin-channel-parent, slow-mode.text.to-float()); } }
                                if !root.selected-admin-channel-synced: PillButton { text: "Sync permissions"; clicked => { root.sync-channel(root.selected-admin-channel); } }
                                PillButton { text: "Delete channel"; destructive: true; clicked => { root.delete-channel(root.selected-admin-channel); } }
                            }
                            Text { text: "Channel permissions"; color: Theme.text; font-size: 20px; font-weight: 900; }
                            HorizontalLayout {
                                spacing: 12px;
                                Rectangle { width: 210px; min-height: 320px; border-radius: 12px; background: Theme.raised;
                                    ScrollView { VerticalLayout { padding: 8px; spacing: 4px;
                                        for target in root.overwrites: SidebarButton { icon: target.kind == "role" ? "●" : "@"; label: target.label; selected: target.id == root.selected-overwrite && target.kind == root.selected-overwrite-kind; clicked => { root.select-overwrite(target.id, target.kind); } }
                                    } }
                                }
                                Rectangle { horizontal-stretch: 1; min-height: 320px; border-radius: 12px; background: Theme.surface;
                                    if root.selected-overwrite == "": Text { text: "Choose a role or member."; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                                    if root.selected-overwrite != "": ScrollView { VerticalLayout { padding: 10px; spacing: 6px;
                                        for permission in root.overwrite-permissions: Rectangle { height: 68px; border-width: 1px; border-color: Theme.border;
                                            HorizontalLayout { padding: 8px;
                                                VerticalLayout { Text { text: permission.label; color: Theme.text; font-weight: 800; } Text { text: permission.description; color: Theme.muted; font-size: 10px; wrap: word-wrap; } }
                                                Rectangle { horizontal-stretch: 1; }
                                                PillButton { text: "Deny"; destructive: permission.state == "deny"; clicked => { root.set-overwrite-permission(root.selected-overwrite, root.selected-overwrite-kind, permission.bit, "deny"); } }
                                                PillButton { text: "Inherit"; primary: permission.state == "inherit"; clicked => { root.set-overwrite-permission(root.selected-overwrite, root.selected-overwrite-kind, permission.bit, "inherit"); } }
                                                PillButton { text: "Allow"; primary: permission.state == "allow"; clicked => { root.set-overwrite-permission(root.selected-overwrite, root.selected-overwrite-kind, permission.bit, "allow"); } }
                                            }
                                        }
                                        PillButton { text: "Reset overwrite"; destructive: true; clicked => { root.delete-overwrite(root.selected-overwrite, root.selected-overwrite-kind); } }
                                    } }
                                }
                            }
                        }
                    }
                }
                if root.page == "roles": HorizontalLayout { spacing: 14px;
                    Rectangle { width: 280px; background: Theme.surface; border-radius: 15px; VerticalLayout { padding: 12px; spacing: 5px; HorizontalLayout { Text { text: "ROLE ORDER"; color: Theme.muted; font-size: 10px; font-weight: 900; } Rectangle { horizontal-stretch: 1; } IconButton { icon: "plus"; label: "Create role"; clicked => { if (root.can-manage-roles) { root.create-role("new role"); } } } } ScrollView { vertical-stretch: 1; VerticalLayout { spacing: 4px; for role[i] in root.roles: Rectangle { height: 44px; border-radius: 9px; background: root.selected-role == role.id ? Theme.accent-soft : role-touch.has-hover ? Theme.raised : transparent; HorizontalLayout { padding-left: 10px; padding-right: 5px; spacing: 7px; Text { text: "●"; color: role.color; vertical-alignment: center; } Text { text: role.name; color: Theme.text; font-weight: 700; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } if role.editable && root.can-manage-roles: IconButton { width: 30px; height: 30px; icon: "arrow-up"; label: "Move role up"; clicked => { root.move-role(role.id, 1); } } if role.editable && root.can-manage-roles: IconButton { width: 30px; height: 30px; icon: "arrow-down"; label: "Move role down"; clicked => { root.move-role(role.id, -1); } } } role-touch := TouchArea { clicked => { root.selected-role = role.id; root.role-selected(role.id); } } } } } } }
                    ScrollView { horizontal-stretch: 1; if root.selected-role == "": Text { text: "Choose a role to edit its display and permissions."; color: Theme.muted; } if root.selected-role != "": VerticalLayout { spacing: 13px; Text { text: "Role display"; color: Theme.text; font-size: 20px; font-weight: 900; } LineEdit { text <=> root.selected-role-name; enabled: root.can-manage-roles; } Text { text: "Role color (hex)"; color: Theme.muted; } LineEdit { text <=> root.selected-role-color; placeholder-text: "#99aab5"; enabled: root.can-manage-roles; } CheckBox { text: "Display members separately"; checked <=> root.selected-role-hoist; enabled: root.can-manage-roles; } CheckBox { text: "Allow anyone to mention this role"; checked <=> root.selected-role-mentionable; enabled: root.can-manage-roles; } HorizontalLayout { PillButton { text: "Save role"; primary: true; clicked => { root.save-role(root.selected-role, root.selected-role-name, root.selected-role-color, root.selected-role-hoist, root.selected-role-mentionable); } } PillButton { text: "Delete role"; destructive: true; clicked => { root.delete-role(root.selected-role); } } } Text { text: "PERMISSIONS"; color: Theme.muted; font-size: 11px; font-weight: 900; } for permission[i] in root.permissions: Rectangle { min-height: 70px; border-radius: 11px; background: Theme.surface; HorizontalLayout { padding: 13px; spacing: 12px; VerticalLayout { Text { text: permission.label; color: permission.danger == "critical" ? Theme.red : Theme.text; font-weight: 800; } Text { text: permission.description; color: Theme.muted; font-size: 11px; wrap: word-wrap; } } CheckBox { checked: permission.checked; enabled: root.can-manage-roles; toggled => { root.toggle-role-permission(root.selected-role, permission.bit, self.checked); } } } } } }
                }
                if root.page == "members": VerticalLayout { spacing: 8px; Text { text: "Actions are constrained by role hierarchy and are rechecked by the server."; color: Theme.muted; } ListView { vertical-stretch: 1; for member[i] in root.admin-members: Rectangle { visible: i >= root.member-page * 50 && i < (root.member-page + 1) * 50; height: self.visible ? 72px : 0px; border-radius: 12px; background: Theme.surface; HorizontalLayout { padding: 11px; spacing: 10px; VerticalLayout { alignment: center; Avatar { width: 42px; height: 42px; initials: member.initials; has-image: member.has-avatar; source: member.avatar; } } VerticalLayout { alignment: center; Text { text: member.name; color: Theme.text; font-weight: 800; } Text { text: member.handle + (member.roles == "" ? "" : " · " + member.roles); color: Theme.muted; font-size: 10px; } } Rectangle { horizontal-stretch: 1; } if member.manageable && root.can-timeout: PillButton { text: member.timed-out ? "Remove timeout" : "Timeout"; clicked => { root.moderation-user = member.id; root.moderation-name = member.name; root.moderation-action = member.timed-out ? "untimeout" : "timeout"; } } if member.manageable && root.can-kick: PillButton { text: "Kick"; clicked => { root.moderation-user = member.id; root.moderation-name = member.name; root.moderation-action = "kick"; } } if member.manageable && root.can-ban: PillButton { text: "Ban"; destructive: true; clicked => { root.moderation-user = member.id; root.moderation-name = member.name; root.moderation-action = "ban"; } } } } } HorizontalLayout { PillButton { text: "Previous"; enabled: root.member-page > 0; clicked => { if (root.member-page > 0) { root.member-page = root.member-page - 1; } } } Rectangle { horizontal-stretch: 1; } Text { text: "Page " + (root.member-page + 1) + " of " + root.member-pages; color: Theme.muted; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } PillButton { text: "Next"; enabled: root.member-page + 1 < root.member-pages; clicked => { if (root.member-page + 1 < root.member-pages) { root.member-page = root.member-page + 1; } } } } }
                if root.page == "bans": ScrollView { VerticalLayout { alignment: start; spacing: 12px; Text { text: "Member bans"; color: Theme.text; font-size: 20px; font-weight: 900; } for item[i] in root.ban-records: Rectangle { height: 62px; border-radius: 12px; background: Theme.surface; HorizontalLayout { padding: 11px; VerticalLayout { Text { text: item.title; color: Theme.text; font-weight: 800; } Text { text: item.subtitle; color: Theme.muted; font-size: 11px; } } Rectangle { horizontal-stretch: 1; } PillButton { text: "Unban"; clicked => { root.unban-member(item.id); } } } } Text { text: "Blocked federated instances"; color: Theme.text; font-size: 20px; font-weight: 900; } Text { text: "Blocking an instance removes its members and prevents them from rejoining. Remote deletion is best effort and a malicious peer may retain prior data."; color: Theme.red; wrap: word-wrap; } HorizontalLayout { block-domain := LineEdit { placeholder-text: "blocked.example"; } block-duration := ComboBox { model: ["Permanent", "1 day", "7 days", "30 days"]; current-value: "Permanent"; } PillButton { text: "Block instance"; destructive: true; clicked => { if (block-domain.text != "") { root.ban-instance(block-domain.text, block-duration.current-value, ""); } } } } for item[i] in root.instance-ban-records: Rectangle { height: 62px; border-radius: 12px; background: Theme.surface; HorizontalLayout { padding: 11px; VerticalLayout { Text { text: item.title; color: Theme.text; font-weight: 800; } Text { text: item.subtitle; color: Theme.muted; font-size: 11px; } } Rectangle { horizontal-stretch: 1; } PillButton { text: "Unblock"; clicked => { root.unban-instance(item.id); } } } } } }
                if root.page == "invites": ScrollView { VerticalLayout { alignment: start; spacing: 13px; Text { text: "Create an invitation for the currently selected channel. Federated invite acceptance remains brokered by each user's home instance."; color: Theme.muted; wrap: word-wrap; } PillButton { text: "Create invite"; primary: true; clicked => { if (root.can-invite) { root.create-invite(); } } } Text { text: "ACTIVE INVITES"; color: Theme.muted; font-size: 11px; font-weight: 900; } for item[i] in root.invite-records: Rectangle { height: 62px; border-radius: 12px; background: Theme.surface; HorizontalLayout { padding: 10px; VerticalLayout { Text { text: item.title; color: Theme.text; font-weight: 800; } Text { text: item.subtitle; color: Theme.muted; font-size: 11px; } } Rectangle { horizontal-stretch: 1; } PillButton { text: "Copy"; clicked => { root.copy-invite(item.id); } } PillButton { text: "Revoke"; destructive: true; clicked => { root.revoke-invite(item.id); } } } } } }
                if root.page == "emoji": ScrollView { VerticalLayout { alignment: start; spacing: 10px; Text { text: "Custom emoji"; color: Theme.text; font-size: 20px; font-weight: 800; } Text { text: "Upload an image, GIF, or WebP. External use is controlled by the Use external emojis permission."; color: Theme.muted; wrap: word-wrap; } HorizontalLayout { emoji-name := LineEdit { placeholder-text: "emoji_name"; } PillButton { text: "Choose image"; primary: true; clicked => { if (emoji-name.text != "") { root.upload-emoji(emoji-name.text); } } } } for item[i] in root.emoji-records: Rectangle { height: 58px; border-radius: 12px; background: Theme.surface; HorizontalLayout { padding: 10px; spacing: 8px; Text { text: item.title; color: Theme.text; font-weight: 800; vertical-alignment: center; } Text { text: item.subtitle; color: Theme.muted; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } PillButton { text: "Delete"; destructive: true; clicked => { root.delete-emoji(item.id); } } } } } }
                if root.page == "webhooks": ScrollView { VerticalLayout { alignment: start; spacing: 10px; Text { text: "Webhooks"; color: Theme.text; font-size: 20px; font-weight: 800; } Text { text: "Tokens are displayed only when created or rotated and are never written to logs or desktop preferences."; color: Theme.muted; wrap: word-wrap; } HorizontalLayout { webhook-name := LineEdit { placeholder-text: "Webhook name"; } webhook-channel := LineEdit { placeholder-text: "channel-id@domain"; } PillButton { text: "Create"; primary: true; clicked => { if (webhook-name.text != "" && webhook-channel.text != "") { root.create-webhook(webhook-channel.text, webhook-name.text); } } } } for item[i] in root.webhook-records: Rectangle { height: 68px; border-radius: 12px; background: Theme.surface; HorizontalLayout { padding: 10px; spacing: 8px; VerticalLayout { webhook-edit := LineEdit { text: item.title; } Text { text: item.subtitle; color: Theme.muted; font-size: 11px; } } Rectangle { horizontal-stretch: 1; } PillButton { text: "Save"; clicked => { if (webhook-edit.text != "") { root.update-webhook(item.id, webhook-edit.text); } } } PillButton { text: "Rotate token"; clicked => { root.rotate-webhook(item.id); } } PillButton { text: "Delete"; destructive: true; clicked => { root.delete-webhook(item.id); } } } } } }
                if root.page == "audit": ScrollView { VerticalLayout { alignment: start; spacing: 8px; Text { text: "Moderation, permissions, role, channel, invite, webhook, and federation policy actions are recorded by the guild home instance."; color: Theme.muted; wrap: word-wrap; } for item[i] in root.audit-records: Rectangle { min-height: 64px; border-radius: 12px; background: Theme.surface; VerticalLayout { padding: 11px; Text { text: item.title; color: Theme.text; font-weight: 800; } Text { text: item.subtitle; color: Theme.muted; font-size: 11px; wrap: word-wrap; } } } } }
            }
            }
        }
    }
    if root.moderation-action != "": Rectangle { background: #00000099; TouchArea { clicked => { root.moderation-action = ""; } } Rectangle { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: min(520px, parent.width - 48px); height: root.moderation-action == "timeout" ? 390px : 320px; border-radius: 22px; background: Theme.surface; border-width: 1px; border-color: Theme.border; TouchArea { } VerticalLayout { padding: 24px; spacing: 13px; Text { text: root.moderation-action == "untimeout" ? "Remove timeout" : root.moderation-action == "timeout" ? "Timeout member" : root.moderation-action == "kick" ? "Kick member" : "Ban member"; color: Theme.text; font-size: 25px; font-weight: 900; } Text { text: root.moderation-name; color: Theme.muted; } duration := ComboBox { visible: root.moderation-action == "timeout" || root.moderation-action == "ban"; model: root.moderation-action == "timeout" ? ["10 minutes", "1 hour", "1 day", "7 days", "28 days", "Permanent"] : ["Permanent", "1 day", "7 days", "30 days"]; current-value: root.moderation-action == "timeout" ? "1 hour" : "Permanent"; } reason := TextEdit { height: 90px; placeholder-text: "Reason (optional)"; wrap: word-wrap; } Text { text: "This action is checked against your permissions and role hierarchy by the guild home instance."; color: Theme.muted; font-size: 11px; wrap: word-wrap; } HorizontalLayout { Rectangle { horizontal-stretch: 1; } PillButton { text: "Cancel"; clicked => { root.moderation-action = ""; } } PillButton { text: root.moderation-action == "untimeout" ? "Remove" : "Apply"; destructive: root.moderation-action == "kick" || root.moderation-action == "ban"; primary: root.moderation-action == "timeout"; clicked => { root.moderate-member(root.moderation-user, root.moderation-action, duration.current-value, reason.text); root.moderation-action = ""; } } } } } }
}

// All modal surfaces are controlled by AppWindow.active-overlay. This keeps
// profile cards, menus, settings and pickers mutually exclusive.
component ProfileOverlay inherits Rectangle {
    in property <string> user-id;
    in property <string> name;
    in property <string> handle;
    in property <string> status;
    in property <string> bio;
    in property <string> relationship;
    in property <bool> has-avatar;
    in property <image> avatar;
    in property <bool> has-banner;
    in property <image> banner;
    in property <[ProfileRoleItem]> roles;
    callback close;
    callback message(string);
    callback relationship-action(string, string);
    callback block(string, bool);
    callback role(string, string, bool);
    background: #00000066;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: min(360px, parent.width - 48px); height: min(560px, parent.height - 48px); border-radius: 16px;
        background: Theme.raised; border-width: 1px; border-color: Theme.border;
        drop-shadow-blur: 48px; drop-shadow-color: #00000073; drop-shadow-offset-y: 16px;
        clip: true;
        TouchArea { }
        Rectangle { x: 0; y: 0; width: parent.width; height: 106px; background: @linear-gradient(120deg, Theme.accent 0%, Theme.green 100%); clip: true; if root.has-banner: Image { x: 0; y: 0; width: parent.width; height: parent.height; source: root.banner; image-fit: cover; } }
        Rectangle { x: 18px; y: 63px; width: 78px; height: 78px; border-radius: 39px; background: Theme.green-soft; border-width: 5px; border-color: Theme.raised; clip: true; if root.has-avatar: Image { width: parent.width; height: parent.height; source: root.avatar; image-fit: cover; } if !root.has-avatar: Text { text: "@"; color: Theme.green; font-size: 30px; font-weight: 900; horizontal-alignment: center; vertical-alignment: center; } }
        IconButton { x: parent.width - 48px; y: 12px; width: 34px; height: 34px; icon: "close"; label: "Close profile"; clicked => { root.close(); } }
        VerticalLayout { x: 18px; y: 152px; width: parent.width - 36px; height: parent.height - 168px; spacing: 8px;
            Text { text: root.name; color: Theme.text; font-size: 20px; font-weight: 850; }
            Text { text: root.handle; color: Theme.muted; font-size: 12px; }
            if root.status != "": Rectangle { height: 30px; border-radius: 15px; background: Theme.subtle; border-width: 1px; border-color: Theme.border-soft; HorizontalLayout { padding-left: 10px; padding-right: 12px; spacing: 7px; VerticalLayout { alignment: center; PresenceDot { ring: Theme.subtle; } } Text { text: root.status; color: Theme.text-soft; font-size: 11.5px; vertical-alignment: center; overflow: elide; } } }
            if root.bio != "": Text { text: "ABOUT ME"; color: Theme.muted; font-size: 9px; font-weight: 800; letter-spacing: 1.2px; }
            if root.bio != "": Text { text: root.bio; color: Theme.text-soft; font-size: 12px; wrap: word-wrap; }
            Text { text: "ROLES"; color: Theme.muted; font-size: 9px; font-weight: 800; letter-spacing: 1.2px; }
            ScrollView { vertical-stretch: 1; VerticalLayout { spacing: 4px; for role in root.roles: Rectangle { height: 34px; border-radius: 9px; background: Theme.subtle; border-width: 1px; border-color: Theme.border-soft; HorizontalLayout { padding-left: 10px; padding-right: 6px; spacing: 8px; VerticalLayout { alignment: center; Rectangle { width: 10px; height: 10px; border-radius: 5px; background: role.color; } } Text { text: role.name; color: Theme.text-soft; font-size: 12px; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } if role.editable: PillButton { height: 26px; min-width: 64px; text: role.assigned ? "Remove" : "Add"; destructive: role.assigned; clicked => { root.role(root.user-id, role.id, !role.assigned); } } } } } }
            HorizontalLayout { spacing: 8px;
                if root.relationship != "self": PillButton { height: 36px; text: "Message"; primary: true; clicked => { root.message(root.user-id); } }
                if root.relationship != "outgoing" && root.relationship != "self": PillButton { height: 36px; text: root.relationship == "friend" ? "Remove friend" : root.relationship == "incoming" ? "Accept friend" : root.relationship == "blocked" ? "Unblock" : "Add friend"; clicked => { root.relationship-action(root.user-id, root.relationship); } }
                if root.relationship != "self": PillButton { height: 36px; text: root.relationship == "blocked" ? "Unblock" : "Block"; destructive: root.relationship != "blocked"; clicked => { root.block(root.user-id, root.relationship != "blocked"); } }
            }
        }
    }
}

component NewDirectMessageOverlay inherits Rectangle {
    in property <[FriendItem]> friends;
    callback close;
    callback open(string);
    background: #00000066;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: min(540px, parent.width - 48px); height: min(620px, parent.height - 60px);
        border-radius: 22px; background: Theme.raised; border-width: 1px; border-color: Theme.border;
        drop-shadow-blur: 48px; drop-shadow-color: #00000073; drop-shadow-offset-y: 16px;
        TouchArea { }
        VerticalLayout { padding: 24px; spacing: 13px;
            HorizontalLayout { Text { text: "New message"; color: Theme.text; font-size: 26px; font-weight: 900; } Rectangle { horizontal-stretch: 1; } IconButton { icon: "close"; label: "Close"; clicked => { root.close(); } } }
            Text { text: "Type a federated username or choose a friend."; color: Theme.muted; font-size: 13px; }
            handle := FormField { placeholder: "@friend@example.net"; accepted => { if (self.text != "") { root.open(self.text); } } }
            PillButton { text: "Start conversation"; primary: true; clicked => { if (handle.text != "") { root.open(handle.text); } } }
            Text { text: "FRIENDS"; color: Theme.muted; font-size: 11px; font-weight: 900; letter-spacing: 1.4px; }
            ScrollView { vertical-stretch: 1; VerticalLayout { spacing: 7px;
                for item[i] in root.friends: Rectangle {
                    visible: item.relationship == "friend"; height: item.relationship == "friend" ? 58px : 0px; border-radius: 12px; background: row-touch.has-hover ? Theme.hover : transparent;
                    HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 10px; VerticalLayout { alignment: center; Avatar { width: 38px; height: 38px; initials: item.initials; has-image: item.has-avatar; source: item.avatar; } } VerticalLayout { alignment: center; Text { text: item.name; color: Theme.text; font-weight: 800; } Text { text: item.handle; color: Theme.muted; font-size: 10px; } } }
                    row-touch := TouchArea { accessible-role: button; accessible-label: "Message " + item.name; clicked => { root.open(item.id); } }
                }
            } }
        }
    }
}

export component AppWindow inherits Window {
    title: "Kaede Chat";
    preferred-width: 1440px; preferred-height: 900px; min-width: 980px; min-height: 640px;
    background: Theme.canvas;
    default-font-family: "Inter";
    in-out property <bool> authenticated: false;
    in-out property <bool> mfa-required: false;
    in-out property <string> auth-page: "login";
    in-out property <bool> busy: false;
    in-out property <string> error-message;
    in-out property <string> realtime-status: "connecting";
    in-out property <string> auth-notice;
    in-out property <string> current-user: "Kaede";
    in-out property <string> current-user-initials: "K";
    in-out property <string> guild-title: "Kaede Community";
    in-out property <string> home-page: "overview";
    in-out property <string> selected-guild;
    in-out property <string> selected-channel;
    in-out property <string> selected-channel-name;
    in-out property <string> selected-channel-kind;
    in-out property <string> selected-channel-topic;
    in-out property <bool> channel-loading: false;
    in-out property <string> draft;
    in-out property <string> typing-indicator;
    in-out property <bool> members-visible: true;
    in-out property <string> active-overlay;
    in-out property <int> home-mentions: 0;
    in-out property <string> new-marker-message;
    in-out property <bool> history-loading: false;
    in-out property <bool> history-complete: false;
    in-out property <bool> history-truncated: false;
    in-out property <bool> history-remote-available: false;
    in-out property <string> history-page-warning;
    in-out property <bool> guild-sync-paused: false;
    in-out property <string> guild-sync-paused-title;
    in-out property <string> guild-sync-paused-message;
    in-out property <string> guild-history-warning;
    // Keep the signed-in account editor independent from the transient
    // profile viewer. Realtime refreshes must not replace an open remote
    // profile, and viewing somebody else must not alter the settings form.
    in-out property <string> current-profile-name;
    in-out property <string> current-profile-handle;
    in-out property <string> current-profile-status;
    in-out property <string> presence-status: "online";
    in-out property <string> current-profile-bio;
    in-out property <bool> current-profile-has-avatar: false;
    in-out property <image> current-profile-avatar;
    in-out property <bool> current-profile-has-banner: false;
    in-out property <image> current-profile-banner;
    in-out property <string> profile-id;
    in-out property <string> profile-name;
    in-out property <string> profile-handle;
    in-out property <string> profile-status;
    in-out property <string> profile-bio;
    in-out property <bool> profile-has-avatar: false;
    in-out property <image> profile-avatar;
    in-out property <bool> profile-has-banner: false;
    in-out property <image> profile-banner;
    in-out property <string> profile-relationship;
    in-out property <string> settings-theme: "dark";
    in-out property <string> settings-dm-privacy: "friends";
    in-out property <bool> desktop-notifications: true;
    in-out property <bool> developer-mode: false;
    in-out property <string> voice-status: "disconnected";
    in-out property <bool> voice-muted: false;
    in-out property <bool> voice-deafened: false;
    in-out property <bool> voice-can-speak: false;
    in-out property <bool> voice-can-stream: false;
    in-out property <bool> voice-screen-sharing: false;
    in-out property <bool> voice-camera-enabled: false;
    in-out property <[VideoTileItem]> voice-remote-videos;
    in-out property <string> active-call-id;
    in-out property <string> active-call-state;
    in-out property <bool> active-call-incoming: false;
    in-out property <bool> can-send: true;
    in-out property <int> slow-mode-remaining: 0;
    in-out property <string> selected-message;
    in-out property <string> selected-message-author;
    in-out property <bool> selected-message-mine;
    in-out property <bool> selected-message-failed;
    in-out property <string> selected-message-gif-url;
    in-out property <int> menu-x: 0;
    in-out property <int> menu-y: 0;
    in-out property <string> replying-message;
    in-out property <string> replying-author;
    in-out property <bool> reply-notify: true;
    in-out property <bool> reply-can-notify: false;
    in-out property <string> gif-query;
    in-out property <string> editing-message;
    in-out property <string> pending-attachments;
    in-out property <bool> attachment-busy: false;
    in-out property <string> guild-settings-page: "overview";
    in-out property <string> guild-description;
    in-out property <string> guild-history-policy: "disabled";
    in-out property <bool> guild-has-icon: false;
    in-out property <image> guild-icon;
    in-out property <bool> guild-has-banner: false;
    in-out property <image> guild-banner;
    in-out property <string> selected-role;
    in-out property <string> selected-role-name;
    in-out property <string> selected-role-color: "#99aab5";
    in-out property <bool> selected-role-hoist;
    in-out property <bool> selected-role-mentionable;
    in-out property <bool> can-manage-guild: false;
    in-out property <bool> can-manage-channels: false;
    in-out property <bool> can-manage-roles: false;
    in-out property <bool> can-kick: false;
    in-out property <bool> can-ban: false;
    in-out property <bool> can-timeout: false;
    in-out property <bool> can-invite: false;
    in-out property <bool> can-mute-voice: false;
    in-out property <bool> can-deafen-voice: false;
    in-out property <bool> can-move-voice: false;
    in-out property <string> voice-move-user;
    in-out property <bool> is-guild-owner: false;
    in-out property <string> selected-admin-channel;
    in-out property <string> selected-admin-channel-name;
    in-out property <string> selected-admin-channel-topic;
    in-out property <string> selected-admin-channel-parent;
    in-out property <int> selected-admin-channel-slow-mode;
    in-out property <bool> selected-admin-channel-synced;
    in-out property <string> selected-overwrite;
    in-out property <string> selected-overwrite-kind;
    in-out property <string> selected-input-device: "System default";
    in-out property <string> selected-output-device: "System default";
    in-out property <string> selected-camera-device: "System default";
    in-out property <string> selected-screen-source: "Operating-system picker";
    in-out property <string> input-mode: "voice_activity";
    in-out property <string> push-to-talk-hotkey;
    in-out property <string> global-hotkey-status: "No global push-to-talk shortcut configured.";
    in-out property <string> update-status: "Update checks are not configured for this build.";
    in-out property <string> security-result;
    in property <[AccountItem]> known-accounts;
    in property <[SessionItem]> sessions;
    in property <[CompletionItem]> completions;
    in property <[GuildItem]> guilds;
    in property <[ChannelItem]> channels;
    in property <[MessageItem]> messages;
    in property <[MessageItem]> pinned-messages;
    in property <[MemberItem]> members;
    in property <[FriendItem]> friends;
    in property <[ChannelItem]> direct-messages;
    in property <[EmojiItem]> emojis;
    in property <[[EmojiItem]]> emoji-grid;
    in property <[GifItem]> gifs;
    in property <[RoleItem]> roles;
    in property <[ProfileRoleItem]> profile-roles;
    in property <[PermissionItem]> role-permissions;
    in property <[AdminMemberItem]> admin-members;
    in property <[AdminChannelItem]> admin-channels;
    in property <[OverwriteItem]> overwrites;
    in property <[OverwritePermissionItem]> overwrite-permissions;
    in property <[AdminRecordItem]> audit-records;
    in property <[AdminRecordItem]> webhook-records;
    in property <[AdminRecordItem]> invite-records;
    in property <[AdminRecordItem]> ban-records;
    in property <[AdminRecordItem]> instance-ban-records;
    in property <[AdminRecordItem]> emoji-records;
    in property <[VoiceMemberItem]> voice-members;
    in property <[string]> input-devices;
    in property <[string]> output-devices;
    in property <[string]> camera-devices;
    in property <[string]> screen-sources;
    callback login(string, string, string);
    callback submit-mfa(string);
    callback cancel-mfa;
    callback register-requested;
    callback register-account(string, string, string, string);
    callback forgot-password(string, string);
    callback verify-email(string, string);
    callback reset-password(string, string, string);
    callback guild-selected(string);
    callback channel-selected(string);
    callback send-message(string);
    callback open-settings;
    callback open-guild-settings;
    callback home-page-selected(string);
    callback create-guild(string);
    callback join-guild(string);
    callback friend-request(string);
    callback friend-profile(string);
    callback friend-message(string);
    callback friend-accept(string);
    callback friend-remove(string);
    callback profile-relationship-action(string, string);
    callback profile-block(string, bool);
    callback profile-role(string, string, bool);
    callback new-direct-message;
    callback save-profile(string, string, string);
    callback set-presence(string);
    callback upload-profile-asset(string);
    callback save-preferences(string, string, bool, bool);
    callback logout;
    callback join-voice(string);
    callback leave-voice;
    callback set-voice-muted(bool);
    callback set-voice-deafened(bool);
    callback set-push-to-talk(bool);
    callback set-camera(bool);
    callback set-screen-share(bool);
    callback select-screen-source(string);
    callback start-call(string);
    callback accept-call(string);
    callback decline-call(string);
    callback end-call(string);
    callback load-older;
    callback retry-message(string);
    callback reply-message(string);
    callback cancel-reply;
    callback edit-message(string);
    callback edit-last-message;
    callback cancel-edit;
    callback delete-message(string);
    callback react-message(string, string);
    callback pin-message(string);
    callback open-pins;
    callback open-message-media(string);
    callback copy-message(string);
    callback copy-user-handle(string);
    callback search-gifs(string);
    callback load-more-gifs;
    callback favorite-gif(string, string, string);
    callback attach-file;
    callback clear-attachments;
    callback update-completions(string);
    callback choose-completion(string);
    callback search-emojis(string);
    callback toggle-category(string);
    callback guild-role-selected(string);
    callback guild-create-role(string);
    callback guild-save-role(string, string, string, bool, bool);
    callback guild-delete-role(string);
    callback guild-toggle-role-permission(string, string, bool);
    callback guild-create-channel(string, string);
    callback guild-select-channel(string);
    callback guild-save-channel(string, string, string, string, int);
    callback guild-delete-channel(string);
    callback guild-sync-channel(string);
    callback guild-select-overwrite(string, string);
    callback guild-set-overwrite-permission(string, string, string, string);
    callback guild-delete-overwrite(string, string);
    callback guild-move-channel(string, int);
    callback guild-moderate-member(string, string, string, string);
    callback guild-move-role(string, int);
    callback guild-create-invite;
    callback guild-copy-invite(string);
    callback guild-revoke-invite(string);
    callback guild-upload-asset(string);
    callback guild-upload-emoji(string);
    callback guild-delete-emoji(string);
    callback guild-create-webhook(string, string);
    callback guild-update-webhook(string, string);
    callback guild-delete-webhook(string);
    callback guild-rotate-webhook(string);
    callback guild-voice-moderate(string, string);
    callback guild-unban-member(string);
    callback guild-ban-instance(string, string, string);
    callback guild-unban-instance(string);
    callback guild-notification-level(string);
    callback guild-save(string, string, string);
    callback guild-leave;
    callback guild-transfer(string);
    callback guild-delete;
    callback select-input-device(string);
    callback select-output-device(string);
    callback select-camera-device(string);
    callback refresh-media-devices;
    callback select-input-mode(string);
    callback select-push-to-talk-hotkey(string);
    callback check-for-updates;
    callback request-email-change(string, string);
    callback setup-mfa(string, string);
    callback enable-mfa(string);
    callback disable-mfa(string, string);
    callback restore-account(string, string);
    callback forget-account(string);
    callback refresh-sessions;
    callback revoke-session(string);
    callback switch-account;

    if !root.authenticated && !root.mfa-required && root.auth-page == "login": LoginPane { accounts: root.known-accounts; busy: root.busy; error: root.error-message; login(instance, identifier, password) => { root.login(instance, identifier, password); } account-selected(instance, key) => { root.restore-account(instance, key); } account-forgotten(key) => { root.forget-account(key); } register-requested => { root.auth-page = "register"; root.register-requested(); } recovery-requested => { root.auth-page = "forgot"; } }
    if !root.authenticated && !root.mfa-required && root.auth-page != "login": OnboardingPane { mode <=> root.auth-page; busy: root.busy; error: root.error-message; notice: root.auth-notice; close => { root.auth-page = "login"; root.error-message = ""; root.auth-notice = ""; } register(instance, username, email, password) => { root.register-account(instance, username, email, password); } forgot(instance, email) => { root.forgot-password(instance, email); } verify(instance, token) => { root.verify-email(instance, token); } reset(instance, token, password) => { root.reset-password(instance, token, password); } }
    if !root.authenticated && root.mfa-required: MfaPane { busy: root.busy; error: root.error-message; submit(code) => { root.submit-mfa(code); } cancel => { root.cancel-mfa(); } }
    if root.authenticated: HorizontalLayout {
        spacing: 0px;
        ServerRail { guilds: root.guilds; selected-guild: root.selected-guild; home-mentions: root.home-mentions; home => { root.selected-guild = ""; root.selected-channel = ""; root.channel-loading = false; } guild(id) => { root.selected-guild = id; root.selected-channel = ""; root.channel-loading = true; root.guild-selected(id); } }
        if root.selected-guild == "": HomeSidebar { direct-messages: root.direct-messages; selected-page: root.home-page; selected-channel: root.selected-channel; current-user: root.current-user; current-user-initials: root.current-user-initials; current-user-has-avatar: root.current-profile-has-avatar; current-user-avatar: root.current-profile-avatar; custom-status: root.current-profile-status; presence-status: root.presence-status; page(value) => { root.home-page = value; root.selected-channel = ""; root.channel-loading = false; root.home-page-selected(value); } channel(id) => { root.selected-channel = id; root.channel-loading = true; root.channel-selected(id); } new-message => { root.active-overlay = "new-dm"; root.new-direct-message(); } settings => { root.active-overlay = "settings"; root.open-settings(); } set-presence(value) => { root.presence-status = value; root.set-presence(value); } }
        if root.selected-guild != "": ChannelSidebar { title: root.guild-title; sync-paused: root.guild-sync-paused; sync-paused-title: root.guild-sync-paused-title; sync-paused-message: root.guild-sync-paused-message; channels: root.channels; selected-channel: root.selected-channel; current-user: root.current-user; current-user-initials: root.current-user-initials; current-user-has-avatar: root.current-profile-has-avatar; current-user-avatar: root.current-profile-avatar; custom-status: root.current-profile-status; presence-status: root.presence-status; channel(id) => { root.selected-channel = id; root.channel-loading = true; root.channel-selected(id); } toggle-category(id) => { root.toggle-category(id); } member-profile(id) => { root.friend-profile(id); } guild-settings => { root.active-overlay = "guild-settings"; root.open-guild-settings(); } settings => { root.active-overlay = "settings"; root.open-settings(); } set-presence(value) => { root.presence-status = value; root.set-presence(value); } }
        if root.selected-guild == "" && root.selected-channel == "" && !root.channel-loading: HomePane { horizontal-stretch: 1; page: root.home-page; friends: root.friends; guilds: root.guilds; direct-messages: root.direct-messages; add-friend(handle) => { root.friend-request(handle); } friend-profile(id) => { root.friend-profile(id); } friend-message(id) => { root.friend-message(id); } friend-accept(id) => { root.friend-accept(id); } friend-remove(id) => { root.friend-remove(id); } create-guild(name) => { root.create-guild(name); } join-guild(invite) => { root.join-guild(invite); } open-guild(id) => { root.selected-guild = id; root.selected-channel = ""; root.channel-loading = true; root.guild-selected(id); } open-channel(id) => { root.selected-channel = id; root.channel-loading = true; root.channel-selected(id); } }
        if root.channel-loading && root.selected-channel == "": ChannelLoadingPane { horizontal-stretch: 1; }
        if root.selected-channel != "" && root.selected-channel-kind != "voice": ChatPane { horizontal-stretch: 1; channel-name: root.selected-channel-name; channel-topic: root.selected-channel-topic; direct-message: root.selected-channel-kind == "dm"; guild-history-warning: root.guild-history-warning; history-page-warning: root.history-page-warning; call-state: root.active-call-state; call-incoming: root.active-call-incoming; messages: root.messages; loading: root.channel-loading; history-loading: root.history-loading; history-complete: root.history-complete; history-truncated: root.history-truncated; history-remote-available: root.history-remote-available; completions: root.completions; typing-indicator: root.typing-indicator; replying-author: root.replying-author; editing: root.editing-message != ""; reply-notify <=> root.reply-notify; reply-can-notify: root.reply-can-notify; draft <=> root.draft; can-send: root.can-send; slow-mode-remaining: root.slow-mode-remaining; attachment-busy: root.attachment-busy; pending-attachments: root.pending-attachments; send(value) => { root.send-message(value); root.draft = ""; root.update-completions(""); } draft-edited(value) => { root.update-completions(value); } completion-selected(value) => { root.choose-completion(value); } cancel-reply => { root.cancel-reply(); } cancel-edit => { root.cancel-edit(); } edit-last => { root.edit-last-message(); } toggle-members => { root.members-visible = !root.members-visible; } open-pins => { root.open-pins(); } open-message-media(id) => { root.open-message-media(id); } member-profile(id) => { root.friend-profile(id); } load-older => { root.load-older(); } attach => { root.attach-file(); } clear-attachments => { root.clear-attachments(); } gif => { root.active-overlay = "gif"; root.search-gifs(""); } emoji => { root.search-emojis(""); root.active-overlay = "emoji"; } start-call => { root.start-call(root.selected-channel); } accept-call => { root.accept-call(root.active-call-id); } decline-call => { root.decline-call(root.active-call-id); } end-call => { root.end-call(root.active-call-id); } message-context(id, author, mine, failed, gif-url, x, y) => { root.selected-message = id; root.selected-message-author = author; root.selected-message-mine = mine; root.selected-message-failed = failed; root.selected-message-gif-url = gif-url; root.menu-x = x; root.menu-y = y; root.active-overlay = "message"; } }
        if root.selected-channel != "" && root.selected-channel-kind == "voice": VoicePane { horizontal-stretch: 1; channel-name: root.selected-channel-name; status: root.voice-status; muted <=> root.voice-muted; deafened <=> root.voice-deafened; can-speak: root.voice-can-speak; can-stream: root.voice-can-stream; screen-sharing <=> root.voice-screen-sharing; camera-enabled <=> root.voice-camera-enabled; participants: root.voice-members; channels: root.channels; remote-videos: root.voice-remote-videos; can-mute-voice: root.can-mute-voice; can-deafen-voice: root.can-deafen-voice; can-move-voice: root.can-move-voice; move-user <=> root.voice-move-user; join => { root.join-voice(root.selected-channel); } leave => { root.leave-voice(); } mute(value) => { root.set-voice-muted(value); } deafen(value) => { root.set-voice-deafened(value); } push-to-talk(value) => { root.set-push-to-talk(value); } camera(value) => { root.set-camera(value); } screen-share(value) => { root.set-screen-share(value); } toggle-members => { root.members-visible = !root.members-visible; } moderate-participant(id, action) => { root.guild-voice-moderate(id, action); } }
        if root.selected-guild != "" && root.members-visible: MemberRail { members: root.members; close => { root.members-visible = false; } profile(id) => { root.friend-profile(id); } }
    }
    if root.authenticated && root.realtime-status != "connected": Rectangle { x: (parent.width - self.width) / 2; y: 12px; width: 360px; height: 38px; border-radius: 11px; background: root.realtime-status == "authentication_failed" ? #542a28 : Theme.raised; border-width: 1px; border-color: Theme.border; Text { text: root.realtime-status == "authentication_failed" ? "Realtime authentication failed. Sign in again." : root.realtime-status == "reconnecting" ? "Reconnecting to realtime updates…" : "Connecting to realtime updates…"; color: root.realtime-status == "authentication_failed" ? #ffaaa2 : Theme.muted; horizontal-alignment: center; vertical-alignment: center; font-size: 12px; font-weight: 700; } }
    if root.authenticated && root.error-message != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.realtime-status == "connected" ? 12px : 58px;
        width: min(620px, parent.width - 32px);
        height: 58px;
        border-radius: 11px;
        background: Theme.raised;
        border-width: 1px;
        border-color: Theme.border;
        HorizontalLayout {
            padding: 8px;
            spacing: 10px;
            Text { text: root.error-message; color: Theme.text; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
            Text { text: "×"; color: Theme.muted; font-size: 20px; vertical-alignment: center; }
        }
        TouchArea { clicked => { root.error-message = ""; } }
    }
    if root.active-overlay == "settings": SettingsPane { current-user: root.current-user; has-avatar: root.current-profile-has-avatar; avatar: root.current-profile-avatar; has-banner: root.current-profile-has-banner; banner: root.current-profile-banner; display-name <=> root.current-profile-name; custom-status <=> root.current-profile-status; presence-status <=> root.presence-status; bio <=> root.current-profile-bio; theme-name <=> root.settings-theme; dm-privacy <=> root.settings-dm-privacy; desktop-notifications <=> root.desktop-notifications; developer-mode <=> root.developer-mode; security-result: root.security-result; sessions: root.sessions; input-devices: root.input-devices; output-devices: root.output-devices; camera-devices: root.camera-devices; screen-sources: root.screen-sources; selected-input-device <=> root.selected-input-device; selected-output-device <=> root.selected-output-device; selected-camera-device <=> root.selected-camera-device; selected-screen-source <=> root.selected-screen-source; input-mode <=> root.input-mode; push-to-talk-hotkey <=> root.push-to-talk-hotkey; global-hotkey-status: root.global-hotkey-status; update-status: root.update-status; input-device-selected(value) => { root.select-input-device(value); } output-device-selected(value) => { root.select-output-device(value); } camera-device-selected(value) => { root.select-camera-device(value); } screen-source-selected(value) => { root.select-screen-source(value); } refresh-media-devices => { root.refresh-media-devices(); } input-mode-selected(value) => { root.select-input-mode(value); } push-to-talk-hotkey-selected(value) => { root.select-push-to-talk-hotkey(value); } check-for-updates => { root.check-for-updates(); } request-email-change(email, password) => { root.request-email-change(email, password); } setup-mfa(password, code) => { root.setup-mfa(password, code); } enable-mfa(code) => { root.enable-mfa(code); } disable-mfa(password, code) => { root.disable-mfa(password, code); } refresh-sessions => { root.refresh-sessions(); } revoke-session(id) => { root.revoke-session(id); } switch-account => { root.switch-account(); } close => { root.active-overlay = ""; root.security-result = ""; } save-profile(name, status, bio) => { root.save-profile(name, status, bio); } set-presence(value) => { root.set-presence(value); } upload-profile-asset(kind) => { root.upload-profile-asset(kind); } save-preferences(theme, privacy, notifications, developer) => { root.save-preferences(theme, privacy, notifications, developer); } logout => { root.logout(); } }
    if root.active-overlay == "guild-settings": GuildSettingsPane { guild-name: root.guild-title; has-guild-icon: root.guild-has-icon; guild-icon: root.guild-icon; has-guild-banner: root.guild-has-banner; guild-banner: root.guild-banner; guild-description <=> root.guild-description; guild-history-policy <=> root.guild-history-policy; page <=> root.guild-settings-page; roles: root.roles; permissions: root.role-permissions; admin-members: root.admin-members; admin-channels: root.admin-channels; overwrites: root.overwrites; overwrite-permissions: root.overwrite-permissions; audit-records: root.audit-records; webhook-records: root.webhook-records; invite-records: root.invite-records; ban-records: root.ban-records; instance-ban-records: root.instance-ban-records; emoji-records: root.emoji-records; selected-role <=> root.selected-role; selected-role-name <=> root.selected-role-name; selected-role-color <=> root.selected-role-color; selected-role-hoist <=> root.selected-role-hoist; selected-role-mentionable <=> root.selected-role-mentionable; selected-admin-channel <=> root.selected-admin-channel; selected-admin-channel-name <=> root.selected-admin-channel-name; selected-admin-channel-topic <=> root.selected-admin-channel-topic; selected-admin-channel-parent <=> root.selected-admin-channel-parent; selected-admin-channel-slow-mode <=> root.selected-admin-channel-slow-mode; selected-admin-channel-synced <=> root.selected-admin-channel-synced; selected-overwrite <=> root.selected-overwrite; selected-overwrite-kind <=> root.selected-overwrite-kind; can-manage-guild: root.can-manage-guild; can-manage-channels: root.can-manage-channels; can-manage-roles: root.can-manage-roles; can-kick: root.can-kick; can-ban: root.can-ban; can-timeout: root.can-timeout; can-invite: root.can-invite; is-owner: root.is-guild-owner; close => { root.active-overlay = ""; } role-selected(id) => { root.guild-role-selected(id); } create-role(name) => { root.guild-create-role(name); } save-role(id, name, color, hoist, mentionable) => { root.guild-save-role(id, name, color, hoist, mentionable); } delete-role(id) => { root.guild-delete-role(id); } toggle-role-permission(id, bit, enabled) => { root.guild-toggle-role-permission(id, bit, enabled); } move-role(id, delta) => { root.guild-move-role(id, delta); } create-channel(name, kind) => { root.guild-create-channel(name, kind); } select-channel(id) => { root.guild-select-channel(id); } save-channel(id, name, topic, parent, slow) => { root.guild-save-channel(id, name, topic, parent, slow); } delete-channel(id) => { root.guild-delete-channel(id); } sync-channel(id) => { root.guild-sync-channel(id); } select-overwrite(id, kind) => { root.guild-select-overwrite(id, kind); } set-overwrite-permission(id, kind, bit, state) => { root.guild-set-overwrite-permission(id, kind, bit, state); } delete-overwrite(id, kind) => { root.guild-delete-overwrite(id, kind); } move-channel(id, delta) => { root.guild-move-channel(id, delta); } moderate-member(id, action, duration, reason) => { root.guild-moderate-member(id, action, duration, reason); } create-invite => { root.guild-create-invite(); } copy-invite(code) => { root.guild-copy-invite(code); } revoke-invite(code) => { root.guild-revoke-invite(code); } upload-guild-asset(kind) => { root.guild-upload-asset(kind); } upload-emoji(name) => { root.guild-upload-emoji(name); } delete-emoji(id) => { root.guild-delete-emoji(id); } create-webhook(channel, name) => { root.guild-create-webhook(channel, name); } update-webhook(id, name) => { root.guild-update-webhook(id, name); } delete-webhook(id) => { root.guild-delete-webhook(id); } rotate-webhook(id) => { root.guild-rotate-webhook(id); } unban-member(id) => { root.guild-unban-member(id); } ban-instance(domain, duration, reason) => { root.guild-ban-instance(domain, duration, reason); } unban-instance(domain) => { root.guild-unban-instance(domain); } set-notification-level(level) => { root.guild-notification-level(level); } save-guild(name, description, history) => { root.guild-save(name, description, history); } leave-guild => { root.guild-leave(); } transfer-guild(id) => { root.guild-transfer(id); } delete-guild => { root.guild-delete(); } }
    if root.active-overlay == "profile": ProfileOverlay { user-id: root.profile-id; name: root.profile-name; handle: root.profile-handle; status: root.profile-status; bio: root.profile-bio; relationship: root.profile-relationship; has-avatar: root.profile-has-avatar; avatar: root.profile-avatar; has-banner: root.profile-has-banner; banner: root.profile-banner; roles: root.profile-roles; close => { root.active-overlay = ""; } message(id) => { root.friend-message(id); } relationship-action(id, action) => { root.profile-relationship-action(id, action); } block(id, value) => { root.profile-block(id, value); } role(user, role, assign) => { root.profile-role(user, role, assign); } }
    if root.active-overlay == "new-dm": NewDirectMessageOverlay { friends: root.friends; close => { root.active-overlay = ""; } open(value) => { root.friend-message(value); } }
    if root.active-overlay == "emoji": EmojiPicker { grid: root.emoji-grid; search(query) => { root.search-emojis(query); } close => { root.active-overlay = ""; } choose(value) => { root.draft += value; root.active-overlay = ""; } }
    if root.active-overlay == "reaction": EmojiPicker { grid: root.emoji-grid; reaction: true; search(query) => { root.search-emojis(query); } close => { root.active-overlay = ""; } choose(value) => { root.react-message(root.selected-message, value); root.active-overlay = ""; } }
    if root.active-overlay == "gif": GifPicker { gifs: root.gifs; query <=> root.gif-query; close => { root.active-overlay = ""; } search(query) => { root.search-gifs(query); } choose(url) => { root.send-message(url); root.active-overlay = ""; } favorite(id, title, url) => { root.favorite-gif(id, title, url); } load-more => { root.load-more-gifs(); } }
    if root.active-overlay == "message": MessageMenu { mine: root.selected-message-mine; failed: root.selected-message-failed; gif-url: root.selected-message-gif-url; author-id: root.selected-message-author; menu-x: root.menu-x; menu-y: root.menu-y; close => { root.active-overlay = ""; } retry => { root.retry-message(root.selected-message); root.active-overlay = ""; } reply => { root.reply-message(root.selected-message); root.active-overlay = ""; } edit => { root.edit-message(root.selected-message); root.active-overlay = ""; } remove => { root.delete-message(root.selected-message); root.active-overlay = ""; } pin => { root.pin-message(root.selected-message); root.active-overlay = ""; } copy => { root.copy-message(root.selected-message); root.active-overlay = ""; } view-profile(id) => { root.friend-profile(id); root.active-overlay = ""; } copy-username(id) => { root.copy-user-handle(id); root.active-overlay = ""; } favorite-gif(url) => { root.favorite-gif(url, "Saved GIF", url); root.active-overlay = ""; } }
    if root.active-overlay == "pins": PinnedMessagesOverlay { messages: root.pinned-messages; close => { root.active-overlay = ""; } }
}
