+namespace livekit_ffi {
+#ifdef RTC_ENABLE_H265
+namespace {
+// One 640x360 8-bit Main-profile Annex-B IDR, generated once with FFmpeg/x265:
+// ffmpeg -f lavfi -i color=c=0x204060:s=640x360:r=15 -frames:v 3
+//   -c:v libx265 -pix_fmt yuv420p -profile:v main -preset veryfast
+//   -tune zerolatency -x265-params pools=none:frame-threads=1:keyint=30:
+//   min-keyint=30:bframes=0:repeat-headers=1:info=0 -f hevc probe.h265
+// Keep VPS/SPS/PPS and the first IDR (185 bytes); no software codec ships here.
+constexpr uint8_t kHevcFrame[] = {
+    0x00, 0x00, 0x00, 0x01, 0x40, 0x01, 0x0c, 0x01, 0xff, 0xff, 0x01, 0x60,
+    0x00, 0x00, 0x03, 0x00, 0x90, 0x00, 0x00, 0x03, 0x00, 0x00, 0x03, 0x00,
+    0x3f, 0xba, 0x02, 0x40, 0x00, 0x00, 0x00, 0x01, 0x42, 0x01, 0x01, 0x01,
+    0x60, 0x00, 0x00, 0x03, 0x00, 0x90, 0x00, 0x00, 0x03, 0x00, 0x00, 0x03,
+    0x00, 0x3f, 0xa0, 0x05, 0x02, 0x01, 0x69, 0x65, 0xba, 0x92, 0x4c, 0xaf,
+    0x01, 0x68, 0x08, 0x00, 0x00, 0x03, 0x00, 0x08, 0x00, 0x00, 0x03, 0x00,
+    0x78, 0x40, 0x00, 0x00, 0x00, 0x01, 0x44, 0x01, 0xc1, 0x72, 0xb4, 0x22,
+    0x40, 0x00, 0x00, 0x01, 0x28, 0x01, 0xaf, 0x78, 0xeb, 0x02, 0x01, 0xff,
+    0xf2, 0x40, 0x5a, 0x0b, 0x1f, 0xcf, 0xdb, 0xb1, 0x51, 0x51, 0x84, 0x7b,
+    0x92, 0x5b, 0xb8, 0x03, 0xa0, 0x0c, 0xe0, 0x54, 0x86, 0xa0, 0x00, 0x00,
+    0x03, 0x00, 0x00, 0x03, 0x00, 0x00, 0x03, 0x00, 0x00, 0x03, 0x00, 0x00,
+    0x03, 0x00, 0x00, 0x03, 0x00, 0x00, 0x03, 0x00, 0x00, 0x03, 0x00, 0x00,
+    0x03, 0x00, 0x00, 0x03, 0x00, 0x00, 0x03, 0x00, 0x00, 0x03, 0x00, 0x00,
+    0x03, 0x00, 0x00, 0x03, 0x00, 0x59, 0x80, 0x00, 0x00, 0x03, 0x00, 0x00,
+    0x03, 0x00, 0x00, 0x03, 0x00, 0x00, 0x03, 0x00, 0x00, 0x03, 0x00, 0x00,
+    0x03, 0x00, 0x00, 0x1a, 0x70,
+};
+
+class ProbeOutput final : public webrtc::DecodedImageCallback {
+ public:
+  int32_t Decoded(webrtc::VideoFrame& frame) override {
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      if (frame.width() == 640 && frame.height() == 360 &&
+          frame.video_frame_buffer()) decoded_ = true;
+    }
+    ready_.notify_one();
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+  int32_t Decoded(webrtc::VideoFrame& frame, int64_t) override {
+    return Decoded(frame);
+  }
+  void Decoded(webrtc::VideoFrame& frame, std::optional<int32_t>,
+               std::optional<uint8_t>) override {
+    Decoded(frame);
+  }
+  bool Wait() {
+    std::unique_lock<std::mutex> lock(mutex_);
+    return ready_.wait_for(lock, std::chrono::seconds(2),
+                           [this] { return decoded_; });
+  }
+ private:
+  std::mutex mutex_;
+  std::condition_variable ready_;
+  bool decoded_ = false;
+};
+
+// Release must drain asynchronous callbacks before ProbeOutput goes out of
+// scope, including when Configure/Decode throws or fails partway through.
+struct ReleaseDecoder {
+  webrtc::VideoDecoder* decoder;
+  ~ReleaseDecoder() {
+    try { decoder->Release(); }
+    catch (...) { /* The FFI helper must never unwind into Rust. */ }
+  }
+};
+
+bool TrustedHardware(const webrtc::VideoDecoder::DecoderInfo& info) {
+  if (!info.is_hardware_accelerated || info.implementation_name.empty()) return false;
+  const std::string name = absl::AsciiStrToLower(info.implementation_name);
+  for (const char* rejected : {"software", "fallback", "ffmpeg", "libav", "libde265"}) {
+    if (name.find(rejected) != std::string::npos) return false;
+  }
+  for (const char* hardware : {"externaldecoder", "videotoolbox", "mediacodec",
+                               "nvidia", "nvdec", "mediafoundation", "d3d11"}) {
+    if (name.find(hardware) != std::string::npos) return true;
+  }
+  return false;
+}
+
+bool ProbeHardwareHevcDecoder() {
+  ProbeOutput output;
+  auto env = webrtc::CreateEnvironment();
+  VideoDecoderFactory factory;
+  const webrtc::SdpVideoFormat format("H265", {{"profile-id", "1"},
+                                              {"tier-flag", "0"},
+                                              {"level-id", "93"}});
+  auto decoder = factory.Create(env, format);
+  if (!decoder) return false;
+  ReleaseDecoder release{decoder.get()};
+  webrtc::VideoDecoder::Settings settings;
+  settings.set_codec_type(webrtc::kVideoCodecH265);
+  settings.set_max_render_resolution({640, 360});
+  settings.set_number_of_cores(1);
+  if (!decoder->Configure(settings) ||
+      decoder->RegisterDecodeCompleteCallback(&output) != WEBRTC_VIDEO_CODEC_OK) return false;
+  // Some hardware queues one picture before output. Repeating a self-contained
+  // IDR with distinct timestamps also exercises the asynchronous decoder path.
+  for (uint32_t index = 0; index < 3; ++index) {
+    webrtc::EncodedImage frame;
+    frame.SetEncodedData(webrtc::EncodedImageBuffer::Create(kHevcFrame, sizeof(kHevcFrame)));
+    frame.SetRtpTimestamp(1 + index * 6000);
+    frame._encodedWidth = 640;
+    frame._encodedHeight = 360;
+    frame._frameType = webrtc::VideoFrameType::kVideoFrameKey;
+    const int result = decoder->Decode(frame, /*missing_frames=*/false, /*render_time_ms=*/0);
+    if (result < WEBRTC_VIDEO_CODEC_OK) return false;
+  }
+  if (!output.Wait()) return false;
+  const auto info = decoder->GetDecoderInfo();
+  RTC_LOG(LS_INFO) << "HEVC decode probe: " << info.implementation_name
+                   << ", hardware=" << info.is_hardware_accelerated;
+  return TrustedHardware(info);
+}
+}  // namespace
+#endif
+
+bool probe_hardware_hevc_decoder() {
+#ifdef RTC_ENABLE_H265
+  try { return ProbeHardwareHevcDecoder(); }
+  catch (const std::exception& error) {
+    RTC_LOG(LS_WARNING) << "HEVC decode probe failed: " << error.what();
+  }
+  catch (...) {
+    RTC_LOG(LS_WARNING) << "HEVC decode probe failed";
+  }
+#endif
+  return false;
+}
+}  // namespace livekit_ffi
