+// Copyright 2026 Kaede Chat contributors. SPDX-License-Identifier: Apache-2.0
+#include "livekit/hardware_video_probe.h"
+
+#ifdef RTC_ENABLE_H265
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <exception>
