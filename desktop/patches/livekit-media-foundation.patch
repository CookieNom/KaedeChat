+struct ComRuntime {
+  HRESULT com = CoInitializeEx(nullptr, COINIT_MULTITHREADED);
+  HRESULT mf = SUCCEEDED(com) ? MFStartup(MF_VERSION, MFSTARTUP_LITE) : com;
+  ~ComRuntime() {
+    if (SUCCEEDED(mf)) MFShutdown();
+    if (SUCCEEDED(com)) CoUninitialize();
+  }
+};
