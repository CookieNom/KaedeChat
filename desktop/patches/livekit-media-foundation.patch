+// MFT H26x media types use Annex B. Fail closed on length-prefixed/config-record
+// variants rather than passing malformed frames to RTP packetization or E2EE.
+constexpr bool IsAnnexB(std::span<const uint8_t> bytes, bool hevc) {
+  auto start = [&](size_t offset) -> size_t {
+    if (offset + 3 > bytes.size() || bytes[offset] || bytes[offset + 1]) return 0;
+    if (bytes[offset + 2] == 1) return 3;
+    return offset + 4 <= bytes.size() && !bytes[offset + 2] && bytes[offset + 3] == 1 ? 4 : 0;
+  };
+  if (!start(0)) return false;
+  size_t units = 0;
+  for (size_t offset = 0; offset < bytes.size(); ++offset) {
+    const size_t prefix = start(offset);
+    if (!prefix) continue;
+    if (++units > 4096) return false;
+    offset += prefix;
+    const size_t header = hevc ? 2 : 1;
+    if (offset + header >= bytes.size() || (bytes[offset] & 0x80)) return false;
+    if (hevc ? !(bytes[offset + 1] & 7) : !(bytes[offset] & 31) || (bytes[offset] & 31) >= 24) return false;
+  }
+  return true;
+}
+static_assert(IsAnnexB(std::array<uint8_t, 6>{0, 0, 0, 1, 0x65, 0x80}, false));
+static_assert(IsAnnexB(std::array<uint8_t, 6>{0, 0, 1, 0x26, 1, 0x80}, true));
+static_assert(!IsAnnexB(std::array<uint8_t, 6>{0, 0, 0, 2, 0x26, 1}, true));
+static_assert(!IsAnnexB(std::array<uint8_t, 5>{0, 0, 1, 0x26, 1}, true));
+static_assert(!IsAnnexB(std::array<uint8_t, 6>{0, 0, 1, 0x26, 0, 0x80}, true));
