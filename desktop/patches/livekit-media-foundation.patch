+constexpr size_t kMaxFrameBytes = 32 * 1024 * 1024;
+constexpr size_t kMaxPendingFrames = 4;
+constexpr int kMaxDimension = 4096;
+static_assert(size_t{kMaxDimension} * kMaxDimension * 3 / 2 <= kMaxFrameBytes);
