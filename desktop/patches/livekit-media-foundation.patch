+// All COM objects, MFT input/output, and codec callbacks live on one MTA thread.
+// The bounded queue prevents a stalled device from accumulating captured frames.
+class Session {
+ public:
+  using Output = std::function<void(Frame, int, int, int)>;
+  ~Session() { Stop(); }
+
+  bool Start(const Codec& codec, bool encode, int width, int height, int fps,
+             uint32_t bitrate, Output output) {
+    Stop();
+    stopping_ = false;
+    failed_ = false;
+    hardware_proven_ = false;
+    bitrate_ = bitrate;
+    fps_ = fps;
+    std::promise<bool> ready;
+    auto result = ready.get_future();
+    worker_ = std::thread([=, this, ready = std::move(ready), output = std::move(output)]() mutable {
+      ComRuntime runtime;
+      if (FAILED(runtime.mf) || !Open(codec, encode, width, height, fps, bitrate)) {
+        failed_ = true;
+        ready.set_value(false);
+        Close();
+        return;
+      }
+      ready.set_value(true);
+      while (!stopping_ && !failed_) {
+        if (!Pump(output)) {
+          failed_ = true;
+          break;
+        }
+        std::unique_lock<std::mutex> lock(mutex_);
+        wake_.wait_for(lock, std::chrono::milliseconds(2), [this] { return stopping_.load(); });
+      }
+      Close();
+    });
+    return result.get();
+  }
+
+  void Stop() {
+    stopping_ = true;
+    wake_.notify_all();
+    if (worker_.joinable()) worker_.join();
+    std::lock_guard<std::mutex> lock(mutex_);
+    queued_.clear();
+    pending_.clear();
+    outstanding_ = 0;
+  }
+
+  bool Push(Frame frame) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (stopping_ || failed_ || outstanding_ >= kMaxPendingFrames ||
+        frame.bytes.empty() || frame.bytes.size() > kMaxFrameBytes) return false;
+    ++outstanding_;
+    assert(outstanding_ <= kMaxPendingFrames);
+    queued_.push_back(std::move(frame));
+    wake_.notify_all();
+    return true;
+  }
+
+  void Rates(uint32_t bitrate, int fps) { bitrate_ = bitrate; fps_ = fps; }
+  std::string name() const { std::lock_guard<std::mutex> lock(mutex_); return name_; }
+  bool healthy() const { return !stopping_ && !failed_; }
+  bool hardware() const { return healthy() && hardware_proven_; }
+
+ private:
+  bool Open(const Codec& codec, bool encode, int width, int height, int fps, uint32_t bitrate) {
+    codec_ = codec.type;
+    encode_ = encode;
+    for (auto& activation : Enumerate(codec, encode)) {
+      if (FAILED(activation->ActivateObject(IID_PPV_ARGS(&transform_)))) continue;
+      activation_ = activation;
+      ComPtr<IMFAttributes> attributes;
+      UINT32 async = 0, device_aware = 0, hardware_url_length = 0;
+      hardware_mft_ = SUCCEEDED(activation->GetStringLength(MFT_ENUM_HARDWARE_URL_Attribute, &hardware_url_length)) && hardware_url_length > 0;
+      if (FAILED(transform_->GetAttributes(&attributes))) { Close(); continue; }
+      attributes->GetUINT32(MF_TRANSFORM_ASYNC, &async);
+      async_ = async != 0;
+      if (async_ && (FAILED(attributes->SetUINT32(MF_TRANSFORM_ASYNC_UNLOCK, TRUE)) ||
+                     FAILED(transform_.As(&events_)))) { Close(); continue; }
+      if (encode && (!hardware_mft_ || !async_)) { Close(); continue; }
+      if (!encode) {
+        attributes->GetUINT32(MF_SA_D3D11_AWARE, &device_aware);
+        if (device_aware) {
+          UINT token = 0;
+          if (!HardwareDecoderDevice(codec.type, device_, context_) ||
+              FAILED(MFCreateDXGIDeviceManager(&token, &device_manager_)) ||
+              FAILED(device_manager_->ResetDevice(device_.Get(), token)) ||
+              FAILED(transform_->ProcessMessage(MFT_MESSAGE_SET_D3D_MANAGER,
+                  reinterpret_cast<ULONG_PTR>(device_manager_.Get())))) { Close(); continue; }
+        } else if (!hardware_mft_) { Close(); continue; }
+        // Never detach the device manager after a D3D negotiation failure. That
+        // is the documented switch which would enable software decode fallback.
+      }
+      attributes->SetUINT32(MF_LOW_LATENCY, TRUE);
+      DWORD inputs = 0, outputs = 0;
+      if (FAILED(transform_->GetStreamCount(&inputs, &outputs)) || inputs != 1 || outputs != 1) { Close(); continue; }
+      input_id_ = output_id_ = 0;
+      HRESULT stream_ids = transform_->GetStreamIDs(1, &input_id_, 1, &output_id_);
+      if (FAILED(stream_ids) && stream_ids != E_NOTIMPL) { Close(); continue; }
+      transform_.As(&codec_api_);
+      if (encode && (!SetBool(codec_api_.Get(), CODECAPI_AVLowLatencyMode, true) ||
+                     !SetUInt(codec_api_.Get(), CODECAPI_AVEncCommonRateControlMode, eAVEncCommonRateControlMode_CBR) ||
+                     !SetUInt(codec_api_.Get(), CODECAPI_AVEncCommonMeanBitRate, bitrate))) { Close(); continue; }
+      if (encode) {
+        if (codec_api_->IsSupported(&CODECAPI_AVEncVideoTemporalLayerCount) == S_OK &&
+            !SetUInt(codec_api_.Get(), CODECAPI_AVEncVideoTemporalLayerCount, 1)) { Close(); continue; }
+        SetUInt(codec_api_.Get(), CODECAPI_AVEncMPVDefaultBPictureCount, 0);
+        SetUInt(codec_api_.Get(), CODECAPI_AVEncMPVGOPSize, fps * 2);
+      }
+      auto compressed = MediaType(*codec.subtype, width, height, encode ? fps : 0);
+      if (!compressed || FAILED(compressed->SetUINT32(MF_MT_MPEG2_PROFILE, codec.profile))) { Close(); continue; }
+      if (encode) {
+        if (codec.type == webrtc::kVideoCodecH264) {
+          const auto profile = webrtc::ParseSdpForH264ProfileLevelId(codec.format.parameters);
+          if (!profile || FAILED(compressed->SetUINT32(MF_MT_MPEG2_LEVEL, static_cast<UINT32>(profile->level)))) { Close(); continue; }
+        } else if (codec.type == webrtc::kVideoCodecH265) {
+          const auto profile = webrtc::ParseSdpForH265ProfileTierLevel(codec.format.parameters);
+          if (!profile || FAILED(compressed->SetUINT32(MF_MT_MPEG2_LEVEL, static_cast<UINT32>(profile->level)))) { Close(); continue; }
+        }
+        auto raw = MediaType(MFVideoFormat_NV12, width, height, fps);
+        if (!raw || FAILED(compressed->SetUINT32(MF_MT_AVG_BITRATE, bitrate)) ||
+            FAILED(transform_->SetOutputType(output_id_, compressed.Get(), 0)) ||
+            FAILED(transform_->SetInputType(input_id_, raw.Get(), 0))) { Close(); continue; }
+        width_ = width;
+        height_ = height;
+        stride_ = width;
+      } else {
+        if (FAILED(transform_->SetInputType(input_id_, compressed.Get(), 0)) || !SetDecodeOutput()) { Close(); continue; }
+      }
+      if (FAILED(transform_->ProcessMessage(MFT_MESSAGE_NOTIFY_BEGIN_STREAMING, 0)) ||
+          FAILED(transform_->ProcessMessage(MFT_MESSAGE_NOTIFY_START_OF_STREAM, 0))) { Close(); continue; }
+      hardware_proven_ = hardware_mft_;
+      applied_bitrate_ = bitrate;
+      {
+        std::lock_guard<std::mutex> lock(mutex_);
+        name_ = Implementation(activation.Get());
+      }
+      return true;
+    }
+    return false;
+  }
+
+  bool SetDecodeOutput() {
+    for (DWORD index = 0; index < 128; ++index) {
+      ComPtr<IMFMediaType> type;
+      if (FAILED(transform_->GetOutputAvailableType(output_id_, index, &type))) break;
+      GUID subtype = GUID_NULL;
+      if (FAILED(type->GetGUID(MF_MT_SUBTYPE, &subtype)) || subtype != MFVideoFormat_NV12) continue;
+      if (FAILED(transform_->SetOutputType(output_id_, type.Get(), 0))) continue;
+      if (!ReadDecodeDimensions(type.Get())) return false;
+      return true;
+    }
+    return false;
+  }
+
+  bool ReadDecodeDimensions(IMFMediaType* type) {
+    UINT32 width = 0, height = 0, stride = 0;
+    MFGetAttributeSize(type, MF_MT_FRAME_SIZE, &width, &height);
+    type->GetUINT32(MF_MT_DEFAULT_STRIDE, &stride);
+    if (width > kMaxDimension || height > kMaxDimension || (width & 1) || (height & 1)) return false;
+    coded_width_ = width_ = width;
+    coded_height_ = height_ = height;
+    crop_x_ = crop_y_ = 0;
+    stride_ = stride == 0 ? width : static_cast<int32_t>(stride);
+    if (stride_ < coded_width_ || stride_ > kMaxDimension * 4) return false;
+    MFVideoArea area{};
+    UINT32 size = 0;
+    HRESULT hr = type->GetBlob(MF_MT_MINIMUM_DISPLAY_APERTURE,
+                               reinterpret_cast<BYTE*>(&area), sizeof(area), &size);
+    if (hr == MF_E_ATTRIBUTENOTFOUND)
+      hr = type->GetBlob(MF_MT_GEOMETRIC_APERTURE,
+                         reinterpret_cast<BYTE*>(&area), sizeof(area), &size);
+    if (SUCCEEDED(hr)) {
+      if (size != sizeof(area) || area.OffsetX.fract || area.OffsetY.fract ||
+          area.OffsetX.value < 0 || area.OffsetY.value < 0 || area.Area.cx <= 0 || area.Area.cy <= 0) return false;
+      crop_x_ = area.OffsetX.value;
+      crop_y_ = area.OffsetY.value;
+      width_ = area.Area.cx;
+      height_ = area.Area.cy;
+      if ((crop_x_ | crop_y_ | width_ | height_) & 1 ||
+          width_ > coded_width_ - crop_x_ || height_ > coded_height_ - crop_y_) return false;
+    } else if (hr != MF_E_ATTRIBUTENOTFOUND) return false;
+    return true;
+  }
+
+  void Close() {
+    if (transform_) {
+      transform_->ProcessMessage(MFT_MESSAGE_NOTIFY_END_OF_STREAM, 0);
+      transform_->ProcessMessage(MFT_MESSAGE_COMMAND_FLUSH, 0);
+      transform_->ProcessMessage(MFT_MESSAGE_NOTIFY_END_STREAMING, 0);
+      ComPtr<IMFShutdown> shutdown;
+      if (SUCCEEDED(transform_.As(&shutdown))) shutdown->Shutdown();
+    }
+    codec_api_.Reset();
+    events_.Reset();
+    transform_.Reset();
+    if (activation_) activation_->ShutdownObject();
+    activation_.Reset();
+    staging_.Reset();
+    device_manager_.Reset();
+    context_.Reset();
+    device_.Reset();
+    input_credit_ = 0;
+    output_credit_ = 0;
+  }
+
+  bool Pump(const Output& output) {
+    if (!pending_.empty() && std::chrono::steady_clock::now() - last_output_ > std::chrono::seconds(3)) return false;
+    // Async MFTs require one ProcessInput/Output for each corresponding event.
+    for (int i = 0; async_ && i < 64; ++i) {
+      ComPtr<IMFMediaEvent> event;
+      HRESULT hr = events_->GetEvent(MF_EVENT_FLAG_NO_WAIT, &event);
+      if (hr == MF_E_NO_EVENTS_AVAILABLE) break;
+      if (FAILED(hr)) return false;
+      HRESULT status = S_OK;
+      MediaEventType type = MEUnknown;
+      if (FAILED(event->GetStatus(&status)) || FAILED(status) || FAILED(event->GetType(&type))) return false;
+      if (type == METransformNeedInput) ++input_credit_;
+      if (type == METransformHaveOutput) ++output_credit_;
+      if (type == MEError) return false;
+    }
+    for (unsigned attempt = 0; output_credit_ > 0 && attempt < 16; ++attempt) {
+      --output_credit_;
+      if (!Read(output)) return false;
+    }
+    if (output_credit_ > 0) return false;
+    if (!async_) {
+      if (!pending_.empty()) {
+        for (int i = 0; i < 16; ++i) {
+          bool empty = false;
+          if (!Read(output, &empty)) return false;
+          if (empty) break;
+          if (i == 15) return false;
+        }
+      }
+      input_credit_ = 1;
+    }
+    while (input_credit_ > 0) {
+      Frame frame;
+      {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (queued_.empty()) break;
+        frame = std::move(queued_.front());
+        queued_.pop_front();
+      }
+      --input_credit_;
+      if (!Write(std::move(frame))) return false;
+    }
+    return true;
+  }
+
+  bool Write(Frame frame) {
+    const uint32_t bitrate = bitrate_;
+    if (encode_ && bitrate && bitrate != applied_bitrate_) {
+      if (!SetUInt(codec_api_.Get(), CODECAPI_AVEncCommonMeanBitRate, bitrate)) return false;
+      applied_bitrate_ = bitrate;
+    }
+    if (encode_ && frame.key && !SetUInt(codec_api_.Get(), CODECAPI_AVEncVideoForceKeyFrame, 1)) return false;
+    ComPtr<IMFSample> sample;
+    ComPtr<IMFMediaBuffer> buffer;
+    MFT_INPUT_STREAM_INFO input_info{};
+    if (FAILED(transform_->GetInputStreamInfo(input_id_, &input_info))) return false;
+    const size_t capacity = std::max<size_t>(input_info.cbSize, frame.bytes.size());
+    if (capacity > kMaxFrameBytes || FAILED(MFCreateSample(&sample)) ||
+        FAILED(MFCreateAlignedMemoryBuffer(static_cast<DWORD>(capacity),
+            input_info.cbAlignment > 0 ? input_info.cbAlignment - 1 : 0, &buffer))) return false;
+    BYTE* data = nullptr;
+    if (FAILED(buffer->Lock(&data, nullptr, nullptr))) return false;
+    std::memcpy(data, frame.bytes.data(), frame.bytes.size());
+    buffer->Unlock();
+    if (FAILED(buffer->SetCurrentLength(static_cast<DWORD>(frame.bytes.size()))) || FAILED(sample->AddBuffer(buffer.Get()))) return false;
+    const LONGLONG duration = 10000000 / std::max(1, fps_.load());
+    next_time_ += duration;
+    if (FAILED(sample->SetSampleTime(next_time_)) || FAILED(sample->SetSampleDuration(duration))) return false;
+    if (frame.key) sample->SetUINT32(MFSampleExtension_CleanPoint, TRUE);
+    if (FAILED(transform_->ProcessInput(input_id_, sample.Get(), 0))) return false;
+    frame.bytes.clear();
+    if (pending_.empty()) last_output_ = std::chrono::steady_clock::now();
+    pending_.emplace(next_time_, std::move(frame));
+    return true;
+  }
+
+  bool Read(const Output& output, bool* empty = nullptr) {
+    MFT_OUTPUT_STREAM_INFO info{};
+    if (FAILED(transform_->GetOutputStreamInfo(output_id_, &info))) return false;
+    ComPtr<IMFSample> provided;
+    if (!(info.dwFlags & (MFT_OUTPUT_STREAM_PROVIDES_SAMPLES | MFT_OUTPUT_STREAM_CAN_PROVIDE_SAMPLES))) {
+      ComPtr<IMFMediaBuffer> buffer;
+      const size_t size = std::max<size_t>(info.cbSize,
+          static_cast<size_t>(std::max(stride_, width_)) * (encode_ ? height_ : coded_height_) * 3 / 2);
+      if (!size || size > kMaxFrameBytes || FAILED(MFCreateSample(&provided)) ||
+          FAILED(MFCreateAlignedMemoryBuffer(static_cast<DWORD>(size), info.cbAlignment > 0 ? info.cbAlignment - 1 : 0, &buffer)) ||
+          FAILED(provided->AddBuffer(buffer.Get()))) return false;
+    }
+    MFT_OUTPUT_DATA_BUFFER data{};
+    data.dwStreamID = output_id_;
+    data.pSample = provided.Get();
+    DWORD status = 0;
+    HRESULT hr = transform_->ProcessOutput(0, 1, &data, &status);
+    if (data.pEvents) data.pEvents->Release();
+    ComPtr<IMFSample> sample;
+    if (data.pSample == provided.Get()) sample = provided;
+    else sample.Attach(data.pSample);
+    if (!async_ && hr == MF_E_TRANSFORM_NEED_MORE_INPUT && empty) {
+      *empty = true;
+      return true;
+    }
+    if (hr == MF_E_TRANSFORM_STREAM_CHANGE) {
+      if (encode_ || !SetDecodeOutput()) return false;
+      // The existing HaveOutput event still covers the pending output sample.
+      if (async_) ++output_credit_;
+      return true;
+    }
+    if (FAILED(hr) || !sample) return false;
+    if (!encode_) {
+      ComPtr<IMFMediaType> current;
+      if (FAILED(transform_->GetOutputCurrentType(output_id_, &current)) ||
+          !ReadDecodeDimensions(current.Get()) || width_ <= 0 || height_ <= 0) return false;
+    }
+    LONGLONG time = 0;
+    if (FAILED(sample->GetSampleTime(&time))) return false;
+    auto found = pending_.find(time);
+    if (found == pending_.end()) return false;
+    // Low-latency encoding forbids reordering. A newer output proves older
+    // pending inputs were dropped by the rate controller, not still in flight.
+    const size_t dropped = encode_ ? static_cast<size_t>(std::distance(pending_.begin(), found)) : 0;
+    Frame frame = std::move(found->second);
+    if (encode_) pending_.erase(pending_.begin(), found);
+    pending_.erase(found);
+    UINT32 key = 0;
+    sample->GetUINT32(MFSampleExtension_CleanPoint, &key);
+    frame.key = key != 0;
+    ComPtr<IMFMediaBuffer> buffer;
+    if (!encode_ && device_manager_) {
+      if (FAILED(sample->GetBufferByIndex(0, &buffer)) || !ReadTexture(buffer.Get(), frame.bytes)) return false;
+      hardware_proven_ = true;
+    } else {
+      if (FAILED(sample->ConvertToContiguousBuffer(&buffer))) return false;
+      ComPtr<IMF2DBuffer> plane;
+      if (!encode_ && SUCCEEDED(buffer.As(&plane))) {
+        DWORD size = 0;
+        if (FAILED(plane->GetContiguousLength(&size)) || !size || size > kMaxFrameBytes) return false;
+        frame.bytes.resize(size);
+        if (FAILED(plane->ContiguousCopyTo(frame.bytes.data(), size))) return false;
+        stride_ = coded_width_;
+      } else {
+        BYTE* bytes = nullptr;
+        DWORD size = 0;
+        if (FAILED(buffer->Lock(&bytes, nullptr, &size))) return false;
+        const bool valid = size > 0 && size <= kMaxFrameBytes;
+        if (valid) frame.bytes.assign(bytes, bytes + size);
+        buffer->Unlock();
+        if (!valid) return false;
+      }
+    }
+    int output_stride = stride_;
+    if (!encode_ && !device_manager_) {
+      if (frame.bytes.size() < static_cast<size_t>(stride_) * coded_height_ * 3 / 2) return false;
+      std::vector<uint8_t> visible(static_cast<size_t>(width_) * height_ * 3 / 2);
+      const auto* source = frame.bytes.data() + crop_y_ * stride_ + crop_x_;
+      for (int y = 0; y < height_; ++y)
+        std::memcpy(visible.data() + y * width_, source + y * stride_, width_);
+      source = frame.bytes.data() + stride_ * coded_height_ + (crop_y_ / 2) * stride_ + crop_x_;
+      for (int y = 0; y < height_ / 2; ++y)
+        std::memcpy(visible.data() + width_ * height_ + y * width_, source + y * stride_, width_);
+      frame.bytes = std::move(visible);
+      output_stride = width_;
+    }
+    const bool h26x = codec_ == webrtc::kVideoCodecH264 || codec_ == webrtc::kVideoCodecH265;
+    if (encode_ && h26x && !IsAnnexB(frame.bytes, codec_ == webrtc::kVideoCodecH265)) return false;
+    if (encode_ && frame.key && h26x) {
+      ComPtr<IMFMediaType> type;
+      UINT32 length = 0;
+      if (SUCCEEDED(transform_->GetOutputCurrentType(output_id_, &type)) &&
+          SUCCEEDED(type->GetBlobSize(MF_MT_MPEG_SEQUENCE_HEADER, &length)) && length > 0) {
+        if (length > kMaxFrameBytes - frame.bytes.size()) return false;
+        std::vector<uint8_t> header(length);
+        if (FAILED(type->GetBlob(MF_MT_MPEG_SEQUENCE_HEADER, header.data(), length, nullptr)) ||
+            !IsAnnexB(header, codec_ == webrtc::kVideoCodecH265)) return false;
+        // MF exposes Annex-B VPS/SPS/PPS separately on some devices. Repeat on
+        // keyframes so a late join or an encrypted receiver can reconstruct it.
+        frame.bytes.insert(frame.bytes.begin(), header.begin(), header.end());
+      }
+    }
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      assert(outstanding_ > dropped && outstanding_ <= kMaxPendingFrames);
+      outstanding_ -= dropped + 1;
+    }
+    last_output_ = std::chrono::steady_clock::now();
+    output(std::move(frame), width_, height_, output_stride);
+    return true;
+  }
+
+  bool ReadTexture(IMFMediaBuffer* buffer, std::vector<uint8_t>& bytes) {
+    ComPtr<IMFDXGIBuffer> surface;
+    ComPtr<ID3D11Texture2D> texture;
+    UINT subresource = 0;
+    if (FAILED(buffer->QueryInterface(IID_PPV_ARGS(&surface))) ||
+        FAILED(surface->GetResource(IID_PPV_ARGS(&texture))) ||
+        FAILED(surface->GetSubresourceIndex(&subresource))) return false;
+    D3D11_TEXTURE2D_DESC desc{};
+    texture->GetDesc(&desc);
+    // A software frame uploaded to an arbitrary GPU texture is not proof.
+    if (desc.Format != DXGI_FORMAT_NV12 || !(desc.BindFlags & D3D11_BIND_DECODER) ||
+        desc.Width == 0 || desc.Height == 0 || desc.Width > kMaxDimension || desc.Height > kMaxDimension ||
+        (desc.Width & 1) || (desc.Height & 1) || subresource >= desc.ArraySize * desc.MipLevels) return false;
+    ComPtr<ID3D11Device> owner;
+    texture->GetDevice(&owner);
+    if (owner.Get() != device_.Get()) return false;
+    if (width_ <= 0 || height_ <= 0 || crop_x_ + width_ > static_cast<int>(desc.Width) ||
+        crop_y_ + height_ > static_cast<int>(desc.Height)) return false;
+    D3D11_TEXTURE2D_DESC staging_desc = desc;
+    staging_desc.ArraySize = staging_desc.MipLevels = 1;
+    staging_desc.BindFlags = 0;
+    staging_desc.MiscFlags = 0;
+    staging_desc.Usage = D3D11_USAGE_STAGING;
+    staging_desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    D3D11_TEXTURE2D_DESC previous{};
+    if (staging_) staging_->GetDesc(&previous);
+    if (!staging_ || previous.Width != desc.Width || previous.Height != desc.Height) {
+      staging_.Reset();
+      if (FAILED(device_->CreateTexture2D(&staging_desc, nullptr, &staging_))) return false;
+    }
+    context_->CopySubresourceRegion(staging_.Get(), 0, 0, 0, 0, texture.Get(), subresource, nullptr);
+    D3D11_MAPPED_SUBRESOURCE mapped{};
+    if (FAILED(context_->Map(staging_.Get(), 0, D3D11_MAP_READ, 0, &mapped))) return false;
+    const bool valid = mapped.RowPitch >= static_cast<UINT>(crop_x_ + width_) && mapped.RowPitch <= kMaxDimension * 4;
+    if (valid) {
+      bytes.resize(static_cast<size_t>(width_) * height_ * 3 / 2);
+      const auto* source = static_cast<const uint8_t*>(mapped.pData) + crop_y_ * mapped.RowPitch + crop_x_;
+      for (int y = 0; y < height_; ++y)
+        std::memcpy(bytes.data() + y * width_, source + y * mapped.RowPitch, width_);
+      source = static_cast<const uint8_t*>(mapped.pData) +
+          (static_cast<size_t>(desc.Height) + crop_y_ / 2) * mapped.RowPitch + crop_x_;
+      for (int y = 0; y < height_ / 2; ++y)
+        std::memcpy(bytes.data() + width_ * height_ + y * width_, source + y * mapped.RowPitch, width_);
+      stride_ = width_;
+    }
+    context_->Unmap(staging_.Get(), 0);
+    return valid;
+  }
+
+  mutable std::mutex mutex_;
+  std::condition_variable wake_;
+  std::thread worker_;
+  std::deque<Frame> queued_;
+  std::map<LONGLONG, Frame> pending_;
+  size_t outstanding_ = 0;
+  std::string name_;
+  std::atomic<bool> stopping_{true}, failed_{false}, hardware_proven_{false};
+  std::atomic<uint32_t> bitrate_{0};
+  std::atomic<int> fps_{30};
+  ComPtr<IMFActivate> activation_;
+  ComPtr<IMFTransform> transform_;
+  ComPtr<IMFMediaEventGenerator> events_;
+  ComPtr<ICodecAPI> codec_api_;
+  ComPtr<ID3D11Device> device_;
+  ComPtr<ID3D11DeviceContext> context_;
+  ComPtr<IMFDXGIDeviceManager> device_manager_;
+  ComPtr<ID3D11Texture2D> staging_;
+  DWORD input_id_ = 0, output_id_ = 0;
+  unsigned input_credit_ = 0, output_credit_ = 0;
+  uint32_t applied_bitrate_ = 0;
+  LONGLONG next_time_ = 0;
+  std::chrono::steady_clock::time_point last_output_;
+  int width_ = 0, height_ = 0, stride_ = 0;
+  int coded_width_ = 0, coded_height_ = 0, crop_x_ = 0, crop_y_ = 0;
+  bool encode_ = false, async_ = true, hardware_mft_ = false;
+  webrtc::VideoCodecType codec_ = webrtc::kVideoCodecGeneric;
+};
+
+class Encoder final : public webrtc::VideoEncoder {
+ public:
+  explicit Encoder(Codec codec) : codec_(std::move(codec)) {}
+  ~Encoder() override { Release(); }
+  int32_t InitEncode(const webrtc::VideoCodec* settings, const Settings&) override {
+    if (!settings || settings->codecType != codec_.type || settings->width == 0 ||
+        settings->height == 0 || settings->width > kMaxDimension || settings->height > kMaxDimension ||
+        (settings->width & 1) || (settings->height & 1) || settings->maxFramerate == 0 ||
+        settings->maxFramerate > 120 || settings->numberOfSimulcastStreams > 1 ||
+        (settings->GetScalabilityMode() && settings->GetScalabilityMode() != webrtc::ScalabilityMode::kL1T1))
+      return WEBRTC_VIDEO_CODEC_ERR_PARAMETER;
+    width_ = settings->width;
+    height_ = settings->height;
+    paused_ = false;
+    first_ = true;
+    const uint64_t bitrate = static_cast<uint64_t>(settings->startBitrate) * 1000;
+    if (!bitrate || bitrate > 100000000) return WEBRTC_VIDEO_CODEC_ERR_PARAMETER;
+    return session_.Start(codec_, true, width_, height_, settings->maxFramerate,
+                          static_cast<uint32_t>(bitrate),
+                          [this](Frame frame, int width, int height, int) { Deliver(std::move(frame), width, height); })
+               ? WEBRTC_VIDEO_CODEC_OK : WEBRTC_VIDEO_CODEC_ERROR;
+  }
+  int32_t RegisterEncodeCompleteCallback(webrtc::EncodedImageCallback* callback) override {
+    callback_ = callback;
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+  int32_t Release() override { session_.Stop(); return WEBRTC_VIDEO_CODEC_OK; }
+  int32_t Encode(const webrtc::VideoFrame& input, const std::vector<webrtc::VideoFrameType>* types) override {
+    if (!session_.healthy() || !callback_) return WEBRTC_VIDEO_CODEC_UNINITIALIZED;
+    if (paused_) return WEBRTC_VIDEO_CODEC_OK;
+    auto pixels = input.video_frame_buffer()->ToI420();
+    if (!pixels || pixels->width() != width_ || pixels->height() != height_) return WEBRTC_VIDEO_CODEC_ERR_PARAMETER;
+    Frame frame;
+    frame.bytes.resize(static_cast<size_t>(width_) * height_ * 3 / 2);
+    if (libyuv::I420ToNV12(pixels->DataY(), pixels->StrideY(), pixels->DataU(), pixels->StrideU(),
+                          pixels->DataV(), pixels->StrideV(), frame.bytes.data(), width_,
+                          frame.bytes.data() + width_ * height_, width_, width_, height_) != 0)
+      return WEBRTC_VIDEO_CODEC_ERROR;
+    frame.rtp_timestamp = input.rtp_timestamp();
+    frame.capture_ms = input.render_time_ms();
+    frame.ntp_ms = input.ntp_time_ms();
+    frame.rotation = input.rotation();
+    frame.key = first_ || (types && std::find(types->begin(), types->end(), webrtc::VideoFrameType::kVideoFrameKey) != types->end());
+    if (!session_.Push(std::move(frame))) return WEBRTC_VIDEO_CODEC_ERROR;
+    first_ = false;
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+  void SetRates(const RateControlParameters& rates) override {
+    if (!std::isfinite(rates.framerate_fps) || rates.framerate_fps < 1 || rates.framerate_fps > 120) return;
+    const uint32_t bitrate = rates.bitrate.get_sum_bps();
+    paused_ = bitrate == 0;
+    if (bitrate && bitrate <= 100000000) session_.Rates(bitrate, static_cast<int>(std::round(rates.framerate_fps)));
+  }
+  EncoderInfo GetEncoderInfo() const override {
+    EncoderInfo info;
+    info.implementation_name = session_.name();
+    info.is_hardware_accelerated = session_.hardware();
+    info.supports_simulcast = false;
+    info.supports_native_handle = false;
+    info.scaling_settings = ScalingSettings::kOff;
+    info.preferred_pixel_formats = {webrtc::VideoFrameBuffer::Type::kI420};
+    return info;
+  }
+ private:
+  void Deliver(Frame frame, int width, int height) {
+    auto* callback = callback_.load();
+    if (!callback) return;
+    webrtc::EncodedImage image;
+    image.SetEncodedData(webrtc::EncodedImageBuffer::Create(frame.bytes.data(), frame.bytes.size()));
+    image._encodedWidth = width;
+    image._encodedHeight = height;
+    image.SetRtpTimestamp(frame.rtp_timestamp);
+    image.SetSimulcastIndex(0);
+    image.capture_time_ms_ = frame.capture_ms;
+    image.ntp_time_ms_ = frame.ntp_ms;
+    image.rotation_ = frame.rotation;
+    image._frameType = frame.key ? webrtc::VideoFrameType::kVideoFrameKey : webrtc::VideoFrameType::kVideoFrameDelta;
+    image.qp_ = -1;
+    webrtc::CodecSpecificInfo info;
+    info.codecType = codec_.type;
+    info.end_of_picture = true;
+    info.scalability_mode = webrtc::ScalabilityMode::kL1T1;
+    if (codec_.type == webrtc::kVideoCodecH264) {
+      info.codecSpecific.H264.packetization_mode = webrtc::H264PacketizationMode::NonInterleaved;
+      info.codecSpecific.H264.temporal_idx = webrtc::kNoTemporalIdx;
+      info.codecSpecific.H264.idr_frame = frame.key;
+    }
+    if (codec_.type == webrtc::kVideoCodecAV1) {
+      auto layers = controller_.NextFrameConfig(frame.key);
+      if (!layers.empty()) {
+        info.generic_frame_info = controller_.OnEncodeDone(layers.front());
+        if (frame.key) info.template_structure = controller_.DependencyStructure();
+      }
+    }
+    if (codec_.type == webrtc::kVideoCodecVP9) {
+      auto& vp9 = info.codecSpecific.VP9;
+      vp9.first_frame_in_picture = true;
+      vp9.flexible_mode = false;
+      vp9.inter_pic_predicted = !frame.key;
+      vp9.temporal_idx = 0;
+      vp9.temporal_up_switch = true;
+      vp9.inter_layer_predicted = false;
+      vp9.first_active_layer = 0;
+      vp9.num_spatial_layers = 1;
+      vp9.gof.SetGofInfoVP9(webrtc::kTemporalStructureMode1);
+      vp9.gof_idx = 0;
+      vp9.ss_data_available = frame.key;
+      vp9.spatial_layer_resolution_present = frame.key;
+      vp9.width[0] = width;
+      vp9.height[0] = height;
+    }
+    callback->OnEncodedImage(image, &info);
+  }
+  Codec codec_;
+  Session session_;
+  std::atomic<webrtc::EncodedImageCallback*> callback_{nullptr};
+  webrtc::ScalableVideoControllerNoLayering controller_;
+  int width_ = 0, height_ = 0;
+  bool paused_ = false, first_ = true;
+};
+
+class Decoder final : public webrtc::VideoDecoder {
+ public:
+  explicit Decoder(Codec codec) : codec_(std::move(codec)) {}
+  ~Decoder() override { Release(); }
+  bool Configure(const Settings& settings) override {
+    if (settings.codec_type() != codec_.type) return false;
+    return session_.Start(codec_, false, 0, 0, 30, 0,
+        [this](Frame frame, int width, int height, int stride) {
+          auto* callback = callback_.load();
+          if (!callback || width <= 0 || height <= 0 || stride < width ||
+              frame.bytes.size() < static_cast<size_t>(stride) * height * 3 / 2) return;
+          auto pixels = webrtc::I420Buffer::Create(width, height);
+          if (libyuv::NV12ToI420(frame.bytes.data(), stride, frame.bytes.data() + stride * height, stride,
+                                pixels->MutableDataY(), pixels->StrideY(), pixels->MutableDataU(), pixels->StrideU(),
+                                pixels->MutableDataV(), pixels->StrideV(), width, height) != 0) return;
+          auto decoded = webrtc::VideoFrame::Builder().set_video_frame_buffer(pixels)
+              .set_timestamp_rtp(frame.rtp_timestamp).build();
+          callback->Decoded(decoded, std::nullopt, std::nullopt);
+        });
+  }
+  int32_t Decode(const webrtc::EncodedImage& input, bool, int64_t) override {
+    if (!session_.healthy() || !callback_) return WEBRTC_VIDEO_CODEC_UNINITIALIZED;
+    if (!input.data() || !input.size() || input.size() > kMaxFrameBytes) return WEBRTC_VIDEO_CODEC_ERR_PARAMETER;
+    Frame frame;
+    frame.bytes.assign(input.data(), input.data() + input.size());
+    frame.rtp_timestamp = input.RtpTimestamp();
+    frame.key = input._frameType == webrtc::VideoFrameType::kVideoFrameKey;
+    return session_.Push(std::move(frame)) ? WEBRTC_VIDEO_CODEC_OK : WEBRTC_VIDEO_CODEC_ERROR;
+  }
+  int32_t RegisterDecodeCompleteCallback(webrtc::DecodedImageCallback* callback) override {
+    callback_ = callback;
+    return WEBRTC_VIDEO_CODEC_OK;
+  }
+  int32_t Release() override { session_.Stop(); return WEBRTC_VIDEO_CODEC_OK; }
+  DecoderInfo GetDecoderInfo() const override { return {session_.name(), session_.hardware()}; }
+ private:
+  Codec codec_;
+  Session session_;
+  std::atomic<webrtc::DecodedImageCallback*> callback_{nullptr};
+};
+
+std::vector<Codec> Available(bool encode) {
+  ComRuntime runtime;
+  std::vector<Codec> result;
+  if (FAILED(runtime.mf)) return result;
+  for (const auto& codec : Codecs()) {
+    if (Enumerate(codec, encode).empty()) continue;
+    if (!encode) {
+      ComPtr<ID3D11Device> device;
+      ComPtr<ID3D11DeviceContext> context;
+      if (!HardwareDecoderDevice(codec.type, device, context)) continue;
+    }
+    result.push_back(codec);
+  }
+  return result;
+}
+
+class EncoderFactory final : public webrtc::VideoEncoderFactory {
+ public:
+  EncoderFactory() : codecs_(Available(true)) {}
+  std::vector<SdpVideoFormat> GetSupportedFormats() const override {
+    std::vector<SdpVideoFormat> result;
+    for (const auto& codec : codecs_) result.push_back(codec.format);
+    return result;
+  }
+  CodecSupport QueryCodecSupport(const SdpVideoFormat& format, std::optional<std::string> mode) const override {
+    return {format.IsCodecInList(GetSupportedFormats()) && (!mode || *mode == "L1T1"), false};
+  }
+  std::unique_ptr<webrtc::VideoEncoder> Create(const webrtc::Environment&, const SdpVideoFormat& format) override {
+    for (const auto& codec : codecs_) {
+      if (codec.format.IsSameCodec(format)) {
+        Codec negotiated = codec;
+        negotiated.format = format;
+        return std::make_unique<Encoder>(std::move(negotiated));
+      }
+    }
+    return nullptr;
+  }
+ private:
+  std::vector<Codec> codecs_;
+};
+
+class DecoderFactory final : public webrtc::VideoDecoderFactory {
+ public:
+  DecoderFactory() : codecs_(Available(false)) {}
+  std::vector<SdpVideoFormat> GetSupportedFormats() const override {
+    std::vector<SdpVideoFormat> result;
+    for (const auto& codec : codecs_) result.push_back(codec.format);
+    return result;
+  }
+  CodecSupport QueryCodecSupport(const SdpVideoFormat& format, bool reference_scaling) const override {
+    return {format.IsCodecInList(GetSupportedFormats()) && !reference_scaling, false};
+  }
+  std::unique_ptr<webrtc::VideoDecoder> Create(const webrtc::Environment&, const SdpVideoFormat& format) override {
+    for (const auto& codec : codecs_) {
+      if (codec.format.IsSameCodec(format)) {
+        Codec negotiated = codec;
+        negotiated.format = format;
+        return std::make_unique<Decoder>(std::move(negotiated));
+      }
+    }
+    return nullptr;
+  }
+ private:
+  std::vector<Codec> codecs_;
+};
+}  // namespace
+
+std::unique_ptr<webrtc::VideoEncoderFactory> CreateMediaFoundationVideoEncoderFactory() {
+  return std::make_unique<EncoderFactory>();
+}
+std::unique_ptr<webrtc::VideoDecoderFactory> CreateMediaFoundationVideoDecoderFactory() {
+  return std::make_unique<DecoderFactory>();
+}
+}  // namespace livekit_ffi
