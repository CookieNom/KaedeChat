+const GUID* DecoderProfile(webrtc::VideoCodecType codec) {
+  switch (codec) {
+    case webrtc::kVideoCodecH264: return &D3D11_DECODER_PROFILE_H264_VLD_NOFGT;
+    case webrtc::kVideoCodecH265: return &D3D11_DECODER_PROFILE_HEVC_VLD_MAIN;
+    case webrtc::kVideoCodecAV1: return &D3D11_DECODER_PROFILE_AV1_VLD_PROFILE0;
+    case webrtc::kVideoCodecVP9: return &D3D11_DECODER_PROFILE_VP9_VLD_PROFILE0;
+    default: return nullptr;
+  }
+}
+
+bool HardwareDecoderDevice(webrtc::VideoCodecType codec, ComPtr<ID3D11Device>& device,
+                           ComPtr<ID3D11DeviceContext>& context) {
+  const GUID* profile = DecoderProfile(codec);
+  if (!profile) return false;
+  ComPtr<IDXGIFactory1> factory;
+  if (FAILED(CreateDXGIFactory1(IID_PPV_ARGS(&factory)))) return false;
+  for (UINT index = 0; index < 32; ++index) {
+    ComPtr<IDXGIAdapter1> adapter;
+    if (factory->EnumAdapters1(index, &adapter) == DXGI_ERROR_NOT_FOUND) break;
+    DXGI_ADAPTER_DESC1 desc{};
+    if (!adapter || FAILED(adapter->GetDesc1(&desc)) || (desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE)) continue;
+    ComPtr<ID3D11Device> candidate;
+    ComPtr<ID3D11DeviceContext> candidate_context;
+    D3D_FEATURE_LEVEL actual;
+    if (FAILED(D3D11CreateDevice(adapter.Get(), D3D_DRIVER_TYPE_UNKNOWN, nullptr,
+              D3D11_CREATE_DEVICE_VIDEO_SUPPORT | D3D11_CREATE_DEVICE_BGRA_SUPPORT,
+              nullptr, 0, D3D11_SDK_VERSION, &candidate, &actual, &candidate_context))) continue;
+    ComPtr<ID3D11VideoDevice> video;
+    if (FAILED(candidate.As(&video))) continue;
+    BOOL nv12 = FALSE;
+    if (FAILED(video->CheckVideoDecoderFormat(profile, DXGI_FORMAT_NV12, &nv12)) || !nv12) continue;
+    bool supported = false;
+    for (UINT i = 0; i < video->GetVideoDecoderProfileCount(); ++i) {
+      GUID available = GUID_NULL;
+      if (SUCCEEDED(video->GetVideoDecoderProfile(i, &available)) && available == *profile) {
+        supported = true;
+        break;
+      }
+    }
+    if (!supported) continue;
+    ComPtr<ID3D10Multithread> multithread;
+    if (FAILED(candidate.As(&multithread)) && FAILED(candidate_context.As(&multithread))) continue;
+    multithread->SetMultithreadProtected(TRUE);
+    device = std::move(candidate);
+    context = std::move(candidate_context);
+    return true;
+  }
+  return false;
+}
+
+std::string Implementation(IMFActivate* activation) {
+  wchar_t* name = nullptr;
+  UINT32 length = 0;
+  if (FAILED(activation->GetAllocatedString(MFT_FRIENDLY_NAME_Attribute, &name, &length)))
+    return "MediaFoundation hardware MFT";
+  const int size = WideCharToMultiByte(CP_UTF8, 0, name, length, nullptr, 0, nullptr, nullptr);
+  std::string result(std::max(0, size), '\0');
+  if (size > 0) WideCharToMultiByte(CP_UTF8, 0, name, length, result.data(), size, nullptr, nullptr);
+  CoTaskMemFree(name);
+  return "MediaFoundation " + result;
+}
