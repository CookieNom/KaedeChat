+bool SetBool(ICodecAPI* api, const GUID& key, bool enabled) {
+  if (!api) return false;
+  VARIANT value;
+  VariantInit(&value);
+  value.vt = VT_BOOL;
+  value.boolVal = enabled ? VARIANT_TRUE : VARIANT_FALSE;
+  return SUCCEEDED(api->SetValue(&key, &value));
+}
+
+bool SetUInt(ICodecAPI* api, const GUID& key, UINT32 number) {
+  if (!api) return false;
+  VARIANT value;
+  VariantInit(&value);
+  value.vt = VT_UI4;
+  value.ulVal = number;
+  return SUCCEEDED(api->SetValue(&key, &value));
+}
+
+ComPtr<IMFMediaType> MediaType(const GUID& subtype, int width, int height, int fps) {
+  ComPtr<IMFMediaType> type;
+  if (FAILED(MFCreateMediaType(&type)) ||
+      FAILED(type->SetGUID(MF_MT_MAJOR_TYPE, MFMediaType_Video)) ||
+      FAILED(type->SetGUID(MF_MT_SUBTYPE, subtype)) ||
+      FAILED(type->SetUINT32(MF_MT_INTERLACE_MODE, MFVideoInterlace_Progressive)) ||
+      FAILED(MFSetAttributeRatio(type.Get(), MF_MT_PIXEL_ASPECT_RATIO, 1, 1))) return nullptr;
+  if (width > 0 && height > 0 &&
+      FAILED(MFSetAttributeSize(type.Get(), MF_MT_FRAME_SIZE, width, height))) return nullptr;
+  if (fps > 0 && FAILED(MFSetAttributeRatio(type.Get(), MF_MT_FRAME_RATE, fps, 1))) return nullptr;
+  return type;
+}
