+std::vector<ComPtr<IMFActivate>> Enumerate(const Codec& codec, bool encode) {
+  MFT_REGISTER_TYPE_INFO compressed{MFMediaType_Video, *codec.subtype};
+  MFT_REGISTER_TYPE_INFO raw{MFMediaType_Video, MFVideoFormat_NV12};
+  const UINT32 flags = MFT_ENUM_FLAG_HARDWARE | MFT_ENUM_FLAG_SORTANDFILTER |
+      (encode ? 0 : MFT_ENUM_FLAG_SYNCMFT | MFT_ENUM_FLAG_ASYNCMFT | MFT_ENUM_FLAG_LOCALMFT);
+  auto enumerate2 = reinterpret_cast<decltype(&MFTEnum2)>(
+      GetProcAddress(GetModuleHandleW(L"mfplat.dll"), "MFTEnum2"));
+  std::vector<ComPtr<IMFActivate>> result;
+  auto collect = [&](IMFAttributes* attributes, const LUID* luid) {
+    IMFActivate** values = nullptr;
+    UINT32 count = 0;
+    const GUID category = encode ? MFT_CATEGORY_VIDEO_ENCODER : MFT_CATEGORY_VIDEO_DECODER;
+    HRESULT hr = attributes && enumerate2
+        ? enumerate2(category, flags, encode ? &raw : &compressed,
+                     encode ? &compressed : &raw, attributes, &values, &count)
+        : MFTEnumEx(category, flags, encode ? &raw : &compressed,
+                    encode ? &compressed : &raw, &values, &count);
+    if (SUCCEEDED(hr)) {
+      for (UINT32 i = 0; i < count; ++i) {
+        ComPtr<IMFActivate> activation;
+        activation.Attach(values[i]);
+        UINT32 length = 0;
+        const bool hardware = SUCCEEDED(activation->GetStringLength(MFT_ENUM_HARDWARE_URL_Attribute, &length)) && length > 0;
+        if (encode && !hardware) continue;
+        // This registered Intel MFT is a hybrid AV1 encoder, not fixed-function
+        // hardware. Chromium excludes the same implementation from HW encoding.
+        constexpr GUID hybrid_av1 = {0x62c053ce, 0x5357, 0x4794,
+            {0x8c, 0x5a, 0xfb, 0xef, 0xfe, 0xff, 0xb8, 0x2d}};
+        GUID clsid = GUID_NULL;
+        if (encode && codec.type == webrtc::kVideoCodecAV1 &&
+            SUCCEEDED(activation->GetGUID(MFT_TRANSFORM_CLSID_Attribute, &clsid)) && clsid == hybrid_av1) continue;
+        if (luid) activation->SetBlob(MFT_ENUM_ADAPTER_LUID,
+            reinterpret_cast<const BYTE*>(luid), sizeof(*luid));
+        result.push_back(std::move(activation));
+      }
+    }
+    CoTaskMemFree(values);
+  };
+  if (encode && enumerate2) {
+    ComPtr<IDXGIFactory1> factory;
+    if (FAILED(CreateDXGIFactory1(IID_PPV_ARGS(&factory)))) return result;
+    // Enumerate every physical adapter, including an Intel iGPU alongside a
+    // discrete GPU. MFTEnumEx alone does not reliably select every adapter.
+    for (UINT index = 0; index < 32; ++index) {
+      ComPtr<IDXGIAdapter1> adapter;
+      if (factory->EnumAdapters1(index, &adapter) == DXGI_ERROR_NOT_FOUND) break;
+      DXGI_ADAPTER_DESC1 desc{};
+      if (!adapter || FAILED(adapter->GetDesc1(&desc)) || (desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE)) continue;
+      ComPtr<IMFAttributes> attributes;
+      if (FAILED(MFCreateAttributes(&attributes, 1)) ||
+          FAILED(attributes->SetBlob(MFT_ENUM_ADAPTER_LUID,
+              reinterpret_cast<const BYTE*>(&desc.AdapterLuid), sizeof(LUID)))) continue;
+      collect(attributes.Get(), &desc.AdapterLuid);
+    }
+  } else collect(nullptr, nullptr);
+  return result;
+}
