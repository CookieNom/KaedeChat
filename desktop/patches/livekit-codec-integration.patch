diff --git a/webrtc-sys/src/av1_e2ee/h26x_frame.h b/webrtc-sys/src/av1_e2ee/h26x_frame.h
new file mode 100644
index 0000000..99312dd
--- /dev/null
+++ b/webrtc-sys/src/av1_e2ee/h26x_frame.h
@@ -0,0 +1,79 @@
+// Copyright 2026 Kaede Chat contributors. SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <vector>
+
+namespace kaede_h26x {
+inline size_t StartCode(std::span<const uint8_t> data, size_t offset) {
+  if (offset + 3 <= data.size() && data[offset] == 0 && data[offset + 1] == 0) {
+    if (data[offset + 2] == 1) return 3;
+    if (offset + 4 <= data.size() && data[offset + 2] == 0 && data[offset + 3] == 1) return 4;
+  }
+  return 0;
+}
+
+inline std::optional<size_t> ClearPrefix(std::span<const uint8_t> data, bool hevc) {
+  if (!StartCode(data, 0)) return std::nullopt;
+  for (size_t offset = 0; offset < data.size(); ++offset) {
+    const size_t start = StartCode(data, offset);
+    if (!start) continue;
+    offset += start;
+    if (offset + 2 > data.size()) return std::nullopt;
+    const uint8_t type = hevc ? (data[offset] >> 1) & 0x3f : data[offset] & 0x1f;
+    const bool slice = hevc ? (type <= 9 || (type >= 16 && type <= 21)) : (type == 1 || type == 5);
+    if (slice) return offset + 2;
+  }
+  return std::nullopt;
+}
+
+inline std::vector<uint8_t> NormalizeHeader(std::span<const uint8_t> header) {
+  std::vector<uint8_t> result;
+  result.reserve(header.size());
+  for (size_t offset = 0; offset < header.size();) {
+    const size_t start = StartCode(header, offset);
+    if (start) {
+      result.insert(result.end(), {0, 0, 0, 1});
+      offset += start;
+    } else {
+      result.push_back(header[offset++]);
+    }
+  }
+  return result;
+}
+// Keep the legacy two-byte wire prefix while hardware H.264 receivers inspect PPS ids.
+inline std::optional<uint32_t> H264PpsId(std::span<const uint8_t> nalu) {
+  if (nalu.empty() || (nalu[0] & 0x1f) != 5) return std::nullopt;
+  std::vector<uint8_t> rbsp;
+  for (size_t i = 1; i < nalu.size() && i < 17; ++i) {
+    if (i >= 3 && nalu[i] == 3 && nalu[i - 1] == 0 && nalu[i - 2] == 0) continue;
+    rbsp.push_back(nalu[i]);
+  }
+  size_t bit = 0;
+  auto read = [&]() -> std::optional<uint32_t> {
+    if (bit >= rbsp.size() * 8) return std::nullopt;
+    const size_t current = bit++;
+    return (rbsp[current / 8] >> (7 - (current % 8))) & 1;
+  };
+  uint32_t value = 0;
+  for (int field = 0; field < 3; ++field) {
+    size_t zeros = 0;
+    while (true) {
+      const auto next = read();
+      if (!next || zeros >= 31) return std::nullopt;
+      if (*next) break;
+      ++zeros;
+    }
+    value = 1;
+    for (size_t i = 0; i < zeros; ++i) {
+      const auto next = read();
+      if (!next) return std::nullopt;
+      value = (value << 1) | *next;
+    }
+    --value;
+  }
+  return value;
+}
+}  // namespace kaede_h26x
diff --git a/webrtc-sys/src/av1_e2ee/h26x_frame_test.cpp b/webrtc-sys/src/av1_e2ee/h26x_frame_test.cpp
new file mode 100644
index 0000000..f8f5488
--- /dev/null
+++ b/webrtc-sys/src/av1_e2ee/h26x_frame_test.cpp
@@ -0,0 +1,35 @@
+// Copyright 2026 Kaede Chat contributors. SPDX-License-Identifier: Apache-2.0
+#include "h26x_frame.h"
+#include <cassert>
+
+int main() {
+  for (bool hevc : {false, true}) {
+    for (size_t length : {3, 4}) {
+      std::vector<uint8_t> frame(length - 1, 0);
+      frame.push_back(1);
+      frame.push_back(hevc ? 0x40 : 0x67);
+      frame.push_back(1);
+      frame.insert(frame.end(), 300, 0x55);
+      frame.insert(frame.end(), length - 1, 0);
+      frame.push_back(1);
+      frame.push_back(hevc ? 0x26 : 0x65);
+      frame.push_back(1);
+      const size_t prefix = frame.size();
+      frame.insert(frame.end(), {0x80, 11, 22, 33, 44});
+      assert(kaede_h26x::ClearPrefix(frame, hevc) == prefix);
+      const auto header = kaede_h26x::NormalizeHeader(std::span(frame).first(prefix));
+      assert(header.size() == prefix + 2 * (4 - length));
+      assert(kaede_h26x::ClearPrefix(header, hevc) == header.size());
+      assert(kaede_h26x::NormalizeHeader(header) == header);
+      assert(!kaede_h26x::ClearPrefix(std::span(frame).first(prefix - 1), hevc));
+    }
+  }
+  assert(!kaede_h26x::ClearPrefix({}, true));
+  const uint8_t invalid[] = {0, 0, 1};
+  assert(!kaede_h26x::ClearPrefix(invalid, true));
+  const uint8_t intel[] = {0x65, 0x88, 0x80, 0x40, 0x87, 0x0a};
+  const uint8_t changed[] = {0x65, 0x88, 0x5f, 0xff};
+  assert(kaede_h26x::H264PpsId(intel) == 0);
+  assert(kaede_h26x::H264PpsId(changed) == 1);
+  assert(!kaede_h26x::H264PpsId(std::span(intel).first(2)));
+}
