diff --git a/sdk/objc/components/video_codec/RTCVideoDecoderH265.mm b/sdk/objc/components/video_codec/RTCVideoDecoderH265.mm
index b0d0601..b9959ba 100644
--- a/sdk/objc/components/video_codec/RTCVideoDecoderH265.mm
+++ b/sdk/objc/components/video_codec/RTCVideoDecoderH265.mm
@@ -436,13 +436,33 @@ CMSampleBufferRef H265BufferToCMSampleBuffer(const uint8_t *buffer, size_t buffe
       h265DecompressionOutputCallback,
       (__bridge void *)self,
   };
-  OSStatus status = VTDecompressionSessionCreate(nullptr, _videoFormat, nullptr, attributes,
-                                                 &record, &_decompressionSession);
+  NSDictionary* decoderSpecs;
+  if (@available(iOS 17.0, macCatalyst 17.0, macOS 10.13, tvOS 17.0, visionOS 1.0, *)) {
+    decoderSpecs = @{
+      (__bridge NSString*)kVTVideoDecoderSpecification_RequireHardwareAcceleratedVideoDecoder: @YES
+    };
+  } else {
+    CFRelease(attributes);
+    return WEBRTC_VIDEO_CODEC_ERROR;
+  }
+  OSStatus status = VTDecompressionSessionCreate(nullptr, _videoFormat,
+      (__bridge CFDictionaryRef)decoderSpecs, attributes, &record, &_decompressionSession);
   CFRelease(attributes);
   if (status != noErr) {
     [self destroyDecompressionSession];
     return WEBRTC_VIDEO_CODEC_ERROR;
   }
+  if (@available(iOS 17.0, macCatalyst 17.0, macOS 10.13, tvOS 17.0, visionOS 1.0, *)) {
+    CFBooleanRef hardware = nullptr;
+    status = VTSessionCopyProperty(_decompressionSession,
+        kVTDecompressionPropertyKey_UsingHardwareAcceleratedVideoDecoder, kCFAllocatorDefault, &hardware);
+    const bool proven = status == noErr && hardware && CFBooleanGetValue(hardware);
+    if (hardware) CFRelease(hardware);
+    if (!proven) {
+      [self destroyDecompressionSession];
+      return WEBRTC_VIDEO_CODEC_ERROR;
+    }
+  }
   [self configureDecompressionSession];
 
   return WEBRTC_VIDEO_CODEC_OK;
