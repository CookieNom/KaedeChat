@@ -20,6 +20,12 @@
 #include "rust/cxx.h"
 #include "webrtc-sys/src/rtc_error.rs.h"
 
+#if defined(_MSC_VER)
+static_assert(
+    _HAS_EXCEPTIONS == 1,
+    "webrtc-sys must be compiled with _HAS_EXCEPTIONS=1 to match cxx");
