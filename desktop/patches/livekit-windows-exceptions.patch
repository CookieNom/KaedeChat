diff --git a/webrtc-sys/build.rs b/webrtc-sys/build.rs
--- a/webrtc-sys/build.rs
+++ b/webrtc-sys/build.rs
@@ -152,6 +152,14 @@ fn main() {
     );
 
     for (key, value) in webrtc_sys_build::webrtc_defines() {
+        // webrtc.ninja defines _HAS_EXCEPTIONS=0 on Windows, while webrtc-sys
+        // compiles with /EHsc and links against cxx (built with _HAS_EXCEPTIONS=1).
+        // Keeping _HAS_EXCEPTIONS=0 causes an ODR mismatch on std::exception
+        // (stdext::exception vs std::exception) and std::runtime_error (16 vs 24
+        // bytes), corrupting stack locals and aborting in std::terminate() on throw.
+        if target_os == "windows" && key == "_HAS_EXCEPTIONS" {
+            continue;
+        }
         let value = value.as_deref();
         builder.define(key.as_str(), value);
     }
diff --git a/webrtc-sys/include/livekit/rtc_error.h b/webrtc-sys/include/livekit/rtc_error.h
