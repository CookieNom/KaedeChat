+inline HMODULE NvidiaDriverLibrary(bool decoder) {
+  // Never search the working directory for an executable driver library.
+  static HMODULE cuda = LoadLibraryExW(L"nvcuda.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
+  static HMODULE nvdec = LoadLibraryExW(L"nvcuvid.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
+  return decoder ? nvdec : cuda;
