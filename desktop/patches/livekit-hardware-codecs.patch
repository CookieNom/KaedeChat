+  template<typename... Args> inline CUresult Kaede_##symbol(Args&&... args) { \
+    static const auto function = reinterpret_cast<KaedeType_##symbol>( \
+        NvidiaDriverLibrary(decoder) ? GetProcAddress(NvidiaDriverLibrary(decoder), KAEDE_DRIVER_STRING(symbol)) : nullptr); \
+    return function ? function(std::forward<Args>(args)...) : CUDA_ERROR_NOT_INITIALIZED; \
