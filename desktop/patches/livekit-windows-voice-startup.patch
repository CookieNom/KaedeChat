diff --git a/webrtc-sys/src/kaede_voice_startup.h b/webrtc-sys/src/kaede_voice_startup.h
new file mode 100644
index 0000000..d57873e
--- /dev/null
+++ b/webrtc-sys/src/kaede_voice_startup.h
@@ -0,0 +1,43 @@
+#pragma once
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace livekit_ffi {
+
+// Only the literal value "1" enables these Windows desktop experiments.
+inline bool WindowsVoiceFlag(const char* name) {
+#if defined(_WIN32)
+  const char* value = std::getenv(name);
+  return value && std::strcmp(value, "1") == 0;
+#else
+  return false;
+#endif
+}
+
+class VoiceStartupTimer {
+ public:
+  explicit VoiceStartupTimer(const char* stage) : stage_(stage) {
+    if (Enabled()) started_ = Clock::now();
+  }
+
+  ~VoiceStartupTimer() {
+    if (!Enabled()) return;
+    auto ms = std::chrono::duration<double, std::milli>(Clock::now() - started_);
+    std::fprintf(stderr, "kaede voice startup: %s %.3f ms\n", stage_, ms.count());
+  }
+
+ private:
+  static bool Enabled() {
+    static const bool enabled = WindowsVoiceFlag("KAEDE_VOICE_TIMINGS");
+    return enabled;
+  }
+
+  using Clock = std::chrono::steady_clock;
+  const char* stage_;
+  Clock::time_point started_;
+};
+
+}  // namespace livekit_ffi
