{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kaede Chat",
  "version": "0.1.14",
  "identifier": "chat.kaede.desktop.tauri",
  "build": {
    "frontendDist": "../../../frontend/build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "freezePrototype": true,
      "capabilities": ["main"]
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Self-hosted federated chat",
    "longDescription": "A native client for Kaede Chat federated communities.",
    "targets": "all",
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Kaede Chat"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/CookieNom/KaedeChat/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzRTAwNUI1MTBDOTczRjEKUldUeGM4a1F0UVhnczk4ZXJTTk5WZFhlSXVjWjV4cjZRUkhldklUYWNRb09rQ2s5OFJjTFZZdWkK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
