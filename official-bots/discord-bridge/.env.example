# Discord Developer Portal -> your application -> Bot -> Token.
# Use the bot token, not the application ID or OAuth2 client secret.
DISCORD_TOKEN=replace-with-discord-bot-token

# The KaedeChat instance where you CREATED the application.
# Use an HTTPS origin: no /developers path and no trailing slash.
KAEDE_APPLICATION_HOME=https://apps.example

# From the Kaede application page URL: /developers/123@apps.example
# Keep the numeric application ID AND @domain. Replace URL-encoded %40 with @.
# This domain must match KAEDE_APPLICATION_HOME above.
KAEDE_APPLICATION_REF=123@apps.example

# Do not add a control credential, worker key, or PyPI token here.
# README step 5 prompts for the control credential once and generates keys for you.

# Your HUMAN Kaede user ID (Developer mode -> your profile -> Copy user ID).
# These operators may pair channels from ANY Discord server this bot has joined.
# Comma-separated full IDs; each also needs Manage Server in the Kaede server.
KAEDE_BRIDGE_ADMIN_REFS=12345@apps.example
