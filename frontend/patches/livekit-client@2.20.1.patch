@@ -0,0 +1,56 @@
+import { describe, expect, it } from 'vitest';
+import { parseAv1, scatterAv1, sealAv1 } from './av1Frame';
+
+const input = new Uint8Array([0x12, 0, 0x0a, 2, 0, 0xaa, 0x32, 5, 0, 11, 22, 33, 44]);
+const iv = new Uint8Array(12).map((_, i) => i);
+async function key(value = 1) {
+  return crypto.subtle.importKey('raw', new Uint8Array(16).fill(value), 'AES-GCM', false, ['encrypt', 'decrypt']);
+}
+async function encrypted() {
+  const layout = parseAv1(input, false, 3);
+  const cipher = await crypto.subtle.encrypt({name: 'AES-GCM', iv, additionalData: layout.aad}, await key(), layout.protectedBytes);
+  return sealAv1(layout, new Uint8Array(cipher), iv);
+}
+async function decrypt(frame: Uint8Array, keyValue = 1) {
+  const layout = parseAv1(frame, true);
+  const cipher = new Uint8Array(layout.protectedBytes.length + 16);
+  cipher.set(layout.protectedBytes);
+  cipher.set(layout.tag, layout.protectedBytes.length);
+  const plain = await crypto.subtle.decrypt({name: 'AES-GCM', iv:layout.iv, additionalData: layout.aad}, await key(keyValue), cipher);
+  return scatterAv1(layout, new Uint8Array(plain));
+}
+describe('AV1 authenticated framing', () => {
+  it('round trips the canonical RTP form and retains structural bytes', async () => {
+    const wire = await encrypted();
+    expect(Array.from(wire, (byte) => byte.toString(16).padStart(2, '0')).join('')).toBe('0a0200aa320500134cec922a2504ffff4b41453101000102030405060708090a0bdd1b98b56553ef874a121bfd0cbdfa9803');
+    expect(await decrypt(wire)).toEqual(input.slice(2));
+    expect(wire.slice(0, 7)).toEqual(input.slice(2, 9));
+    expect(wire.slice(7, 11)).not.toEqual(input.slice(9));
+    expect(parseAv1(wire, true).keyIndex).toBe(3);
+  });
+  it('authenticates every byte, including clear headers, lengths and key index', async () => {
+    const wire = await encrypted();
+    for (let i = 0; i < wire.length; i++) {
+      const bad = wire.slice();
+      bad[i] ^= 1;
+      // A size-present bit is deliberately normalized by RTP; semantic-equivalent
+      // alternate size encodings are tested separately, all other edits must fail.
+      await expect(decrypt(bad)).rejects.toThrow();
+    }
+    await expect(decrypt(wire, 2)).rejects.toThrow();
+  });
+  it('rejects every truncated prefix in the AV1 helper', async () => {
+    const wire = await encrypted();
+    for (let length = 0; length < wire.length; length++) {
+      await expect(decrypt(wire.slice(0, length))).rejects.toThrow();
+    }
+  });
+  it('normalizes size fields, implicit final lengths and stripped OBUs', () => {
+    const canonical = parseAv1(new Uint8Array([0x32, 2, 0, 11]), false);
+    expect(parseAv1(new Uint8Array([0x30, 0, 11]), false).aad).toEqual(canonical.aad);
+    expect(parseAv1(new Uint8Array([0x32, 0x82, 0, 0, 11]), false).frame).toEqual(canonical.frame);
+    for (const bad of [[0x80], [0x32, 255], [0x36], [0x36, 1, 0], [0x32, 255,255,255,255,255,255,255,255]]) {
+      expect(() => parseAv1(new Uint8Array(bad), false)).toThrow();
+    }
+  });
+});
