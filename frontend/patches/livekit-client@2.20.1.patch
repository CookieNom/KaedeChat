new file mode 100644
index 0000000000000000000000000000000000000000..423396cea1ef33ab666e29e1d24613ffe9c6cc2a
--- /dev/null
+++ b/src/e2ee/worker/av1Frame.ts
@@ -0,0 +1,110 @@
+// Copyright 2026 Kaede Chat contributors. SPDX-License-Identifier: Apache-2.0
+// Wire format must match webrtc-sys/src/av1_e2ee/av1_frame.h.
+const MARKER = new Uint8Array([4, 255, 255, 75, 65, 69, 49, 1]);
+const MAX_FRAME_SIZE = 16 * 1024 * 1024;
+const METADATA_SIZE = 37;
+export interface Av1Layout {
+  frame: Uint8Array<ArrayBuffer>;
+  aad: Uint8Array<ArrayBuffer>;
+  protectedBytes: Uint8Array<ArrayBuffer>;
+  ranges: Array<{ offset: number; length: number }>;
+  iv: Uint8Array<ArrayBuffer>;
+  tag: Uint8Array<ArrayBuffer>;
+  keyIndex: number;
+}
+function leb(out: number[], value: number) {
+  do {
+    const byte = value & 127;
+    value = Math.floor(value / 128);
+    out.push(byte | (value ? 128 : 0));
+  } while (value);
+}
+function append(out: number[], input: Uint8Array | number[]) {
+  for (const byte of input) out.push(byte);
+}
+function matchesMarker(payload: Uint8Array) {
+  return payload.length >= MARKER.length && MARKER.every((byte, i) => payload[i] === byte);
+}
+export function parseAv1(input: Uint8Array, decrypt: boolean, keyIndex = 0): Av1Layout {
+  const fail = (): never => { throw new Error('invalid AV1 E2EE frame'); };
+  if (!input.length || input.length > MAX_FRAME_SIZE) fail();
+  const frame: number[] = [], clear: number[] = [], protectedBytes: number[] = [];
+  const ranges: Av1Layout['ranges'] = [];
+  let iv = new Uint8Array(0), tag = new Uint8Array(0);
+  let offset = 0, count = 0, metadata = false;
+  while (offset < input.length) {
+    if (++count > 4096) fail();
+    const header = input[offset++], type = (header >> 3) & 15;
+    if ((header & 0x81) || type === 0 || (type >= 9 && type <= 14)) fail();
+    const prefix = [header | 2];
+    if (header & 4) {
+      if (offset === input.length || (input[offset] & 7)) fail();
+      prefix.push(input[offset++]);
+    }
+    let size = input.length - offset;
+    if (header & 2) {
+      size = 0;
+      let terminated = false;
+      for (let i = 0; i < 8; i++) {
+        if (offset === input.length) fail();
+        const byte = input[offset++];
+        if (i >= 4 && (byte & 127)) fail();
+        if (i < 4) size += (byte & 127) * 2 ** (7 * i);
+        if (!(byte & 128)) { terminated = true; break; }
+      }
+      if (!terminated || size > input.length - offset) fail();
+    }
+    const payload = input.subarray(offset, offset + size);
+    offset += size;
+    if (type === 2 || type === 8 || type === 15) {
+      if (decrypt) fail();
+      continue;
+    }
+    if (type === 5 && matchesMarker(payload)) {
+      if (!decrypt || header !== 0x2a || size !== METADATA_SIZE || offset !== input.length) fail();
+      iv = payload.slice(8, 20);
+      tag = payload.slice(20, 36);
+      keyIndex = payload[36];
+      metadata = true;
+      break;
+    }
+    leb(prefix, size);
+    const clearSize = type === 1 ? size : ((type === 3 || type === 6) ? Math.min(size, 1) : 0);
+    append(clear, prefix);
+    append(clear, payload.subarray(0, clearSize));
+    append(frame, prefix);
+    append(frame, payload);
+    const length = size - clearSize;
+    ranges.push({ offset: frame.length - length, length });
+    append(protectedBytes, payload.subarray(clearSize));
+  }
+  if (!frame.length || (decrypt && !metadata)) fail();
+  const aad = Array.from(MARKER);
+  aad.push(keyIndex);
+  append(aad, clear);
+  return { frame: new Uint8Array(frame), aad: new Uint8Array(aad), protectedBytes: new Uint8Array(protectedBytes), ranges, iv, tag, keyIndex };
+}
+export function scatterAv1(layout: Av1Layout, bytes: Uint8Array): Uint8Array<ArrayBuffer> {
+  if (bytes.length !== layout.protectedBytes.length) throw new Error('invalid AV1 ciphertext size');
+  const frame = layout.frame.slice();
+  let offset = 0;
+  for (const range of layout.ranges) {
+    frame.set(bytes.subarray(offset, offset + range.length), range.offset);
+    offset += range.length;
+  }
+  return frame;
+}
+export function sealAv1(layout: Av1Layout, cipher: Uint8Array, iv: Uint8Array): Uint8Array<ArrayBuffer> {
+  if (cipher.length < 16 || iv.length !== 12) throw new Error('invalid AV1 crypto metadata');
+  const frame = scatterAv1(layout, cipher.subarray(0, cipher.length - 16));
+  const metadata = new Uint8Array(2 + METADATA_SIZE);
+  metadata.set([0x2a, METADATA_SIZE]);
+  metadata.set(MARKER, 2);
+  metadata.set(iv, 10);
+  metadata.set(cipher.subarray(cipher.length - 16), 22);
+  metadata[38] = layout.keyIndex;
+  const result = new Uint8Array(frame.length + metadata.length);
+  result.set(frame);
+  result.set(metadata, frame.length);
+  return result;
+}
