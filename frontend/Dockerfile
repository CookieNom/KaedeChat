# syntax=docker/dockerfile:1.7
FROM node:22.23.1-bookworm-slim AS dependencies
ENV COREPACK_HOME=/opt/corepack
RUN corepack enable \
    && corepack prepare pnpm@10.34.0 --activate \
    && chmod -R a=rX /opt/corepack
WORKDIR /workspace
RUN chown node:node /workspace
USER node
COPY --chown=node:node package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM dependencies AS development
ARG KAEDE_MEDIA_PUBLIC_BASE_URL
ARG KAEDE_MEDIA_UPLOAD_ORIGINS
ARG KAEDE_MEDIA_S3_ADDRESSING_STYLE=path
ARG KAEDE_MEDIA_ATTACHMENTS_BUCKET=kaede-attachments
ARG KAEDE_LANDING_PAGE=default
ARG KAEDE_LEGAL_INSTANCE_NAME
ARG KAEDE_LEGAL_OPERATOR_NAME
ARG KAEDE_LEGAL_CONTACT_EMAIL
ARG KAEDE_LEGAL_EFFECTIVE_DATE
ARG KAEDE_LEGAL_MINIMUM_AGE
ARG KAEDE_LEGAL_JURISDICTION
ENV KAEDE_MEDIA_PUBLIC_BASE_URL=${KAEDE_MEDIA_PUBLIC_BASE_URL}
ENV KAEDE_MEDIA_UPLOAD_ORIGINS=${KAEDE_MEDIA_UPLOAD_ORIGINS}
ENV KAEDE_MEDIA_S3_ADDRESSING_STYLE=${KAEDE_MEDIA_S3_ADDRESSING_STYLE}
ENV KAEDE_MEDIA_ATTACHMENTS_BUCKET=${KAEDE_MEDIA_ATTACHMENTS_BUCKET}
ENV KAEDE_LANDING_PAGE=${KAEDE_LANDING_PAGE}
ENV KAEDE_LEGAL_INSTANCE_NAME=${KAEDE_LEGAL_INSTANCE_NAME}
ENV KAEDE_LEGAL_OPERATOR_NAME=${KAEDE_LEGAL_OPERATOR_NAME}
ENV KAEDE_LEGAL_CONTACT_EMAIL=${KAEDE_LEGAL_CONTACT_EMAIL}
ENV KAEDE_LEGAL_EFFECTIVE_DATE=${KAEDE_LEGAL_EFFECTIVE_DATE}
ENV KAEDE_LEGAL_MINIMUM_AGE=${KAEDE_LEGAL_MINIMUM_AGE}
ENV KAEDE_LEGAL_JURISDICTION=${KAEDE_LEGAL_JURISDICTION}
COPY --chown=node:node . .
CMD ["pnpm", "dev"]

FROM dependencies AS build
ARG KAEDE_MEDIA_PUBLIC_BASE_URL
ARG KAEDE_MEDIA_UPLOAD_ORIGINS
ARG KAEDE_MEDIA_S3_ADDRESSING_STYLE=path
ARG KAEDE_MEDIA_ATTACHMENTS_BUCKET=kaede-attachments
ARG KAEDE_LANDING_PAGE=default
ARG KAEDE_LEGAL_INSTANCE_NAME
ARG KAEDE_LEGAL_OPERATOR_NAME
ARG KAEDE_LEGAL_CONTACT_EMAIL
ARG KAEDE_LEGAL_EFFECTIVE_DATE
ARG KAEDE_LEGAL_MINIMUM_AGE
ARG KAEDE_LEGAL_JURISDICTION
ENV KAEDE_MEDIA_PUBLIC_BASE_URL=${KAEDE_MEDIA_PUBLIC_BASE_URL}
ENV KAEDE_MEDIA_UPLOAD_ORIGINS=${KAEDE_MEDIA_UPLOAD_ORIGINS}
ENV KAEDE_MEDIA_S3_ADDRESSING_STYLE=${KAEDE_MEDIA_S3_ADDRESSING_STYLE}
ENV KAEDE_MEDIA_ATTACHMENTS_BUCKET=${KAEDE_MEDIA_ATTACHMENTS_BUCKET}
ENV KAEDE_LANDING_PAGE=${KAEDE_LANDING_PAGE}
ENV KAEDE_LEGAL_INSTANCE_NAME=${KAEDE_LEGAL_INSTANCE_NAME}
ENV KAEDE_LEGAL_OPERATOR_NAME=${KAEDE_LEGAL_OPERATOR_NAME}
ENV KAEDE_LEGAL_CONTACT_EMAIL=${KAEDE_LEGAL_CONTACT_EMAIL}
ENV KAEDE_LEGAL_EFFECTIVE_DATE=${KAEDE_LEGAL_EFFECTIVE_DATE}
ENV KAEDE_LEGAL_MINIMUM_AGE=${KAEDE_LEGAL_MINIMUM_AGE}
ENV KAEDE_LEGAL_JURISDICTION=${KAEDE_LEGAL_JURISDICTION}
COPY --chown=node:node . .
RUN pnpm build

FROM scratch AS static
COPY --from=build /workspace/build /
