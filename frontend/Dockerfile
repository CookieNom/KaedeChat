# syntax=docker/dockerfile:1.7
FROM node:22.23.1-bookworm-slim AS dependencies
ENV COREPACK_HOME=/opt/corepack
RUN corepack enable \
    && corepack prepare pnpm@10.34.0 --activate \
    && chmod -R a=rX /opt/corepack
WORKDIR /workspace
RUN chown node:node /workspace
USER node
COPY --chown=node:node package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

FROM dependencies AS development
ARG KAEDE_MEDIA_PUBLIC_BASE_URL
ARG KAEDE_MEDIA_UPLOAD_ORIGINS
ARG KAEDE_MEDIA_S3_ADDRESSING_STYLE=path
ARG KAEDE_MEDIA_ATTACHMENTS_BUCKET=kaede-attachments
ENV KAEDE_MEDIA_PUBLIC_BASE_URL=${KAEDE_MEDIA_PUBLIC_BASE_URL}
ENV KAEDE_MEDIA_UPLOAD_ORIGINS=${KAEDE_MEDIA_UPLOAD_ORIGINS}
ENV KAEDE_MEDIA_S3_ADDRESSING_STYLE=${KAEDE_MEDIA_S3_ADDRESSING_STYLE}
ENV KAEDE_MEDIA_ATTACHMENTS_BUCKET=${KAEDE_MEDIA_ATTACHMENTS_BUCKET}
COPY --chown=node:node . .
CMD ["pnpm", "dev"]

FROM dependencies AS build
ARG KAEDE_MEDIA_PUBLIC_BASE_URL
ARG KAEDE_MEDIA_UPLOAD_ORIGINS
ARG KAEDE_MEDIA_S3_ADDRESSING_STYLE=path
ARG KAEDE_MEDIA_ATTACHMENTS_BUCKET=kaede-attachments
ENV KAEDE_MEDIA_PUBLIC_BASE_URL=${KAEDE_MEDIA_PUBLIC_BASE_URL}
ENV KAEDE_MEDIA_UPLOAD_ORIGINS=${KAEDE_MEDIA_UPLOAD_ORIGINS}
ENV KAEDE_MEDIA_S3_ADDRESSING_STYLE=${KAEDE_MEDIA_S3_ADDRESSING_STYLE}
ENV KAEDE_MEDIA_ATTACHMENTS_BUCKET=${KAEDE_MEDIA_ATTACHMENTS_BUCKET}
COPY --chown=node:node . .
RUN pnpm build

FROM scratch AS static
COPY --from=build /workspace/build /
