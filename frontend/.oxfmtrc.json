{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "none",
  "printWidth": 100,
  "sortPackageJson": false,
  "svelte": {},
  "ignorePatterns": [
    ".svelte-kit/",
    "build/",
    "build-prevalidation/",
    "coverage/",
    "node_modules/",
    "pnpm-lock.yaml",
    "src/lib/generated/",
    "src/lib/e2ee/wasm/"
  ]
}
