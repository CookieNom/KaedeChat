KAEDE_DOMAIN=chat.example.com
KAEDE_ENVIRONMENT=production
KAEDE_SECRET_KEY=replace-with-base64-encoded-32-byte-key
KAEDE_GATEWAY_SECRET_KEY=replace-with-a-different-base64-encoded-32-byte-key
KAEDE_PROXY_SECRET=replace-with-at-least-32-random-characters
KAEDE_EDGE_SECRET=replace-with-a-different-32-character-random-value
KAEDE_DATABASE_URL=postgresql+asyncpg://kaede:replace-me@postgres:5432/kaede
KAEDE_DRAGONFLY_URL=redis://:replace-with-dragonfly-password@dragonfly:6379/0
KAEDE_LOG_LEVEL=INFO
KAEDE_FEDERATION_MODE=open
KAEDE_MEDIA_MAX_ATTACHMENT_BYTES=15728640
KAEDE_MEDIA_USER_QUOTA_BYTES=10737418240
KAEDE_MEDIA_SCAN_ENABLED=true
KAEDE_MEDIA_INFLIGHT_LIMIT=10
KAEDE_MEDIA_INFLIGHT_QUOTA_BYTES=524288000
KAEDE_MEDIA_UPLOAD_TTL_SECONDS=900
KAEDE_MEDIA_REMOTE_CACHE_BYTES=21474836480
KAEDE_MEDIA_REMOTE_CACHE_TTL_DAYS=30
KAEDE_MEDIA_EMOJI_LIMIT=100
KAEDE_MEDIA_MAX_EMOJI_BYTES=262144
KAEDE_MEDIA_STORAGE_BACKEND=s3
KAEDE_MEDIA_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
KAEDE_MEDIA_PUBLIC_BASE_URL=https://s3.us-east-1.amazonaws.com
KAEDE_MEDIA_S3_REGION=us-east-1
KAEDE_MEDIA_S3_ADDRESSING_STYLE=path
KAEDE_MEDIA_S3_CREATE_BUCKETS=false
KAEDE_MEDIA_S3_INIT_TIMEOUT_SECONDS=120
KAEDE_MEDIA_S3_ACCESS_KEY=replace-with-s3-access-key
KAEDE_MEDIA_S3_SECRET_KEY=replace-with-s3-secret-key
# KAEDE_MEDIA_S3_SESSION_TOKEN=
KAEDE_MEDIA_ATTACHMENTS_BUCKET=replace-with-private-attachments-bucket
KAEDE_MEDIA_DERIVED_BUCKET=replace-with-private-derived-bucket
KAEDE_MEDIA_REMOTE_CACHE_BUCKET=replace-with-private-remote-cache-bucket
# smtp, mailtrap_api, or disabled. Disabled removes email from registration and recovery.
KAEDE_EMAIL_BACKEND=smtp
KAEDE_EMAIL_FROM_ADDRESS=no-reply@chat.example.com
KAEDE_APP_URL=https://chat.example.com
KAEDE_SMTP_URL=smtps://username:password@smtp.example.com:465
KAEDE_API_WORKERS=4
KAEDE_GATEWAY_WORKERS=2
KAEDE_CADDY_HOST_PORT=18081
KAEDE_API_HOST_PORT=18082
KAEDE_VOICE_ENABLED=false
KAEDE_VOICE_PUBLIC_URL=wss://chat.example.com/livekit
KAEDE_VOICE_LIVEKIT_URL=http://host.docker.internal:7880
LIVEKIT_CONTROL_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882
LIVEKIT_TURN_TLS_PORT=5349
KAEDE_TURN_UDP_PORT=13478
POSTGRES_PASSWORD=replace-me
DRAGONFLY_PASSWORD=replace-with-at-least-32-random-characters
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
LIVEKIT_TURN_CERT_PATH=/etc/letsencrypt/live/chat.example.com/fullchain.pem
LIVEKIT_TURN_KEY_PATH=/etc/letsencrypt/live/chat.example.com/privkey.pem
