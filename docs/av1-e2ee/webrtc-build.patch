@@ -0,0 +1,42 @@
+name: Kaede AV1 encrypted media
+on:
+  push:
+    branches: [kaede/av1-e2ee]
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  native:
+    strategy:
+      fail-fast: false
+      matrix:
+        include:
+          - platform: android
+            runner: ubuntu-24.04
+          - platform: apple
+            runner: macos-15
+    runs-on: ${{ matrix.runner }}
+    timeout-minutes: 180
+    steps:
+      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0
+      - name: Linux build dependencies
+        if: runner.os == 'Linux'
+        run: |
+          sudo rm -rf /usr/share/dotnet /opt/ghc /usr/local/share/boost /usr/local/lib/android
+          sudo apt-get update
+          sudo apt-get install -y ninja-build pkg-config python3-setuptools rsync unzip xz-utils libglib2.0-dev
+      - name: Build Android AAR
+        if: runner.os == 'Linux'
+        working-directory: build
+        run: |
+          python3 run.py build android --commit a4bd28d99eb9ed3bc8e41ce7b9ce7254ee7308bd
+          python3 run.py package android
+      - name: Build Apple XCFramework
+        if: runner.os == 'macOS'
+        working-directory: build
+        run: ./build.apple.sh a4bd28d99eb9ed3bc8e41ce7b9ce7254ee7308bd release
+      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+        with:
+          name: kaede-av1-${{ matrix.platform }}
+          path: build/_package/${{ matrix.platform }}/
+          if-no-files-found: error
