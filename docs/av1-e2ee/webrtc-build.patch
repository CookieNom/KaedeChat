++++ b/api/crypto/av1_frame.h
+@@ -0,0 +1,115 @@
++// Copyright 2026 Kaede Chat contributors. SPDX-License-Identifier: Apache-2.0
++// AV1 E2EE v1: canonical OBUs, authenticated clear structure, one final crypto OBU.
++#ifndef KAEDE_AV1_FRAME_H
++#define KAEDE_AV1_FRAME_H
++#include <algorithm>
++#include <array>
++#include <cstdint>
++#include <span>
++#include <vector>
++
++namespace kaede_av1 {
++constexpr std::array<uint8_t, 8> kMarker = {4, 255, 255, 'K', 'A', 'E', '1', 1};
++constexpr size_t kMetadataSize = kMarker.size() + 12 + 16 + 1;
++constexpr size_t kMaxFrameSize = 16 * 1024 * 1024;
++struct Range { size_t offset; size_t length; };
++struct Layout {
++  std::vector<uint8_t> frame, aad, protected_bytes, iv, tag;
++  std::vector<Range> ranges;
++  uint8_t key_index = 0;
++  bool Scatter(std::span<const uint8_t> bytes) {
++    if (bytes.size() != protected_bytes.size()) return false;
++    size_t offset = 0;
++    for (const auto& r : ranges) {
++      std::copy_n(bytes.begin() + offset, r.length, frame.begin() + r.offset);
++      offset += r.length;
++    }
++    return true;
++  }
++};
++inline void Leb(std::vector<uint8_t>& out, size_t value) {
++  do {
++    uint8_t byte = value & 127;
++    value >>= 7;
++    out.push_back(byte | (value ? 128 : 0));
++  } while (value);
++}
++// Normalize size fields before authentication: RTP strips/recreates these fields.
++inline bool Parse(std::span<const uint8_t> input, bool decrypt, uint8_t key, Layout& out) {
++  if (input.empty() || input.size() > kMaxFrameSize) return false;
++  out = Layout{};
++  out.key_index = key;
++  size_t offset = 0, count = 0;
++  bool metadata = false;
++  std::vector<uint8_t> clear;
++  while (offset < input.size()) {
++    if (++count > 4096) return false;
++    uint8_t header = input[offset++];
++    if (header & 0x81) return false; // forbidden and reserved bits
++    const int type = (header >> 3) & 15;
++    if (type == 0 || (type >= 9 && type <= 14)) return false;
++    std::vector<uint8_t> prefix{static_cast<uint8_t>(header | 2)};
++    if (header & 4) {
++      if (offset == input.size() || (input[offset] & 7)) return false;
++      prefix.push_back(input[offset++]);
++    }
++    size_t size = input.size() - offset;
++    if (header & 2) {
++      size = 0;
++      bool terminated = false;
++      for (unsigned i = 0; i < 8; ++i) {
++        if (offset == input.size()) return false;
++        uint8_t byte = input[offset++];
++        // Frames are bounded; reject values exceeding that bound before shifting.
++        if (i >= 4 && (byte & 127)) return false;
++        if (i < 4) size |= size_t(byte & 127) << (7 * i);
++        if (!(byte & 128)) { terminated = true; break; }
++      }
++      if (!terminated || size > input.size() - offset) return false;
++    }
++    auto payload = input.subspan(offset, size);
++    offset += size;
++    if (type == 2 || type == 8 || type == 15) {
++      if (decrypt) return false;
++      continue; // WebRTC never transports these OBU types.
++    }
++    if (decrypt && type == 5 && payload.size() >= kMarker.size() &&
++        std::equal(kMarker.begin(), kMarker.end(), payload.begin())) {
++      if (header != 0x2a || size != kMetadataSize || offset != input.size()) return false;
++      out.iv.assign(payload.begin() + 8, payload.begin() + 20);
++      out.tag.assign(payload.begin() + 20, payload.begin() + 36);
++      out.key_index = payload[36];
++      metadata = true;
++      break;
++    }
++    if (type == 5 && payload.size() >= kMarker.size() &&
++        std::equal(kMarker.begin(), kMarker.end(), payload.begin())) return false;
++    Leb(prefix, size);
++    // Keep sequence configuration and frame-type bits available to RTP/SFU parsing.
++    size_t clear_size = type == 1 ? size : ((type == 3 || type == 6) ? std::min(size, size_t{1}) : 0);
++    clear.insert(clear.end(), prefix.begin(), prefix.end());
++    clear.insert(clear.end(), payload.begin(), payload.begin() + clear_size);
++    out.frame.insert(out.frame.end(), prefix.begin(), prefix.end());
++    out.frame.insert(out.frame.end(), payload.begin(), payload.end());
++    const size_t protected_size = size - clear_size;
++    out.ranges.push_back({out.frame.size() - protected_size, protected_size});
++    out.protected_bytes.insert(out.protected_bytes.end(), payload.begin() + clear_size, payload.end());
++  }
++  if (out.frame.empty() || (decrypt && !metadata)) return false;
++  out.aad.assign(kMarker.begin(), kMarker.end());
++  out.aad.push_back(out.key_index);
++  out.aad.insert(out.aad.end(), clear.begin(), clear.end());
++  return true;
++}
++inline bool Seal(Layout& layout, std::span<const uint8_t> cipher, std::span<const uint8_t> iv) {
++  if (cipher.size() < 16 || iv.size() != 12 || !layout.Scatter(cipher.first(cipher.size() - 16))) return false;
++  layout.frame.push_back(0x2a);
++  Leb(layout.frame, kMetadataSize);
++  layout.frame.insert(layout.frame.end(), kMarker.begin(), kMarker.end());
++  layout.frame.insert(layout.frame.end(), iv.begin(), iv.end());
++  layout.frame.insert(layout.frame.end(), cipher.end() - 16, cipher.end());
++  layout.frame.push_back(layout.key_index);
++  return true;
++}
++} // namespace kaede_av1
++#endif
