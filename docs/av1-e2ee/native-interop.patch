 /// Used by the headless Chromium interoperability harness.
+/// Select one publication, without ever subscribing the VP8 viewer to a premium track.
+async fn receive_variant(
+    room: &Room,
+    events: &mut UnboundedReceiver<RoomEvent>,
+    codec: &str,
+) -> Result<RemoteVideoTrack> {
+    let mime = format!("video/{codec}");
+    let mut selected = false;
+    for participant in room.remote_participants().into_values() {
+        for publication in participant.track_publications().into_values() {
+            if publication.mime_type().eq_ignore_ascii_case(&mime) {
+                publication.set_subscribed(true);
+                selected = true;
+            }
+        }
+    }
+    if !selected {
+        timeout(Duration::from_secs(30), async {
+            while let Some(event) = events.recv().await {
+                if let RoomEvent::TrackPublished { publication, .. } = event {
+                    if publication.mime_type().eq_ignore_ascii_case(&mime) {
+                        publication.set_subscribed(true);
+                        return Ok(());
+                    }
+                }
+            }
+            Err(anyhow!("room ended before {mime} was published"))
+        })
+        .await??;
+    }
+    let track = receive_video(events, &mime).await?;
+    if codec == "h265" {
+        ensure!(
+            track.get_stats().await?.iter().any(|stat| matches!(
+                stat, RtcStats::InboundRtp(stat) if stat.inbound.power_efficient_decoder
+            )),
+            "HEVC requires proven hardware decoding"
+        );
+    }
+    Ok(track)
+}
+
